---
import { Icon } from 'astro-icon/components'
import Search from '@components/Search.astro'
import NavMenuCard from '@components/NavMenuCard.astro'
import { getCategories, sluglify } from '@utils/index'
import { Image, Picture } from "astro:assets"
const navItems = [
	{ title: 'Inicio', href: '/' },
	{	 title: 'Sobre mí', href: '/about' },
	{ title: 'Blog', href: '/blog' },
	{ title: 'Portafolio', href: '/portafolio' },
	{ title: 'Contacto', href: '/contact' }
]

const aboutMenu = [
	{ title: 'Experiencia', description: 'Dónde he trabajado', href: '/about#experiencia', icon: 'mdi:briefcase-outline', span: 2 as const },
	{ title: 'Habilidades', description: 'Herramientas que domino', href: '/about#habilidades', icon: 'mdi:lightning-bolt-outline', span: 2 as const },
	{ title: 'Educación', description: 'Formación académica', href: '/about#educacion', icon: 'mdi:school-outline', span: 2 as const },
	{ title: 'Proyectos', description: 'Lo último en lo que trabajé', href: '/portafolio', icon: 'mdi:rocket-launch-outline', span: 6 as const, featured: true },
	{ title: 'CV completo', description: 'Descarga mi currículum en PDF', href: '/CV.-Steve-Moya-Cepeda.pdf', icon: 'mdi:file-document-outline', span: 3 as const, external: true },
	{ title: 'Contacto', description: 'Hablemos de tu proyecto', href: '/contact', icon: 'mdi:email-outline', span: 3 as const }
]

const categoryIcons: Record<string, string> = {
	'diseño': 'mdi:palette-outline',
	'marketing': 'mdi:bullhorn-outline',
	'productividad': 'mdi:checkbox-marked-circle-outline',
	'programación': 'mdi:code-tags'
}

const categories = await getCategories()

const blogMenu = [
	{ title: 'Los más recientes', description: 'Los últimos artículos que publiqué', href: '/blog', icon: 'mdi:post-outline', span: 3 as const, featured: true },
	{ title: 'Todos los artículos', description: 'El archivo completo, con paginación', href: '/blog/todos-los-blogs/1', icon: 'mdi:archive-outline', span: 3 as const, featured: true },
	...categories.map((category: string) => ({
		title: category,
		description: `Artículos sobre ${category.toLowerCase()}`,
		href: `/blog/category/${sluglify(category.toLowerCase())}/1`,
		icon: categoryIcons[category.toLowerCase()] ?? 'mdi:tag-outline',
		span: 3 as const
	})),
	{ title: 'Etiquetas', description: 'Busca por tema específico', href: '/blog/tags', icon: 'mdi:tag-multiple-outline', span: 3 as const },
	{ title: 'RSS', description: 'Suscríbete a las novedades', href: '/rss.xml', icon: 'mdi:rss', span: 3 as const, external: true }
]

const isActive = (path: string) => {
	const currentPath = Astro.url.pathname
	return currentPath === path || (path !== '/' && currentPath.startsWith(path))
}
---

<header class="fixed top-0 z-50 w-full print:hidden no-print">
	<div
		class="bg-dark/70 mx-auto flex h-16 max-w-screen-xl items-center justify-between px-4 backdrop-blur-md"
	>
		<!-- Logo -->
		<a href="/" class="flex items-center">
			<Picture
				src="/img/logo.svg"
				alt="Steve Moya"
				width="32"
				height="32"
				class="transition-transform duration-300 hover:scale-110"
			/>
		</a>

		<!-- Desktop Navigation -->
		<nav class="hidden items-center gap-1 rounded-full border border-white/10 bg-white/[0.03] p-1 md:flex print:hidden no-print">
			<a
				href="/"
				class={`rounded-full px-4 py-1.5 text-sm font-medium transition-colors duration-300 ${
					isActive('/') ? 'bg-white text-black' : 'text-white/70 hover:text-white'
				}`}
			>
				Inicio
			</a>

			<nav-dropdown class="relative">
				<button
					type="button"
					aria-expanded="false"
					class={`flex items-center gap-1 rounded-full px-4 py-1.5 text-sm font-medium transition-colors duration-300 ${
						isActive('/about') ? 'bg-white text-black' : 'text-white/70 hover:text-white'
					}`}
				>
					Sobre mí
					<Icon name="mdi:chevron-down" class="h-4 w-4 transition-transform duration-300" data-chevron />
				</button>

				<div
					data-panel
					class="pointer-events-none absolute left-1/2 top-[calc(100%+0.75rem)] grid w-[420px] -translate-x-1/2 translate-y-1 grid-cols-6 gap-2 rounded-2xl border border-white/10 bg-[#0a0a0a] p-3 opacity-0 shadow-2xl shadow-black/60 transition-all duration-200"
				>
					{aboutMenu.map((item) => <NavMenuCard {...item} />)}
				</div>
			</nav-dropdown>

			<nav-dropdown class="relative">
				<button
					type="button"
					aria-expanded="false"
					class={`flex items-center gap-1 rounded-full px-4 py-1.5 text-sm font-medium transition-colors duration-300 ${
						isActive('/blog') ? 'bg-white text-black' : 'text-white/70 hover:text-white'
					}`}
				>
					Blog
					<Icon name="mdi:chevron-down" class="h-4 w-4 transition-transform duration-300" data-chevron />
				</button>

				<div
					data-panel
					class="pointer-events-none absolute left-1/2 top-[calc(100%+0.75rem)] grid w-[420px] -translate-x-1/2 translate-y-1 grid-cols-6 gap-2 rounded-2xl border border-white/10 bg-[#0a0a0a] p-3 opacity-0 shadow-2xl shadow-black/60 transition-all duration-200"
				>
					{blogMenu.map((item) => <NavMenuCard {...item} />)}
				</div>
			</nav-dropdown>

			{
				navItems.slice(2).filter((item) => item.title !== 'Blog').map((item) => (
					<a
						href={item.href}
						class={`rounded-full px-4 py-1.5 text-sm font-medium transition-colors duration-300 ${
							isActive(item.href)
								? 'bg-white text-black'
								: 'text-white/70 hover:text-white'
						}`}
					>
						{item.title}
					</a>
				))
			}
		</nav>

		<!-- Right Side: Search & Mobile Menu -->
		<div class="flex items-center space-x-4">
			<!-- Search Component with ⌘K badge -->
			<div class="flex items-center gap-2">
				<Search />
				<kbd class="hidden md:inline-flex items-center gap-1 rounded border border-white/10 bg-white/[0.04] px-1.5 py-0.5 text-[10px] font-medium text-white/35 select-none">
					<span>⌘</span><span>K</span>
				</kbd>
			</div>

			<!-- Mobile Menu Button -->
			<button
				id="mobile-menu-button"
				type="button"
				aria-label="Menú"
				class="p-2 text-white/80 transition-colors hover:text-[#c70039] md:hidden"
			>
				<Icon name="mdi:menu" class="h-5 w-5" id="menu-icon" />
				<Icon name="mdi:close" class="hidden h-5 w-5" id="close-icon" />
			</button>
		</div>
	</div>

	<!-- Mobile Navigation -->
	<div
		id="mobile-menu"
		class="bg-dark/95 fixed inset-0 z-50 flex translate-y-[-100%] transform flex-col items-center justify-center backdrop-blur-lg transition-transform duration-300 print:hidden no-print"
	>
		<nav class="flex flex-col items-center space-y-8 py-8">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class="text-xl font-medium text-white/80 transition-colors hover:text-[#c70039] print:hidden no-print"
					>
						{item.title}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	// Mobile menu functionality
	const mobileMenuButton = document.getElementById('mobile-menu-button')
	const mobileMenu = document.getElementById('mobile-menu')
	const menuIcon = document.getElementById('menu-icon')
	const closeIcon = document.getElementById('close-icon')

	mobileMenuButton?.addEventListener('click', () => {
		const isOpen = mobileMenu?.style.transform === 'translateY(0%)'

		if (isOpen && mobileMenu && menuIcon && closeIcon) {
			mobileMenu.style.transform = 'translateY(-100%)'
			menuIcon.classList.remove('hidden')
			closeIcon.classList.add('hidden')
		} else if (mobileMenu && menuIcon && closeIcon) {
			mobileMenu.style.transform = 'translateY(0%)'
			menuIcon.classList.add('hidden')
			closeIcon.classList.remove('hidden')
		}
	})

	// Close mobile menu when clicking on a link
	const mobileNavLinks = mobileMenu?.querySelectorAll('a')
	mobileNavLinks?.forEach((link) => {
		link.addEventListener('click', () => {
			if (mobileMenu && menuIcon && closeIcon) {
				mobileMenu.style.transform = 'translateY(-100%)'
				menuIcon.classList.remove('hidden')
				closeIcon.classList.add('hidden')
			}
		})
	})

	// Handle scroll behavior - show shadow on scroll
	const header = document.querySelector('header')

	window.addEventListener('scroll', () => {
		if (window.scrollY > 20) {
			header?.classList.add('shadow-md')
		} else {
			header?.classList.remove('shadow-md')
		}
	})

	class NavDropdown extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector<HTMLButtonElement>('button')!
			const panel = this.querySelector<HTMLElement>('[data-panel]')!
			const chevron = this.querySelector<HTMLElement>('[data-chevron]')!

			const open = () => {
				panel.classList.remove('pointer-events-none', 'opacity-0', 'translate-y-1')
				panel.classList.add('translate-y-0')
				chevron.classList.add('rotate-180')
				button.setAttribute('aria-expanded', 'true')
			}

			const close = () => {
				panel.classList.add('pointer-events-none', 'opacity-0', 'translate-y-1')
				panel.classList.remove('translate-y-0')
				chevron.classList.remove('rotate-180')
				button.setAttribute('aria-expanded', 'false')
			}

			const toggle = (event: MouseEvent) => {
				event.stopPropagation()
				const isOpen = button.getAttribute('aria-expanded') === 'true'
				isOpen ? close() : open()
			}

			button.addEventListener('click', toggle)
			document.addEventListener('click', (event) => {
				if (!this.contains(event.target as Node)) close()
			})
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') close()
			})
			document.addEventListener('astro:after-swap', close)
		}
	}

	customElements.define('nav-dropdown', NavDropdown)
</script>
