---
/**
 * Academic timeline for /education.
 *
 * Server-rendered on purpose: the previous version was a `client:visible` React
 * island, so the whole track stayed blank until hydration. Here every entry is
 * in the HTML, the year rail is sticky, and the spine draws itself with a
 * native scroll timeline instead of JS.
 */
import { Icon } from 'astro-icon/components'
import type { Education } from '@/data/education'

interface Props {
	items: Education[]
}

const { items } = Astro.props

// UTC on purpose: `new Date('2022-09-01')` is midnight UTC, and reading local
// parts west of Greenwich would show the previous day (and, in January, the
// previous year).
const yearOf = (iso: string) => new Date(iso).getUTCFullYear()

const rangeOf = (item: Education) => {
	const start = yearOf(item.startDate)
	if (item.isOngoing) return `${start} — Actual`
	const end = item.endDate ? yearOf(item.endDate) : null
	return end && end !== start ? `${start} — ${end}` : String(start)
}

// Newest first: the timeline reads top-down, so the current program opens it.
const ordered = [...items].sort((a, b) => b.startDate.localeCompare(a.startDate))
---

<ol class="relative space-y-10 sm:space-y-14">
	<!-- Hairline + the same line drawn by the scroll position of the list. -->
	<span
		class="pointer-events-none absolute inset-y-0 left-0 w-px bg-white/10 md:left-[8rem] lg:left-[10rem]"
		aria-hidden="true"></span>
	<span
		class="pointer-events-none absolute inset-y-0 left-0 w-px md:left-[8rem] lg:left-[10rem]"
		aria-hidden="true">
		<span class="spine-draw"></span>
	</span>

	{
		ordered.map((item, index) => (
			<li class="io-reveal relative pl-6 md:pl-0" data-reveal data-edu-entry style={`--i:${index}`}>
				<span
					class="absolute left-0 top-9 -ml-[3px] h-[7px] w-[7px] rounded-full bg-[#c70039] ring-4 ring-[#0a0a0a] md:left-[8rem] lg:left-[10rem]"
					aria-hidden="true"
				/>

				<div class="grid grid-cols-1 gap-4 md:grid-cols-[8rem_1fr] md:gap-10 lg:grid-cols-[10rem_1fr]">
					{/* Year rail: sticky per entry, lit by the observer in the page. */}
					<div class="md:sticky md:top-28 md:self-start">
						<span
							data-edu-year
							data-active="false"
							aria-hidden="true"
							class="block font-poppins text-4xl font-black leading-none tracking-tight text-white/10 transition-colors duration-300 lg:text-5xl"
						>
							{yearOf(item.startDate)}
						</span>

						<p class="mt-2 font-mono text-[10px] uppercase tracking-[0.24em] text-white/40">
							{rangeOf(item)}
						</p>

						<p
							class:list={[
								'mt-3 flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.2em]',
								item.isOngoing ? 'text-[#c70039]' : 'text-white/40'
							]}
						>
							<span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true" />
							{item.isOngoing ? 'En curso' : 'Completado'}
						</p>
					</div>

					<article class="dotted-card hover-lift group relative overflow-hidden rounded-2xl border border-white/10 p-6 transition-colors duration-300 hover:border-[#c70039]/40 sm:p-8">
						<span class="corner-tick corner-tick--tl" aria-hidden="true" />
						<span class="corner-tick corner-tick--br" aria-hidden="true" />

						<p class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40 transition-colors duration-300 group-hover:text-[#c70039]">
							{item.degree}
						</p>

						<h3 class="mt-3 font-poppins text-xl font-black uppercase leading-tight tracking-tight text-white sm:text-2xl">
							{item.institution}
						</h3>

						<p class="mt-2 text-sm leading-relaxed text-white/60">{item.major}</p>

						{(item.gpa || item.activities?.length) && (
							<div class="mt-5 flex flex-wrap items-center gap-2">
								{item.gpa && (
									<span class="inline-flex items-center gap-2 rounded-full border border-[#c70039]/30 bg-[#c70039]/10 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-[#c70039]">
										<Icon name="mdi:chart-line" class="h-3.5 w-3.5" aria-hidden="true" />
										GPA {item.gpa}
									</span>
								)}
								{(item.activities ?? []).map((activity) => (
									<span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-white/60">
										{activity}
									</span>
								))}
							</div>
						)}

						{(item.achievements?.length ?? 0) > 0 && (
							<details class="mt-6 border-t border-white/10 pt-4">
								<summary class="tap flex cursor-pointer list-none items-center justify-between gap-4 py-1.5 text-[10px] font-bold uppercase tracking-[0.28em] text-white/60 transition-colors duration-150 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#c70039] [&::-webkit-details-marker]:hidden">
									Ver logros
									<Icon
										name="mdi:chevron-down"
										class="edu-chevron h-4 w-4 shrink-0 text-[#c70039]"
										aria-hidden="true"
									/>
								</summary>

								<ul class="edu-details-body mt-4 space-y-2.5">
									{(item.achievements ?? []).map((achievement) => (
										<li class="flex items-start gap-3 text-sm leading-relaxed text-white/60">
											<span
												class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-[#c70039]"
												aria-hidden="true"
											/>
											{achievement}
										</li>
									))}
								</ul>
							</details>
						)}
					</article>
				</div>
			</li>
		))
	}
</ol>

<style>
	/* The year crossing the middle band is lit; the observer in the page flips
	   `data-active` on the entry that owns it. */
	[data-edu-year][data-active='true'] {
		color: #c70039;
	}

	.edu-chevron {
		transition: transform 0.18s cubic-bezier(0.23, 1, 0.32, 1);
	}

	details[open] > summary .edu-chevron {
		transform: rotate(180deg);
	}

	/* Content appears with a short lift on open. The height itself is animated
	   only where `::details-content` exists; everywhere else it snaps open, which
	   is still correct, just not eased. */
	.edu-details-body {
		animation: details-in 0.2s cubic-bezier(0.23, 1, 0.32, 1) both;
	}

	@keyframes details-in {
		from {
			opacity: 0;
			translate: 0 -6px;
		}

		to {
			opacity: 1;
			translate: none;
		}
	}

	@supports selector(::details-content) {
		details {
			interpolate-size: allow-keywords;
		}

		details::details-content {
			block-size: 0;
			overflow: hidden;
			transition:
				block-size 0.22s cubic-bezier(0.23, 1, 0.32, 1),
				content-visibility 0.22s allow-discrete;
		}

		details[open]::details-content {
			block-size: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.edu-chevron,
		.edu-details-body {
			animation: none;
			transition: none;
		}

		details::details-content {
			transition: none;
		}
	}
</style>
