---
import { Icon } from 'astro-icon/components'

const expertise = [
	{
		number: '01',
		icon: 'mdi:robot-outline',
		title: 'IA & Análisis de Datos',
		description:
			'Formación técnica en inteligencia artificial y análisis de datos, aplicada a la toma de decisiones basada en evidencia.',
		tags: ['Análisis de Datos', 'Fundamentos de IA', 'Modelos Predictivos', 'Estadística Aplicada', 'Automatización', 'Machine Learning']
	},
	{
		number: '02',
		icon: 'mdi:code-tags',
		title: 'Desarrollo Web',
		description:
			'Construcción de sitios y aplicaciones a medida, del diseño de interfaz a la puesta en producción, con foco en rendimiento.',
		tags: ['HTML / CSS / JS', 'TypeScript', 'Astro', 'Tailwind CSS', 'APIs REST', 'WordPress']
	},
	{
		number: '03',
		icon: 'mdi:bullhorn-outline',
		title: 'Marketing Digital',
		description:
			'Estrategia y ejecución de campañas digitales, desde la investigación de audiencia hasta la optimización continua de resultados.',
		tags: ['SEO', 'Google Ads', 'Google Analytics', 'Redes Sociales', 'Estrategia de Contenido', 'Email Marketing']
	}
]
---

<section class="relative bg-[#0a0a0a]" data-expertise-section>
	<div class="expertise-stage relative h-screen w-full overflow-hidden" data-expertise-stage>
		{
			expertise.map((item, index) => (
				<div
					class:list={[
						'feature-slide absolute inset-0 mx-auto flex h-full max-w-[1400px] flex-col items-center justify-center gap-12 px-6 sm:px-10 lg:px-16 md:flex-row',
						index % 2 === 1 && 'md:flex-row-reverse'
					]}
					data-feature-slide={index}
					style={index === 0 ? 'opacity: 1; pointer-events: auto;' : 'opacity: 0; pointer-events: none;'}
				>
					<div class="expertise-text flex flex-1 flex-col justify-center" data-feature-text>
						<div class="mb-6 flex items-center gap-4">
							<span class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40">Feature — {item.number}</span>
							<span class="h-px flex-1 max-w-[80px] bg-white/20" />
						</div>

						<h3 class="font-poppins text-3xl font-black uppercase tracking-tight text-white sm:text-4xl">{item.title}</h3>

						<p class="mt-4 max-w-md text-sm leading-relaxed text-white/60">{item.description}</p>

						<div class="mt-8 flex flex-wrap gap-2">
							{item.tags.map((tag) => (
								<span class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wide text-white/60">
									{tag}
								</span>
							))}
						</div>
					</div>

					<div
						class="expertise-visual flex flex-1 items-center justify-center py-8"
						style={`perspective: 1400px; --spin-duration: ${13 + index * 3.5}s; --spin-delay: -${index * 5}s;`}
					>
						<div class="cube-motion" data-cube-motion>
							<div class:list={['cube-wrap', index % 2 === 1 && 'cube-wrap--reverse']}>
								<div class="cube">
									<div class="cube-face cube-face--top" />
									<div class="cube-face cube-face--side">
										<span class="cube-number">{item.number}</span>
									</div>
									<div class="cube-face cube-face--front">
										<Icon name={item.icon} class="cube-icon h-14 w-14" />
									</div>
									<div class="cube-face cube-face--back">
										<span class="cube-label">{item.title}</span>
									</div>
									<div class="cube-face cube-face--left">
										<span class="cube-label">{item.tags[0]}</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.cube-motion {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		will-change: transform, opacity;
	}

	.expertise-text {
		will-change: transform, opacity;
	}

	.cube-wrap {
		--tilt-sign: -1;
		position: relative;
		width: 200px;
		height: 200px;
		animation: cube-float 8s cubic-bezier(0.37, 0, 0.63, 1) infinite;
	}

	.cube-wrap--reverse {
		--tilt-sign: 1;
		animation-delay: -4s;
	}

	.cube {
		position: relative;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		animation: cube-tumble var(--spin-duration, 16s) infinite;
		animation-delay: var(--spin-delay, 0s);
	}

	.cube-face {
		position: absolute;
		inset: 0;
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.cube-face--top {
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.02));
		transform: rotateX(90deg) translateZ(100px);
	}

	.cube-face--front {
		display: flex;
		align-items: center;
		justify-content: center;
		background: #0f0f0f;
		color: #c70039;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
		transform: translateZ(100px);
	}

	.cube-face--side {
		display: flex;
		align-items: center;
		justify-content: center;
		background: #050505;
		transform: rotateY(90deg) translateZ(100px);
	}

	.cube-face--back {
		display: flex;
		align-items: center;
		justify-content: center;
		background: #0a0a0a;
		padding: 1.5rem;
		transform: rotateY(180deg) translateZ(100px);
	}

	.cube-face--left {
		display: flex;
		align-items: center;
		justify-content: center;
		background: #050505;
		padding: 1.5rem;
		transform: rotateY(-90deg) translateZ(100px);
	}

	.cube-number {
		font-family: 'Poppins', sans-serif;
		font-size: 2.5rem;
		font-weight: 900;
		color: rgba(255, 255, 255, 0.1);
	}

	.cube-label {
		font-family: 'Poppins', sans-serif;
		font-size: 0.8rem;
		font-weight: 800;
		line-height: 1.3;
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(199, 0, 57, 0.55);
	}

	.cube-icon {
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.cube-face {
		transition: border-color 0.4s ease;
	}

	.cube-wrap:hover .cube {
		animation-play-state: paused;
	}

	.cube-wrap:hover .cube-face {
		border-color: rgba(199, 0, 57, 0.45);
	}

	.cube-wrap:hover .cube-face--front {
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), 0 0 50px rgba(199, 0, 57, 0.35);
	}

	.cube-wrap:hover .cube-icon {
		transform: scale(1.15);
	}

	@keyframes cube-float {
		0% {
			transform: translateY(0) scale(1);
		}
		30% {
			transform: translateY(-8px) scale(1.006);
		}
		60% {
			transform: translateY(-13px) scale(1.012);
		}
		100% {
			transform: translateY(0) scale(1);
		}
	}

	@keyframes cube-tumble {
		0% {
			transform: rotateX(-24deg) rotateY(calc(var(--tilt-sign) * 0deg));
			animation-timing-function: cubic-bezier(0.61, 0.05, 0.4, 0.95);
		}
		14% {
			transform: rotateX(-38deg) rotateY(calc(var(--tilt-sign) * 55deg));
			animation-timing-function: cubic-bezier(0.34, 0, 0.16, 1);
		}
		27% {
			transform: rotateX(-12deg) rotateY(calc(var(--tilt-sign) * 95deg));
			animation-timing-function: cubic-bezier(0.7, 0, 0.3, 1);
		}
		41% {
			transform: rotateX(-30deg) rotateY(calc(var(--tilt-sign) * 150deg));
			animation-timing-function: cubic-bezier(0.2, 0, 0.1, 1);
		}
		58% {
			transform: rotateX(-20deg) rotateY(calc(var(--tilt-sign) * 230deg));
			animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
		}
		72% {
			transform: rotateX(-34deg) rotateY(calc(var(--tilt-sign) * 270deg));
			animation-timing-function: cubic-bezier(0.3, 0, 0.15, 1);
		}
		88% {
			transform: rotateX(-16deg) rotateY(calc(var(--tilt-sign) * 335deg));
			animation-timing-function: cubic-bezier(0.5, 0, 0.3, 1);
		}
		100% {
			transform: rotateX(-24deg) rotateY(calc(var(--tilt-sign) * 360deg));
		}
	}

	.feature-slide {
		will-change: transform, opacity;
	}

	@media (prefers-reduced-motion: reduce) {
		.cube-wrap,
		.cube,
		.cube-motion,
		.expertise-text,
		.expertise-visual {
			animation: none !important;
			transform: none !important;
			opacity: 1 !important;
		}

		.feature-slide {
			position: relative !important;
			opacity: 1 !important;
			transform: none !important;
			pointer-events: auto !important;
		}
	}
</style>

<script>
	import gsap from 'gsap'
	import ScrollTrigger from 'gsap/ScrollTrigger'
	import { reducedMotion } from '@/lib/motion'

	gsap.registerPlugin(ScrollTrigger)

	let currentTrigger: ScrollTrigger | null = null

	function initExpertise() {
		const section = document.querySelector<HTMLElement>('[data-expertise-section]')
		const stage = document.querySelector<HTMLElement>('[data-expertise-stage]')
		if (!section || !stage || reducedMotion()) return

		if (currentTrigger) {
			currentTrigger.kill()
			currentTrigger = null
		}

		const slides = section.querySelectorAll<HTMLElement>('[data-feature-slide]')
		if (!slides.length) return

		// Reset initial state for all slides
		slides.forEach((slide, index) => {
			gsap.set(slide, {
				opacity: index === 0 ? 1 : 0,
				pointerEvents: index === 0 ? 'auto' : 'none'
			})
			const text = slide.querySelector<HTMLElement>('[data-feature-text]')
			const visual = slide.querySelector<HTMLElement>('[data-cube-motion]')
			if (text) gsap.set(text, { y: 0, opacity: index === 0 ? 1 : 0 })
			if (visual) gsap.set(visual, { y: 0, rotateX: 0, scale: 1, opacity: index === 0 ? 1 : 0 })
		})

		// Master pinned timeline: tuned scroll distance and responsive scrub so passing to the next view feels immediate
		const tl = gsap.timeline({
			scrollTrigger: {
				trigger: section,
				start: 'top top',
				end: () => `+=${window.innerHeight * 2.2}`,
				pin: true,
				scrub: 1,
				anticipatePin: 1,
				invalidateOnRefresh: true
			}
		})

		currentTrigger = tl.scrollTrigger ?? null

		const parts = Array.from(slides).map((slide) => ({
			slide,
			text: slide.querySelector<HTMLElement>('[data-feature-text]'),
			visual: slide.querySelector<HTMLElement>('[data-cube-motion]')
		}))

		// Timeline total length: 2.15 units
		// FEATURE 1 (0.0 -> 0.95):
		// 0.00 -> 0.20: Feature 1 hold
		// 0.20 -> 0.95: Feature 1 exit: Text BAJA (+240px), Cube SUBE (-480px)
		if (parts[0]?.text && parts[0]?.visual) {
			tl.to(
				parts[0].text,
				{ y: 240, opacity: 0, duration: 0.75, ease: 'power2.inOut' },
				0.2
			)
			tl.to(
				parts[0].visual,
				{
					y: () => -Math.max(window.innerHeight * 0.55, 460),
					rotateX: 45,
					scale: 0.88,
					opacity: 0,
					duration: 0.75,
					ease: 'power2.inOut'
				},
				0.2
			)
			tl.set(parts[0].slide, { pointerEvents: 'none' }, 0.9)
		}

		// FEATURE 2 (0.20 -> 1.95):
		// 0.20 -> 0.95: Feature 2 entrance: Text SUBE into place, Cube BAJA into place
		// 0.95 -> 1.20: Feature 2 reading hold (centered)
		// 1.20 -> 1.95: Feature 2 exit (OPUESTA): Text SUBE (-240px), Cube BAJA (+480px)
		if (parts[1]?.text && parts[1]?.visual) {
			tl.set(parts[1].slide, { opacity: 1, pointerEvents: 'auto' }, 0.2)
			tl.fromTo(
				parts[1].text,
				{ y: 240, opacity: 0 },
				{ y: 0, opacity: 1, duration: 0.75, ease: 'power2.inOut' },
				0.2
			)
			tl.fromTo(
				parts[1].visual,
				{
					y: () => -Math.max(window.innerHeight * 0.45, 380),
					rotateX: -28,
					scale: 0.88,
					opacity: 0
				},
				{ y: 0, rotateX: 0, scale: 1, opacity: 1, duration: 0.75, ease: 'power2.inOut' },
				0.2
			)

			// Exit (1.20 -> 1.95) — Opuesta a Feature 1:
			tl.to(
				parts[1].text,
				{ y: -240, opacity: 0, duration: 0.75, ease: 'power2.inOut' },
				1.2
			)
			tl.to(
				parts[1].visual,
				{
					y: () => Math.max(window.innerHeight * 0.55, 460),
					rotateX: -45,
					scale: 0.88,
					opacity: 0,
					duration: 0.75,
					ease: 'power2.inOut'
				},
				1.2
			)
			tl.set(parts[1].slide, { pointerEvents: 'none' }, 1.9)
		}

		// FEATURE 3 (1.20 -> 2.15):
		// 1.20 -> 1.95: Feature 3 entrance: Text BAJA into place, Cube SUBE into place
		// 1.95 -> 2.15: Feature 3 reading hold (centered)
		// Upon continuing scroll, the pin releases and transitions directly to the next section
		if (parts[2]?.text && parts[2]?.visual) {
			tl.set(parts[2].slide, { opacity: 1, pointerEvents: 'auto' }, 1.2)
			tl.fromTo(
				parts[2].text,
				{ y: -240, opacity: 0 },
				{ y: 0, opacity: 1, duration: 0.75, ease: 'power2.inOut' },
				1.2
			)
			tl.fromTo(
				parts[2].visual,
				{
					y: () => Math.max(window.innerHeight * 0.45, 380),
					rotateX: 28,
					scale: 0.88,
					opacity: 0
				},
				{ y: 0, rotateX: 0, scale: 1, opacity: 1, duration: 0.75, ease: 'power2.inOut' },
				1.2
			)
			// Small hold cushion so Feature 3 settles before unpinning
			tl.to({}, { duration: 0.2 }, 1.95)
		}

		ScrollTrigger.sort()
		ScrollTrigger.refresh()
	}

	initExpertise()
	document.addEventListener('astro:page-load', initExpertise)
	document.addEventListener('astro:after-swap', initExpertise)
</script>
