---
import { getPosts } from '@src/utils'
import PostCard from '@components/PostCard.astro'
import ScrollReveal from '@components/ui/ScrollReveal.astro'

const posts = await getPosts(6)
---

<section
	id="historias"
	class="reveal relative overflow-hidden bg-[#0a0a0a] px-6 py-20 sm:px-10 lg:px-16"
	data-historias-section
>
	<div class="mx-auto max-w-[1400px]">
		<p class="mb-6 text-xs font-bold uppercase tracking-[0.3em] text-white/40">Blog</p>

		<ScrollReveal
			text="Últimas historias"
			as="h2"
			class="max-w-2xl font-poppins text-3xl font-black uppercase tracking-tight text-white sm:text-4xl"
		/>

		<div
			class="mt-16 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
			data-historias-track
		>
			{
				posts.map((post) => (
					<div class="w-[85vw] shrink-0 snap-start sm:w-[60vw] lg:w-[34vw]">
						<PostCard data={post.data} id={post.id} />
					</div>
				))
			}
		</div>

		<div class="mt-10 flex items-center gap-4">
			<button
				type="button"
				aria-label="Anterior"
				class="group shrink-0 rounded-full border border-white/10 bg-white/5 p-2.5 text-white/60 transition-all duration-300 hover:border-[#c70039]/40 hover:text-white disabled:cursor-not-allowed disabled:opacity-30"
				data-historias-prev
			>
				<svg
					class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-0.5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="m15 18-6-6 6-6" />
				</svg>
			</button>

			<div class="h-px flex-1 bg-white/10">
				<div
					class="h-px bg-[#c70039] transition-all duration-150"
					data-historias-progress
					style="width: 0%"
				/>
			</div>

			<span class="shrink-0 text-xs font-semibold tracking-[0.2em] text-white/40" data-historias-page>
				01 / {String(posts.length).padStart(2, '0')}
			</span>

			<button
				type="button"
				aria-label="Siguiente"
				class="group shrink-0 rounded-full border border-white/10 bg-white/5 p-2.5 text-white/60 transition-all duration-300 hover:border-[#c70039]/40 hover:text-white disabled:cursor-not-allowed disabled:opacity-30"
				data-historias-next
			>
				<svg
					class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="m9 18 6-6-6-6" />
				</svg>
			</button>
		</div>
	</div>
</section>

<script>
	import { reducedMotion } from '@/lib/motion'

	function initHistorias(section: Element) {
		const track = section.querySelector<HTMLElement>('[data-historias-track]')
		const progressBar = section.querySelector<HTMLElement>('[data-historias-progress]')
		const pageLabel = section.querySelector<HTMLElement>('[data-historias-page]')
		const prevButton = section.querySelector<HTMLButtonElement>('[data-historias-prev]')
		const nextButton = section.querySelector<HTMLButtonElement>('[data-historias-next]')
		if (!track || !progressBar || !pageLabel) return

		// Astro hoists this <script> into a single shared module, so it runs once
		// per swap for every instance on the page — guard against re-wiring the
		// same DOM node twice.
		if ((track as HTMLElement).dataset.historiasInit === 'true') return
		;(track as HTMLElement).dataset.historiasInit = 'true'

		const total = track.children.length

		const getStep = () => {
			const firstSlide = track.firstElementChild as HTMLElement | null
			if (!firstSlide) return track.clientWidth
			const gap = Number.parseFloat(getComputedStyle(track).columnGap || '0')
			return firstSlide.getBoundingClientRect().width + gap
		}

		const updateProgress = () => {
			const scrollable = track.scrollWidth - track.clientWidth
			const progress = scrollable > 0 ? Math.min(1, Math.max(0, track.scrollLeft / scrollable)) : 0

			progressBar.style.width = `${progress * 100}%`

			const page = Math.min(total, Math.round(progress * (total - 1)) + 1)
			pageLabel.textContent = `${String(page).padStart(2, '0')} / ${String(total).padStart(2, '0')}`

			if (prevButton) prevButton.disabled = track.scrollLeft <= 0
			if (nextButton) nextButton.disabled = track.scrollLeft >= scrollable - 1
		}

		prevButton?.addEventListener('click', () => {
			track.scrollBy({ left: -getStep(), behavior: reducedMotion() ? 'auto' : 'smooth' })
		})

		nextButton?.addEventListener('click', () => {
			track.scrollBy({ left: getStep(), behavior: reducedMotion() ? 'auto' : 'smooth' })
		})

		track.addEventListener('scroll', updateProgress, { passive: true })
		updateProgress()
	}

	function initAllHistorias() {
		document.querySelectorAll('[data-historias-section]').forEach(initHistorias)
	}

	initAllHistorias()
	document.addEventListener('astro:after-swap', initAllHistorias)
</script>
