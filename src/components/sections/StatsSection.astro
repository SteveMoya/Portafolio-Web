---
import { getAllProjects } from '@src/lib/projects'
import { getRepos } from '@src/lib/github'
import { work } from '@cv'
import BlockReveal from '@components/ui/BlockReveal.astro'

const allProjects = await getAllProjects()
const projectsCompleted = allProjects.length

const uniqueTechnologies = new Set<string>()
allProjects.forEach((project) => {
	project.technologies?.forEach((tech) => uniqueTechnologies.add(tech.name))
})
const techCount = uniqueTechnologies.size

const earliestStart = work.reduce((earliest, job) => {
	const start = new Date(job.startDate)
	return start < earliest ? start : earliest
}, new Date())
const monthsOfExperience = Math.max(
	1,
	(new Date().getFullYear() - earliestStart.getFullYear()) * 12 +
		(new Date().getMonth() - earliestStart.getMonth())
)
const yearsOfExperience = Math.max(1, Math.round(monthsOfExperience / 12))

const publicRepos = await getRepos()
const githubRepos = publicRepos.length

const stats = [
	{ label: 'Proyectos completados', value: projectsCompleted, suffix: '+' },
	{ label: 'Tecnologías dominadas', value: techCount, suffix: '+' },
	{ label: 'Años de experiencia', value: yearsOfExperience, suffix: '+' },
	{ label: 'Repos en<br />GitHub', value: githubRepos, suffix: '+' }
]
---

<section
	class="relative z-10 flex min-h-screen flex-col items-center justify-center overflow-hidden rounded-t-[2.5rem] border border-white/70 border-t-2 border-t-white/90 bg-[#0a0a0a] px-6 shadow-[0_-25px_60px_rgba(0,0,0,0.95)] sm:rounded-t-[3.5rem] sm:px-10 lg:px-16"
	data-stats-section
>
	<div class="mx-auto flex max-w-3xl flex-col items-center text-center will-change-[transform,opacity]" data-stats-content>
		<span class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-1.5 text-[10px] font-bold uppercase tracking-[0.25em] text-white/80">
			<span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
			Estadísticas profesionales
		</span>

		<BlockReveal
			as="h2"
			class="font-poppins text-2xl font-black leading-tight text-white sm:text-3xl lg:text-4xl"
			boxColor="#c70039"
			lines={[
				'Marketing que convierte. Código que funciona.',
				'IA que aprende.',
				'Cuatro disciplinas, una persona',
				'y los números detrás del trabajo.'
			]}
		/>

		<div class="mt-10 grid w-full grid-cols-2 gap-6 rounded-2xl border border-white/20 bg-white/[0.04] px-6 py-8 sm:grid-cols-4 sm:divide-x sm:divide-white/20">
			{
				stats.map((stat) => (
					<div class="flex flex-col items-center gap-1 sm:px-4">
						<span class="text-[10px] font-bold uppercase leading-relaxed tracking-[0.2em] text-white/50" set:html={stat.label} />
						<span class="text-2xl font-black text-white sm:text-3xl">
							<span data-counter={stat.value}>0</span>{stat.suffix}
						</span>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	let activeScrollListener: (() => void) | null = null

	function initStatsSection() {
		if (activeScrollListener) {
			window.removeEventListener('scroll', activeScrollListener)
			activeScrollListener = null
		}

		const statsSection = document.querySelector<HTMLElement>('[data-stats-section]')
		const aboutSection = document.querySelector<HTMLElement>('[data-about-section]')
		if (!statsSection) return

		const content = statsSection.querySelector<HTMLElement>('[data-stats-content]')
		const counters = statsSection.querySelectorAll<HTMLElement>('[data-counter]')
		let countersAnimated = false

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

		const triggerCounters = () => {
			if (countersAnimated) return
			countersAnimated = true

			counters.forEach((counter) => {
				const target = Number(counter.dataset.counter)
				if (prefersReducedMotion) {
					counter.textContent = String(target)
					return
				}

				const duration = 1200
				const start = performance.now()

				const tick = (now: number) => {
					const progress = Math.min(1, (now - start) / duration)
					const eased = 1 - Math.pow(1 - progress, 3)
					counter.textContent = String(Math.round(eased * target))
					if (progress < 1) {
						requestAnimationFrame(tick)
					}
				}

				requestAnimationFrame(tick)
			})
		}

		if (prefersReducedMotion) {
			triggerCounters()
			return
		}

		const onScroll = () => {
			const rect = statsSection.getBoundingClientRect()
			const vh = window.innerHeight
			// Progress 0 when statsSection top is at bottom of viewport; 1 when it reaches top of viewport
			const progress = Math.max(0, Math.min(1, 1 - rect.top / vh))

			// Parallax / overlay on About section: dim and subtle scale reduction as StatsSection covers it
			if (aboutSection) {
				aboutSection.style.opacity = String(1 - progress * 0.8)
				aboutSection.style.transform = `scale(${1 - progress * 0.05})`
				aboutSection.style.filter = `blur(${progress * 3}px)`
			}

			// Reveal animation for StatsSection content: rises up smoothly and fades in
			if (content) {
				const contentProgress = Math.max(0, Math.min(1, progress / 0.85))
				const eased = 1 - Math.pow(1 - contentProgress, 2)
				content.style.opacity = String(eased)
				content.style.transform = `translateY(${(1 - eased) * 50}px) scale(${0.96 + eased * 0.04})`
			}

			// Trigger counter numbers as the section enters the screen
			if (progress >= 0.35) {
				triggerCounters()
			}
		}

		activeScrollListener = onScroll
		window.addEventListener('scroll', onScroll, { passive: true })
		onScroll()
	}

	initStatsSection()
	document.addEventListener('astro:after-swap', initStatsSection)
</script>
