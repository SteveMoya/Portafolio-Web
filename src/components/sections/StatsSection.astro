---
import { getAllProjects } from '@src/lib/projects'
import { getRepos } from '@src/lib/github'
import { work } from '@cv'

const allProjects = await getAllProjects()
const projectsCompleted = allProjects.length

const uniqueTechnologies = new Set<string>()
allProjects.forEach((project) => {
	project.technologies?.forEach((tech) => uniqueTechnologies.add(tech.name))
})
const techCount = uniqueTechnologies.size

const earliestStart = work.reduce((earliest, job) => {
	const start = new Date(job.startDate)
	return start < earliest ? start : earliest
}, new Date())
const monthsOfExperience = Math.max(
	1,
	(new Date().getFullYear() - earliestStart.getFullYear()) * 12 +
		(new Date().getMonth() - earliestStart.getMonth())
)
const yearsOfExperience = Math.max(1, Math.round(monthsOfExperience / 12))

const publicRepos = await getRepos()
const githubRepos = publicRepos.length

const stats = [
	{ label: 'Proyectos completados', value: projectsCompleted, suffix: '+' },
	{ label: 'Tecnologías dominadas', value: techCount, suffix: '+' },
	{ label: 'Años de experiencia', value: yearsOfExperience, suffix: '+' },
	{ label: 'Repos en<br />GitHub', value: githubRepos, suffix: '+' }
]
---

<section class="relative overflow-hidden rounded-[2rem] bg-[#0a0a0a] px-6 py-24 sm:px-10 lg:px-16" data-stats-section>
	<div class="mx-auto flex max-w-3xl flex-col items-center text-center">
		<span class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-[10px] font-bold uppercase tracking-[0.25em] text-white/60">
			<span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
			Estadísticas profesionales
		</span>

		<h2 class="font-poppins text-2xl font-black leading-tight text-white sm:text-3xl lg:text-4xl">
			Marketing que convierte. Código que funciona.<br />
			IA que aprende.<br />
			Cuatro disciplinas, una persona<br />
			y los números detrás del trabajo.
		</h2>

		<div class="mt-10 grid w-full grid-cols-2 gap-6 rounded-2xl border border-white/10 bg-white/[0.03] px-6 py-8 sm:grid-cols-4 sm:divide-x sm:divide-white/10">
			{
				stats.map((stat) => (
					<div class="flex flex-col items-center gap-1 sm:px-4">
						<span class="text-[10px] font-bold uppercase leading-relaxed tracking-[0.2em] text-white/40" set:html={stat.label} />
						<span class="text-2xl font-black text-white sm:text-3xl">
							<span data-counter={stat.value}>0</span>{stat.suffix}
						</span>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	function animateCounters(section: Element) {
		const counters = section.querySelectorAll<HTMLElement>('[data-counter]')

		const observer = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return
					counters.forEach((counter) => {
						const target = Number(counter.dataset.counter)
						const duration = 1200
						const start = performance.now()

						const tick = (now: number) => {
							const progress = Math.min(1, (now - start) / duration)
							const eased = 1 - Math.pow(1 - progress, 3)
							counter.textContent = String(Math.round(eased * target))
							if (progress < 1) requestAnimationFrame(tick)
						}

						requestAnimationFrame(tick)
					})
					obs.unobserve(section)
				})
			},
			{ threshold: 0.4 }
		)

		observer.observe(section)
	}

	function initAllCounters() {
		document.querySelectorAll('[data-stats-section]').forEach(animateCounters)
	}

	initAllCounters()
	document.addEventListener('astro:after-swap', initAllCounters)
</script>
