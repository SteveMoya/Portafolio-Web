---
import ScrollReveal from '@components/ui/ScrollReveal.astro'

interface KnowledgeTag {
	label: string
	// Scattered starting position, percent of `.kb-stage`.
	startLeft: number
	startTop: number
	rotate: number
	// Ambient drift timing (only active under `prefers-reduced-motion: no-preference`).
	dur: number
	delay: number
	// Landing position inside the box mouth, where the tag shrinks/fades away
	// as if it fell through the open top and disappeared inside the box.
	landingLeft: number
	landingTop: number
}

// Fixed, deterministic scatter + landing coordinates (percent of `.kb-stage`),
// not Math.random(), so layout is reproducible across every render — same
// convention as Certifications.astro's SCATTER_OFFSETS.
//
// Landing coordinates were re-derived for the rotateX(50deg) rotateY(135deg)
// camera (see `.kb-box`'s own comment): with that camera + the shallow-wall
// geometry, the floor face projects as a symmetric diamond centered at
// roughly 50% left / 70.7% top of `.kb-stage`, spanning about ±18.7% left
// and ±26.5% top from that center (measured live in the browser via
// `getBoundingClientRect()` on `.kb-face--floor`), so every landing point
// below sits well inside that diamond — comfortably clear of its four
// corners/edges (which visually belong to the walls/rim, not the open
// floor) — instead of the old asymmetric camera's parallelogram footprint.
const tags: KnowledgeTag[] = [
	{ label: 'Marketing Digital', startLeft: 10, startTop: 14, rotate: -6, dur: 7.2, delay: 0, landingLeft: 48.1, landingTop: 56.2 },
	{ label: 'SEO', startLeft: 84, startTop: 10, rotate: 8, dur: 6.4, delay: -1.5, landingLeft: 52.8, landingTop: 57.5 },
	{ label: 'IA', startLeft: 6, startTop: 46, rotate: 5, dur: 8.1, delay: -3, landingLeft: 43.5, landingTop: 62.8 },
	{ label: 'Análisis de Datos', startLeft: 90, startTop: 40, rotate: -9, dur: 7.6, delay: -0.8, landingLeft: 56.5, landingTop: 64.1 },
	{ label: 'React', startLeft: 16, startTop: 78, rotate: 7, dur: 6.9, delay: -2.2, landingLeft: 41.6, landingTop: 72.1 },
	{ label: 'Astro', startLeft: 80, startTop: 78, rotate: -5, dur: 7.3, delay: -4, landingLeft: 58.4, landingTop: 72.1 },
	{ label: 'TypeScript', startLeft: 32, startTop: 6, rotate: 4, dur: 6.6, delay: -1, landingLeft: 44.4, landingTop: 80.0 },
	{ label: 'Google Ads', startLeft: 64, startTop: 4, rotate: -8, dur: 8.4, delay: -3.6, landingLeft: 55.6, landingTop: 80.0 },
	{ label: 'Automatización', startLeft: 4, startTop: 64, rotate: -4, dur: 7.0, delay: -2.8, landingLeft: 48.1, landingTop: 85.3 },
	{ label: 'WordPress', startLeft: 94, startTop: 62, rotate: 9, dur: 6.2, delay: -0.4, landingLeft: 51.9, landingTop: 85.3 },
	{ label: 'Tailwind', startLeft: 24, startTop: 92, rotate: -7, dur: 7.9, delay: -3.2, landingLeft: 46.3, landingTop: 69.4 },
	{ label: 'Machine Learning', startLeft: 72, startTop: 92, rotate: 6, dur: 6.8, delay: -1.8, landingLeft: 53.7, landingTop: 65.5 }
]
---

<section
	id="knowledge-box"
	class="reveal relative min-h-screen overflow-hidden bg-[#0a0a0a] px-6 py-20 sm:px-10 lg:px-16"
	data-knowledge-box
>
	<div class="mx-auto max-w-[1400px]">
		<p class="mb-6 text-xs font-bold uppercase tracking-[0.3em] text-white/40">Conocimiento acumulado</p>

		<ScrollReveal
			text="Todo lo que entra en la caja"
			as="h2"
			class="max-w-2xl font-poppins text-3xl font-black uppercase tracking-tight text-white sm:text-4xl"
		/>

		<div class="kb-stage relative mt-16" data-kb-stage>
			<div class="kb-box" data-kb-box style="left: 50%; top: 56%;">
				<div class="kb-face dotted-card kb-face--floor">
					<span class="corner-tick corner-tick--tl" />
					<span class="corner-tick corner-tick--br" />
				</div>
				<div class="kb-face dotted-card kb-face--back">
					<span class="corner-tick corner-tick--tl" />
					<span class="corner-tick corner-tick--br" />
				</div>
				<div class="kb-face dotted-card kb-face--left">
					<span class="corner-tick corner-tick--tl" />
					<span class="corner-tick corner-tick--br" />
				</div>

				<!-- Four hinged flaps, one per box edge, each rotating around its own
				     rim edge between an OPEN (splayed outward) and CLOSED (folded past
				     flat, in toward the box's own interior) resting state. The
				     wrapping `.kb-flap-hinge` is a zero-height strip placed exactly at
				     that edge's rim position
				     (reusing the matching wall's own placement transform), so the
				     nested `.kb-flap`'s own `transform-origin: top center` lands
				     precisely on the hinge line — see the <style> block below for the
				     full geometry writeup. -->
				<div class="kb-flap-hinge kb-flap-hinge--back">
					<div class="kb-flap dotted-card" data-kb-flap>
						<span class="corner-tick corner-tick--tl" />
						<span class="corner-tick corner-tick--br" />
					</div>
				</div>
				<div class="kb-flap-hinge kb-flap-hinge--left">
					<div class="kb-flap dotted-card" data-kb-flap>
						<span class="corner-tick corner-tick--tl" />
						<span class="corner-tick corner-tick--br" />
					</div>
				</div>
				<div class="kb-flap-hinge kb-flap-hinge--right">
					<div class="kb-flap dotted-card" data-kb-flap>
						<span class="corner-tick corner-tick--tl" />
						<span class="corner-tick corner-tick--br" />
					</div>
				</div>
				<div class="kb-flap-hinge kb-flap-hinge--front">
					<div class="kb-flap dotted-card" data-kb-flap>
						<span class="corner-tick corner-tick--tl" />
						<span class="corner-tick corner-tick--br" />
					</div>
				</div>
			</div>

			{
				tags.map((tag) => (
					<div
						class="kb-tag absolute"
						data-kb-tag
						style={`left:${tag.startLeft}%; top:${tag.startTop}%;`}
						data-landing-left={tag.landingLeft}
						data-landing-top={tag.landingTop}
					>
						<span
							class="kb-tag-pill pointer-events-none inline-block select-none whitespace-nowrap rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wide text-white/60"
							data-kb-tag-pill
							style={`--dur:${tag.dur}s; --delay:${tag.delay}s; --rotate:${tag.rotate}deg;`}
						>
							{tag.label}
						</span>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Isometric open box: floor + two back walls, reusing ExpertiseSection's
	   preserve-3d cube technique (fold flat squares into place, then apply a
	   single camera rotation to the whole assembly). Perspective lives on the
	   direct parent (`.kb-stage`), matching ExpertiseSection's
	   `.expertise-visual` → `.cube-wrap` relationship, so nothing in between
	   flattens the 3D context. */
	.kb-stage {
		min-height: 60vh;
		perspective: 1600px;
	}

	@media (min-width: 640px) {
		.kb-stage {
			min-height: 70vh;
		}
	}

	.kb-box {
		--kb-size: clamp(200px, 26vw, 340px);
		position: absolute;
		width: var(--kb-size);
		height: var(--kb-size);
		transform-style: preserve-3d;
		/* rotateX(60deg) rotateZ(-45deg) (the design phase's starting values)
		   put two of the three faces almost perfectly edge-on to the camera,
		   collapsing them to invisible lines — verified live in the browser
		   during Task 6.8. rotateX(45deg) rotateY(135deg) (an earlier revision)
		   gave a clean, equal-area hexagon with all three faces readable, but
		   its symmetric framing put the floor and both full-height walls at
		   equal visual weight, so the box's open top / interior didn't read
		   as a distinct "place things fall into" — verified live in the
		   browser (tags settling mid-scroll were barely distinguishable from
		   the walls themselves). A later revision tried breaking that
		   symmetry with an asymmetric rotateX(55deg) rotateY(200deg) camera
		   instead, but real screenshots showed it read as a confusing
		   cluster of disconnected panels, not a container. This revision
		   keeps rotateY(135deg) (the original, symmetric framing) and a
		   slightly steeper rotateX(50deg), and instead fixes the "floor vs.
		   walls" weight problem at its actual source: the walls themselves
		   (see `.kb-face--back`/`.kb-face--left`) are now shallow strips
		   instead of full-height squares, so the floor dominates the
		   silhouette by area regardless of camera symmetry, with the walls
		   reading as a receding rim framing it. */
		transform: translate(-50%, -50%) rotateX(50deg) rotateY(135deg);
		z-index: 10;
	}

	.kb-face {
		position: absolute;
		inset: 0;
		border: 1px solid rgba(255, 255, 255, 0.14);
		/* `.dotted-card`'s default dot pattern (0.5px dots at 0.15 opacity on a
		   16px grid) is tuned for flat 2D cards and washes out to nothing on
		   the two heavily foreshortened wall faces once the isometric 3D
		   transform is applied — verified live in the browser during Task
		   6.8 (bold test patterns rendered fine, so it wasn't a rendering
		   bug, just contrast lost to perspective compression). This local,
		   bolder dot recipe keeps the same "blueprint grid" identity but
		   survives the foreshortening on every face. */
		background-color: #0a0a0a;
		background-image: radial-gradient(circle, rgba(255, 255, 255, 0.45) 1.1px, transparent 1.1px);
		background-size: 22px 22px;
	}

	.kb-face--floor {
		transform: rotateX(-90deg) translateZ(calc(var(--kb-size) / 2));
	}

	/* Back/left walls are shallow (a fraction of the box's full height)
	   instead of full-height squares, anchored to the box's own bottom edge
	   instead of `.kb-face`'s default `inset: 0`. A full-height wall put the
	   floor and walls at equal visual weight — read live in the browser as
	   two flat panels meeting at a fold, more "open book" than "container
	   with a floor you can see into" (the exact complaint from real
	   screenshots). Shrinking the walls down to low rims read immediately as
	   an open box/tray from the very first real screenshot checked live in
	   the browser: the floor dominates the silhouette, the two walls recede
	   as narrow foreshortened strips framing it, and there's finally a
	   legible "opening" between the top of those strips and the rim the
	   flaps hinge from. */
	.kb-face--back,
	.kb-face--left {
		inset: auto;
		left: 0;
		right: 0;
		bottom: 0;
		height: 38%;
		/* Even at this shallower height, the walls sit at a much steeper
		   composite angle to the camera than the floor (the floor is tilted
		   to face the camera fairly directly; the walls stay close to
		   edge-on), which compresses `.kb-face`'s own dot recipe to near
		   nothing — verified live in the browser (the walls read as vague
		   dark shadow shapes, barely distinguishable from the empty
		   background, not as a receding surface). A lighter background tone
		   plus a bolder, brighter dot pattern (reusing `.kb-flap`'s own
		   boosted recipe, which solved the identical foreshortening problem
		   there) keeps the walls legible as a distinct, lighter "receding
		   side" framing the darker, dominant floor. */
		background-color: #17171a;
		background-image: radial-gradient(circle, rgba(255, 255, 255, 0.55) 1.3px, transparent 1.3px);
		background-size: 18px 18px;
	}

	.kb-face--back {
		transform: rotateY(180deg) translateZ(calc(var(--kb-size) / 2));
	}

	.kb-face--left {
		transform: rotateY(-90deg) translateZ(calc(var(--kb-size) / 2));
	}

	/* --- Flaps -------------------------------------------------------------
	   Each `.kb-flap-hinge` is a zero-height strip (`top:0; height:0`) that
	   reuses the EXACT same "rotate then translateZ" recipe as the wall face
	   that would occupy that edge (front/back/left/right). Because a cube
	   face's own top edge sits at local `(0, -half, 0)` before it's pushed
	   into place, giving this zero-height strip the identical transform lands
	   it precisely on that face's top rim — the box's opening edge — without
	   needing any face at all (front/right have no rendered wall, but still
	   get a rim position this way).

	   The nested `.kb-flap` is the actual visible panel: it starts at the
	   hinge's local origin (`transform-origin: top center`) and swings around
	   it with its own single `rotateX(var(--flap-angle))`. At `--flap-angle:
	   0deg` the flap is a plain upright wall filling in that rim's missing
	   face (identity extra rotation on top of the hinge's own base
	   rotation). A previous revision rested the flaps fully open at a large
	   POSITIVE angle (splayed near-flat outward, away from the box), but
	   verified live in the browser against real screenshots: under this
	   camera those four splayed panels read as a confusing cluster of
	   disconnected floating quadrilaterals competing with the walls, not as
	   "flaps flopped out of the way" — exactly the illegible rest state
	   the user flagged. Worse, animating the shared angle from that positive
	   open value down to the closed value forced every sweep through
	   `0deg`, and the front-facing rim orientation happens to sit almost
	   perfectly edge-on to this particular fixed camera at exactly that
	   angle — verified live in the browser by sampling the scroll-driven
	   close in small steps: the front flap's projected width visibly
	   collapsed to a sliver and briefly vanished around `--flap-angle:
	   0deg`, then reappeared as a different sliver past it, exactly the
	   "glitch, not a smooth fold" artifact reported from real screenshots.

	   This revision rests every flap AT that `0deg` identity pose instead of
	   splayed open, with opacity faded down (see `.kb-flap`'s own rule) so
	   the edge-on-for-this-camera front flap is naturally near-invisible
	   exactly when it's supposed to be — no separate splayed-open pose to
	   read as clutter, and no crossing back through `0deg` later while
	   opaque. The close sweep then moves NEGATIVE only, monotonically away
	   from that single problem angle toward -125deg (past -90deg's flat
	   "lid capping the opening" midpoint, continuing on to tip down and
	   tuck into the box's own interior volume), fading opacity up in the
	   same tween so any other camera-specific thin angle along that one-way
	   path is masked by low opacity rather than shown naked — verified live
	   in the browser by sampling the close in ten small steps end to end,
	   confirming no panel collapses to a sliver at full opacity anywhere
	   along the sweep. The flap's height was also trimmed (see below) so
	   this deeper fold doesn't drive its far edge through the opposite
	   wall. */
	.kb-flap-hinge {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 0;
		transform-style: preserve-3d;
	}

	.kb-flap-hinge--front {
		transform: translateZ(calc(var(--kb-size) / 2));
	}

	.kb-flap-hinge--back {
		transform: rotateY(180deg) translateZ(calc(var(--kb-size) / 2));
	}

	.kb-flap-hinge--left {
		transform: rotateY(-90deg) translateZ(calc(var(--kb-size) / 2));
	}

	.kb-flap-hinge--right {
		transform: rotateY(90deg) translateZ(calc(var(--kb-size) / 2));
	}

	.kb-flap {
		--flap-angle: 0deg;
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		/* Shorter than the earlier 0.56 revision: folding to -125deg (see the
		   hinge comment above) swings the flap's far edge down past the rim
		   and toward the opposite wall, and at the old 0.56 length that edge
		   drove visibly through the opposite wall/floor — verified live in
		   the browser. 0.45 keeps the same "opposite flaps overlap a little
		   once closed" read without the clip. */
		height: calc(var(--kb-size) * 0.45);
		transform-origin: top center;
		transform: rotateX(var(--flap-angle));
		/* Faded down at rest (see the hinge comment above for why 0deg is
		   the resting angle, not a splayed-open one) so the flaps read as
		   near-invisible rim traces rather than a fourth competing shape —
		   the open box's read comes entirely from the floor + two static
		   walls below. GSAP fades this back up to 1 in the same tween that
		   swings the angle closed, so the panel is only ever fully opaque
		   once it's past the single problem angle for this camera. */
		opacity: 0.06;
		/* Flaps sit at a much steeper composite angle to the fixed isometric
		   camera than the box's own walls (their own hinge rotation stacks on
		   top of the wall's base rotation), which compresses the wall
		   faces' already-boosted dot recipe below visibility — verified live
		   in the browser (identical markup with a solid debug fill rendered
		   fine, proving it wasn't a transform/z-fighting bug, just contrast
		   lost to the extra foreshortening). A slightly lighter base tone plus
		   a brighter, thicker border keeps the flap silhouette legible at any
		   scroll position while keeping the same "blueprint dot" identity. */
		border: 1.5px solid rgba(255, 255, 255, 0.28);
		background-color: #141416;
		background-image: radial-gradient(circle, rgba(255, 255, 255, 0.6) 1.4px, transparent 1.4px);
		background-size: 22px 22px;
	}

	/* Outer wrapper: GSAP-owned (left/top/scale/opacity/zIndex). Centering
	   offset stays a static rule, never touched by the settle tween. */
	.kb-tag {
		transform: translate(-50%, -50%);
		z-index: 20;
	}

	/* Inner pill: CSS-owned ambient drift. Splitting wrapper vs. pill keeps
	   the GSAP-driven settle tween (on the wrapper's left/top/scale/opacity)
	   and the CSS keyframe drift (on the pill's own transform) on two
	   different elements/properties, so neither ever overrides the other —
	   no animation-vs-inline-style cascade fight to work around. */
	.kb-tag-pill {
		display: inline-block;
	}

	@media (prefers-reduced-motion: no-preference) {
		.kb-tag-pill {
			animation: tag-drift var(--dur, 7s) ease-in-out infinite;
			animation-delay: var(--delay, 0s);
		}
	}

	@keyframes tag-drift {
		0%,
		100% {
			transform: rotate(var(--rotate, 0deg)) translateY(0);
		}
		50% {
			transform: rotate(var(--rotate, 0deg)) translateY(-12px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.kb-tag-pill {
			animation: none;
		}

		/* Static end state: box already sealed, tags already "used up" —
		   no pin, no scroll-driven transform (guarded in <script> below).
		   Matches the scroll-driven close's final angle and opacity (see
		   `.kb-flap`'s own comment for why -125deg, not -90deg, and why
		   opacity fades in alongside the angle). */
		.kb-flap {
			--flap-angle: -125deg;
			opacity: 1;
		}

		.kb-tag {
			display: none;
		}
	}
</style>

<script>
	import gsap from 'gsap'
	import ScrollTrigger from 'gsap/ScrollTrigger'
	import { reducedMotion } from '@/lib/motion'

	gsap.registerPlugin(ScrollTrigger)

	// One timeline unit per tag settling one at a time, plus one final unit
	// for the box's flaps to close once every tag has gone in.
	const TAG_UNIT = 1
	const TAG_SETTLE_FRACTION = 0.9 // leaves a small idle gap before the next tag's segment starts
	const FLAP_UNIT = 1
	const FLAP_CLOSE_FRACTION = 0.85

	function initKnowledgeBox(section: Element) {
		const el = section as HTMLElement
		// Astro hoists this <script> into a single shared module, so it runs
		// once per swap for every instance on the page — guard against
		// re-wiring the same DOM node twice.
		if (el.dataset.knowledgeBoxInit === 'true') return
		el.dataset.knowledgeBoxInit = 'true'

		const stage = el.querySelector<HTMLElement>('[data-kb-stage]')
		const tagWrappers = el.querySelectorAll<HTMLElement>('[data-kb-tag]')
		const pills = el.querySelectorAll<HTMLElement>('[data-kb-tag-pill]')
		const flaps = el.querySelectorAll<HTMLElement>('[data-kb-flap]')
		if (!stage || !tagWrappers.length) return

		if (reducedMotion()) {
			// Static arrangement: box renders closed (via the
			// `prefers-reduced-motion: reduce` rule above), tags stay hidden —
			// no pin, no scroll-driven transform.
			return
		}

		const totalUnits = tagWrappers.length * TAG_UNIT + FLAP_UNIT
		// Progress (0..1) at which each tag's own drop has fully resolved —
		// used to pause that tag's ambient drift once it's "fallen in", while
		// every tag still waiting keeps drifting untouched.
		const tagResolvedAt = Array.from(tagWrappers, (_, index) => (index * TAG_UNIT + TAG_UNIT * TAG_SETTLE_FRACTION) / totalUnits)

		const tl = gsap.timeline({
			scrollTrigger: {
				trigger: el,
				start: 'top top',
				end: () => `+=${window.innerHeight * totalUnits}`,
				scrub: 1,
				pin: true,
				invalidateOnRefresh: true,
				onUpdate(self) {
					pills.forEach((pill, index) => {
						const resolved = self.progress >= (tagResolvedAt[index] ?? 1)
						pill.style.animationPlayState = resolved ? 'paused' : 'running'
					})
				}
			}
		})

		// Segment i: only tag i flies from its ambient scattered position down
		// through the box's open top and disappears, as if it fell inside.
		// Every other tag is left completely untouched during this segment.
		tagWrappers.forEach((tag, index) => {
			tl.to(
				tag,
				{
					left: `${tag.dataset.landingLeft}%`,
					top: `${tag.dataset.landingTop}%`,
					scale: 0,
					opacity: 0,
					zIndex: 5,
					roundProps: 'zIndex',
					ease: 'power1.in',
					duration: TAG_UNIT * TAG_SETTLE_FRACTION
				},
				index * TAG_UNIT
			)
		})

		// Final segment: only after the last tag has gone in, swing all four
		// flaps from their hidden rim pose down past flat, in toward the
		// box's own interior (see `.kb-flap`'s own comment for why the
		// sweep only ever moves negative, and why opacity rises alongside
		// the angle instead of the flap being opaque the whole time).
		tl.to(
			flaps,
			{
				'--flap-angle': '-125deg',
				opacity: 1,
				ease: 'power2.inOut',
				duration: FLAP_UNIT * FLAP_CLOSE_FRACTION
			},
			tagWrappers.length * TAG_UNIT
		)
	}

	function initAllKnowledgeBoxes() {
		document.querySelectorAll('[data-knowledge-box]').forEach(initKnowledgeBox)
	}

	initAllKnowledgeBoxes()
	document.addEventListener('astro:after-swap', initAllKnowledgeBoxes)
</script>
