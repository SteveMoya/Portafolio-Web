---
/**
 * Skills hero: full-bleed entrance view for /skills.
 *
 * Composition, from back to front:
 *   1. a WebGL bust (Three.js) whose head tracks the pointer,
 *   2. a vignette that crops the figure into the canvas,
 *   3. tool bubbles floating around the figure, lit by pointer proximity,
 *   4. the display title and subtitle.
 *
 * The figure is built from primitives at runtime instead of loading a hosted
 * 3D scene: no third-party asset, no extra network request, and the head
 * rotation is ours to control. Without JS (or without WebGL) the copy and the
 * bubbles still render, so the hero never collapses to an empty box.
 */
import { Icon } from 'astro-icon/components'

interface Props {
	class?: string
	/** Short facts rendered under the subtitle, e.g. ["22 habilidades"]. */
	meta?: string[]
}

const { class: className = '', meta = [] } = Astro.props

/**
 * Tools floating around the figure. Icons come from the local `logos` icon set
 * (astro-icon), so nothing is fetched from a CDN. `top` and `offset` are
 * percentages of the hero box; the side alternates to keep the center clear.
 */
const orbit = [
	{ icon: 'logos:python', label: 'Python', top: '14%', side: 'left', offset: '7%', delay: '0s' },
	{ icon: 'logos:react', label: 'React', top: '28%', side: 'left', offset: '19%', delay: '1.6s' },
	{ icon: 'logos:nodejs', label: 'Node.js', top: '47%', side: 'left', offset: '6%', delay: '0.7s' },
	{ icon: 'logos:docker', label: 'Docker', top: '63%', side: 'left', offset: '18%', delay: '2.4s' },
	{ icon: 'logos:git', label: 'Git', top: '79%', side: 'left', offset: '9%', delay: '1.1s' },
	{ icon: 'logos:astro', label: 'Astro', top: '17%', side: 'right', offset: '11%', delay: '0.4s' },
	{
		icon: 'logos:typescript',
		label: 'TypeScript',
		top: '34%',
		side: 'right',
		offset: '22%',
		delay: '1.9s'
	},
	{
		icon: 'logos:postgresql',
		label: 'PostgreSQL',
		top: '52%',
		side: 'right',
		offset: '9%',
		delay: '1.3s'
	},
	{
		icon: 'logos:tailwindcss',
		label: 'Tailwind CSS',
		top: '68%',
		side: 'right',
		offset: '23%',
		delay: '2.9s'
	},
	{
		icon: 'logos:tensorflow',
		label: 'TensorFlow',
		top: '84%',
		side: 'right',
		offset: '14%',
		delay: '0.9s'
	}
]
---

<section
	class:list={[
		'skills-hero relative -mt-16 flex h-[100svh] min-h-[640px] w-full items-end justify-center overflow-hidden bg-[#0a0a0a]',
		className
	]}
>
	<!-- Figure. The canvas is injected by the script below, so this box stays
	     empty (and harmless) when JS never runs. -->
	<div class="skills-hero__stage pointer-events-none absolute inset-0 z-0" data-skills-stage>
		<div class="h-full w-full" data-skills-canvas></div>
	</div>

	<!-- Vignette: darkens the edges and fades the torso into the page. -->
	<div
		class="pointer-events-none absolute inset-0 z-[1]"
		aria-hidden="true"
		style="background: radial-gradient(ellipse 62% 58% at 50% 42%, transparent 30%, rgba(10,10,10,0.55) 78%, #0a0a0a 100%), linear-gradient(180deg, rgba(10,10,10,0.85) 0%, transparent 22%, transparent 62%, #0a0a0a 96%);"
	>
	</div>

	<!-- Tools. Decorative here: the same stack is listed as text further down
	     the page, so screen readers are not read a second icon dump. -->
	<ul class="pointer-events-none absolute inset-0 z-[2]" aria-hidden="true">
		{
			orbit.map((tool) => (
				<li
					class="skills-bubble absolute"
					style={`top:${tool.top};${tool.side}:${tool.offset};--delay:${tool.delay}`}
				>
					<span class="skills-bubble__float">
						<span class="skills-bubble__disc" data-skills-bubble>
							<Icon name={tool.icon} class="h-6 w-6 sm:h-7 sm:w-7 md:h-9 md:w-9" />
						</span>
					</span>
				</li>
			))
		}
	</ul>

	<!-- Copy -->
	<div class="skills-hero__copy relative z-10 w-full px-6 pb-12 text-center sm:pb-14">
		<h1
			class="skills-hero__title font-poppins font-black uppercase leading-[0.82] tracking-tighter"
		>
			<span class="text-shiny">Skills</span>
			<span class="text-shiny-accent">&amp;</span>
			<span class="text-shiny">Tools</span>
		</h1>

		<p
			class="mx-auto mt-5 max-w-2xl font-mono text-[10px] font-medium uppercase tracking-[0.3em] text-white/45 sm:text-[11px] md:tracking-[0.42em]"
		>
			Tecnologías y herramientas con las que trabajo
		</p>

		{
			meta.length > 0 && (
				<ul class="mx-auto mt-7 flex max-w-3xl flex-wrap items-center justify-center gap-x-6 gap-y-2 border-t border-white/10 pt-5">
					{meta.map((item) => (
						<li class="font-mono text-[10px] uppercase tracking-[0.25em] text-white/35">
							{item}
						</li>
					))}
				</ul>
			)
		}
	</div>

	<!-- Scroll cue -->
	<div
		class="pointer-events-none absolute bottom-4 left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-2 md:flex"
		aria-hidden="true"
	>
		<span class="skills-hero__cue h-10 w-px bg-gradient-to-b from-white/40 to-transparent"></span>
	</div>
</section>

<style>
	.skills-hero__title {
		font-size: clamp(2.9rem, 11.5vw, 10.5rem);
	}

	/* No WebGL: keep a soft mass where the figure would be instead of a flat
	   black hole behind the title. */
	[data-skills-canvas][data-stage='unavailable'] {
		position: relative;
	}

	[data-skills-canvas][data-stage='unavailable']::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 34% 42% at 50% 36%, rgba(255, 255, 255, 0.08), transparent 70%);
	}

	/* Bubbles: a glass disc per tool. `--near` (0..1) is written by the script
	   from the pointer distance, so a bubble only comes alive when the cursor
	   gets close instead of on hover alone. */
	.skills-bubble__float {
		display: block;
		animation: skills-bubble-float 9s ease-in-out infinite;
		animation-delay: var(--delay, 0s);
	}

	.skills-bubble__disc {
		display: flex;
		height: 3.25rem;
		width: 3.25rem;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.06);
		box-shadow: 0 0 40px rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		opacity: calc(0.62 + 0.38 * var(--near, 0));
		transform: scale(calc(0.94 + 0.16 * var(--near, 0)));
		filter: grayscale(calc(0.8 - 0.8 * var(--near, 0))) brightness(calc(1 + 0.15 * var(--near, 0)));
		transition:
			opacity 0.35s ease,
			filter 0.35s ease,
			transform 0.35s ease,
			border-color 0.35s ease;
		will-change: transform, filter, opacity;
	}

	@media (min-width: 768px) {
		.skills-bubble__disc {
			height: 4.5rem;
			width: 4.5rem;
		}
	}

	/* Narrow screens: keep four bubbles, drop the rest so the figure and the
	   title are not crowded out. */
	@media (max-width: 639px) {
		.skills-bubble:nth-child(3),
		.skills-bubble:nth-child(4),
		.skills-bubble:nth-child(5),
		.skills-bubble:nth-child(6),
		.skills-bubble:nth-child(9),
		.skills-bubble:nth-child(10) {
			display: none;
		}

		.skills-bubble__disc {
			height: 2.75rem;
			width: 2.75rem;
		}
	}

	@keyframes skills-bubble-float {
		0%,
		100% {
			transform: translate3d(0, 0, 0);
		}
		50% {
			transform: translate3d(0, -22px, 0);
		}
	}

	.skills-hero__cue {
		animation: skills-cue 3.6s ease-in-out infinite;
	}

	@keyframes skills-cue {
		0%,
		100% {
			opacity: 0.25;
			transform: translateY(0);
		}
		50% {
			opacity: 0.6;
			transform: translateY(6px);
		}
	}

	/* The copy drifts up slightly as the hero leaves, so the transition into the
	   marquee is not a hard cut. */
	@media (prefers-reduced-motion: no-preference) {
		.skills-hero__copy {
			animation: skills-copy-drift linear both;
			animation-timeline: scroll(root block);
			animation-range: 0 80vh;
		}
	}

	@keyframes skills-copy-drift {
		to {
			transform: translate3d(0, -28px, 0);
			opacity: 0.55;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.skills-bubble__float,
		.skills-hero__cue {
			animation: none;
		}

		.skills-bubble__disc {
			opacity: 0.5;
			filter: grayscale(0.7);
		}
	}
</style>

<script>
	/**
	 * Pointer proximity for the tool bubbles. `--near` goes 0 → 1 as the cursor
	 * approaches a bubble, and CSS turns that into opacity, scale and colour.
	 */
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
	const bubbles = Array.from(document.querySelectorAll<HTMLElement>('[data-skills-bubble]'))

	if (bubbles.length > 0 && !reducedMotion) {
		let pointerX = Number.NEGATIVE_INFINITY
		let pointerY = Number.NEGATIVE_INFINITY
		let frame = 0
		const RADIUS = 260

		const paint = () => {
			frame = 0

			for (const bubble of bubbles) {
				const rect = bubble.getBoundingClientRect()
				const centerX = rect.left + rect.width / 2
				const centerY = rect.top + rect.height / 2
				const distance = Math.hypot(pointerX - centerX, pointerY - centerY)
				const near = Math.max(0, Math.min(1, 1 - distance / RADIUS))
				bubble.style.setProperty('--near', near.toFixed(3))
			}
		}

		window.addEventListener(
			'pointermove',
			(event) => {
				pointerX = event.clientX
				pointerY = event.clientY
				if (!frame) frame = window.requestAnimationFrame(paint)
			},
			{ passive: true }
		)

		// A pointer that leaves the window should release every bubble.
		window.addEventListener('pointerleave', () => {
			pointerX = Number.NEGATIVE_INFINITY
			pointerY = Number.NEGATIVE_INFINITY
			if (!frame) frame = window.requestAnimationFrame(paint)
		})
	}

	/**
	 * The bust. Built from lathe primitives with a procedural room environment,
	 * so the chrome has something to reflect without downloading an HDRI. The
	 * head follows the pointer with damped rotation; the whole bust follows it a
	 * little, which sells the parallax.
	 */
	type ThreeModule = typeof import('three')

	async function mountBust(host: HTMLElement) {
		const THREE: ThreeModule = await import('three')
		const { RoomEnvironment } = await import('three/examples/jsm/environments/RoomEnvironment.js')

		let renderer: import('three').WebGLRenderer
		try {
			renderer = new THREE.WebGLRenderer({
				antialias: true,
				alpha: true,
				powerPreference: 'high-performance'
			})
		} catch (error) {
			console.warn('[skills-hero] WebGL no disponible', error)
			host.dataset.stage = 'unavailable'
			return
		}

		renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75))
		renderer.setClearColor(0x000000, 0)
		renderer.toneMapping = THREE.ACESFilmicToneMapping
		renderer.toneMappingExposure = 1.2
		renderer.domElement.style.display = 'block'
		host.appendChild(renderer.domElement)

		const scene = new THREE.Scene()
		const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 60)

		// Procedural environment: gives the metal real reflections with no asset.
		const pmrem = new THREE.PMREMGenerator(renderer)
		const environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture
		scene.environment = environment

		// White shell for the helmet, graphite for the suit: the white title sits
		// over the torso, so the body has to stay dark to keep the contrast.
		const shell = new THREE.MeshStandardMaterial({
			color: 0xd8dade,
			metalness: 0.05,
			roughness: 0.42,
			envMapIntensity: 0.6
		})
		const suit = new THREE.MeshStandardMaterial({
			color: 0x33363e,
			metalness: 0.12,
			roughness: 0.6,
			envMapIntensity: 0.45
		})
		const visorGlass = new THREE.MeshStandardMaterial({
			color: 0x05050a,
			metalness: 1,
			roughness: 0.06,
			envMapIntensity: 1.4
		})
		const hardware = new THREE.MeshStandardMaterial({
			color: 0x8e949c,
			metalness: 0.7,
			roughness: 0.35,
			envMapIntensity: 0.8
		})

		// ── Helmet ──────────────────────────────────────────────────────────
		// Round shell plus a spherical-cap visor. The visor is asymmetric, so
		// the pointer tracking is actually visible: it swings with the head.
		const head = new THREE.Group()
		head.add(new THREE.Mesh(new THREE.SphereGeometry(0.62, 96, 96), shell))

		const visor = new THREE.Mesh(
			new THREE.SphereGeometry(0.626, 96, 96, Math.PI / 2 - 0.62, 1.24, 1.0, 1.0),
			visorGlass
		)
		head.add(visor)

		// Side comms pods: small asymmetric hardware that makes the turn read.
		for (const side of [-1, 1]) {
			const pod = new THREE.Mesh(new THREE.CylinderGeometry(0.09, 0.09, 0.07, 32), hardware)
			pod.rotation.z = Math.PI / 2
			pod.position.set(side * 0.605, 0.02, -0.02)
			head.add(pod)
		}

		const HEAD_Y = 0.66
		head.position.y = HEAD_Y

		// ── Neck ring and suit ──────────────────────────────────────────────
		// The collar joint is what sells the helmet as a helmet.
		const collar = new THREE.Mesh(new THREE.TorusGeometry(0.3, 0.065, 24, 64), hardware)
		collar.rotation.x = Math.PI / 2
		collar.position.y = -0.02

		// Broad shoulders: roughly three helmet-widths across, which is what
		// makes the silhouette read as a bust instead of a floating head.
		const torsoProfile: [number, number][] = [
			[0.32, 0.02],
			[0.52, -0.08],
			[0.85, -0.22],
			[1.12, -0.42],
			[1.3, -0.66],
			[1.4, -0.94],
			[1.44, -1.24],
			[1.42, -1.6],
			[1.35, -2],
			[1.26, -2.4],
			[1.18, -2.7]
		]
		const torsoGeometry = new THREE.LatheGeometry(
			torsoProfile.map(([radius, y]) => new THREE.Vector2(radius, y)),
			96
		)
		torsoGeometry.scale(1, 1, 0.52)
		const torso = new THREE.Mesh(torsoGeometry, suit)
		torso.position.y = 0

		const bust = new THREE.Group()
		bust.add(head, collar, torso)

		bust.position.y = 0
		scene.add(bust)

		// ── Light ───────────────────────────────────────────────────────────
		// The suit is light and the set is black, so the rim lights do most of
		// the shaping; the brand accent only touches one low side.
		const key = new THREE.DirectionalLight(0xffffff, 1.5)
		key.position.set(-3.2, 3.6, 5)
		const rimLeft = new THREE.DirectionalLight(0xffffff, 2.2)
		rimLeft.position.set(-3.5, 2.4, -4.5)
		const rimRight = new THREE.DirectionalLight(0xffffff, 1.4)
		rimRight.position.set(3.6, 1.6, -4)
		const accent = new THREE.DirectionalLight(0xc70039, 1)
		accent.position.set(5, -1.2, 2)
		const fill = new THREE.DirectionalLight(0x9fb7ff, 0.6)
		fill.position.set(-4, -2, 2.4)
		scene.add(key, rimLeft, rimRight, accent, fill, new THREE.HemisphereLight(0xffffff, 0x08080c, 0.25))

		// ── Pointer ─────────────────────────────────────────────────────────
		const pointer = { x: 0, y: 0 }

		if (!reducedMotion) {
			window.addEventListener(
				'pointermove',
				(event) => {
					pointer.x = (event.clientX / window.innerWidth) * 2 - 1
					pointer.y = (event.clientY / window.innerHeight) * 2 - 1
				},
				{ passive: true }
			)
		}

		// ── Sizing ──────────────────────────────────────────────────────────
		const resize = () => {
			const width = host.clientWidth
			const height = host.clientHeight
			if (!width || !height) return

			renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.75))
			renderer.setSize(width, height, false)

			camera.aspect = width / height
			// Pull back on narrow viewports so the shoulders stay in frame.
			camera.position.set(0, 0, width < 640 ? 9 : width < 1024 ? 7.2 : 6.4)
			camera.lookAt(0, -0.36, 0)
			camera.updateProjectionMatrix()
		}

		resize()

		const resizeObserver = new ResizeObserver(resize)
		resizeObserver.observe(host)

		// ── Loop ────────────────────────────────────────────────────────────
		const startedAt = performance.now()
		let frameId = 0
		let visible = true

		const damp = (current: number, target: number, amount: number) =>
			current + (target - current) * amount

		const render = () => {
			const elapsed = (performance.now() - startedAt) / 1000

			if (!reducedMotion) {
				head.rotation.y = damp(head.rotation.y, -pointer.x * 0.5, 0.06)
				head.rotation.x = damp(head.rotation.x, pointer.y * 0.26, 0.06)
				head.rotation.z = damp(head.rotation.z, -pointer.x * 0.07, 0.06)
				bust.rotation.y = damp(bust.rotation.y, -pointer.x * 0.16, 0.04)
				bust.rotation.x = damp(bust.rotation.x, pointer.y * 0.04, 0.04)
				head.position.y = HEAD_Y + Math.sin(elapsed * 0.9) * 0.008
			}

			renderer.render(scene, camera)

			if (visible) frameId = window.requestAnimationFrame(render)
		}

		// A single static frame is all a reduced-motion visitor needs.
		if (reducedMotion) {
			renderer.render(scene, camera)
		} else {
			frameId = window.requestAnimationFrame(render)
		}

		// Stop the GPU work while the hero is scrolled away.
		const intersection = new IntersectionObserver(
			([entry]) => {
				visible = entry.isIntersecting
				if (visible && !reducedMotion && !frameId) {
					frameId = window.requestAnimationFrame(render)
				} else if (!visible) {
					window.cancelAnimationFrame(frameId)
					frameId = 0
				}
			},
			{ threshold: 0 }
		)
		intersection.observe(host)
	}

	const stage = document.querySelector<HTMLElement>('[data-skills-canvas]')
	if (stage) {
		mountBust(stage).catch((error) => {
			console.warn('[skills-hero] no se pudo montar la figura', error)
			stage.dataset.stage = 'unavailable'
		})
	}
</script>
