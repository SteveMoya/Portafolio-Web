---
interface Props {
	title: string
	titleCaption: string
	description?: string
	descriptionCaption?: string
	/** Heading level for the title. Use "h2" when the page already has its own H1. */
	level?: 'h1' | 'h2'
}

const { title, titleCaption, description, descriptionCaption, level = 'h1' } = Astro.props
const TitleTag = level
const SubtitleTag = level === 'h1' ? 'h2' : 'h3'
---

<header
	class="h-auto w-full items-center justify-center p-1 pb-7 pt-4 text-center font-raleway text-[45px] font-black max-md:mt-16"
>
	<TitleTag>
		{title}{' '}
		<span class="font-extrabold text-[#c70039]"
			>{titleCaption}</span
		>
	</TitleTag>
	<SubtitleTag class=" block p-2 pt-2 text-[25px] font-normal">
		{description}{' '}
		<span class="font-extrabold text-[#c70039]">
			{descriptionCaption}</span
		>
	</SubtitleTag>
</header>
