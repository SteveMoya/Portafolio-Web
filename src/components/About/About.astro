---
import Button from '@components/ui/Button.astro'

import ProfileImg from '@/assets/img/ProfileImage.jpg'
import { Image } from 'astro:assets'
---

<section id="about" data-about-section class="reveal relative md:sticky md:top-0 z-0 flex min-h-screen w-full items-center bg-[#0a0a0a] px-6 py-20 sm:px-10 lg:px-16 will-change-[transform,opacity,filter]">
	<div class="mx-auto grid max-w-[1680px] gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
		<!-- Blueprint quote card -->
		<div class="dotted-card about-pattern-card relative rounded-2xl border border-white/10 bg-[#101010] p-8 sm:p-12">
			<span class="corner-tick corner-tick--tl"></span>
			<span class="corner-tick corner-tick--tr"></span>
			<span class="corner-tick corner-tick--bl"></span>
			<span class="corner-tick corner-tick--br"></span>

			<p class="mb-6 text-xs font-bold uppercase tracking-[0.3em] text-[#c70039]">Sobre mí</p>

			<blockquote class="text-2xl font-medium leading-snug text-white sm:text-3xl lg:text-4xl">
				<span class="font-black">Marketing digital</span> y{' '}
				<span class="font-black">desarrollo web</span>,{' '}
				<em class="font-serif italic text-white/70">ahora sumando</em>{' '}
				<span class="font-black text-[#c70039]">inteligencia artificial</span> y{' '}
				<span class="font-black text-[#c70039]">análisis de datos</span>.
			</blockquote>

			<div class="mt-10 grid gap-8 border-t border-white/10 pt-8 sm:grid-cols-2">
				<div>
					<p class="mb-2 text-[10px] font-bold uppercase tracking-[0.25em] text-white/40">Enfoque</p>
					<p class="text-sm leading-relaxed text-white/60">
						Más de 2 años diseñando y ejecutando campañas y productos digitales, aprendiendo a
						sostener lo que construyo en el tiempo.
					</p>
				</div>
				<div>
					<p class="mb-2 text-[10px] font-bold uppercase tracking-[0.25em] text-white/40">Formación técnica</p>
					<p class="text-sm leading-relaxed text-white/60">
						Técnico en Inteligencia Artificial y Análisis de Datos, aplicando esa base a proyectos
						reales de marketing y desarrollo.
					</p>
				</div>
			</div>

			<a title="Conocer más sobre mí" href="/about" class="mt-10 inline-block">
				<Button type="button" variant="download">Conoce más de mí</Button>
			</a>
		</div>

		<!-- Photo -->
		<Image
			class="aspect-[4/5] w-full rounded-2xl object-cover grayscale transition-all duration-700 hover:grayscale-0"
			src={ProfileImg}
			loading="eager"
			alt="Steve Moya Cepeda"
		/>
	</div>
</section>

