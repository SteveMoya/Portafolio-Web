---
import { Icon } from 'astro-icon/components'
import { basics } from '@cv'
import BlockReveal from '@components/ui/BlockReveal.astro'

const { name, label, location } = basics
const year = new Date().getFullYear()

const socialLinks = {
	github: 'https://github.com/SteveMoya',
	linkedin: 'https://www.linkedin.com/in/steve-moya-cepeda-549469227/',
	instagram: 'https://www.instagram.com/steve_moya_cepeda/'
}
---

<section class="relative -mt-16 flex h-dvh w-screen flex-col overflow-hidden bg-[#0a0a0a]">
	<!-- Background: dot grid + rotating light spotlight (from PersonalBlog's HeroVisual) -->
	<div class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(circle,_#444_0.5px,_transparent_0.5px)] opacity-20 [background-size:24px_24px]"></div>
	<div class="spotlight-drift pointer-events-none absolute inset-0 z-0">
		<div class="spotlight-beam spotlight-beam--1"></div>
		<div class="spotlight-beam spotlight-beam--2"></div>
		<div class="spotlight-beam spotlight-beam--3"></div>
	</div>

	<!-- Availability tag, on the left edge -->
	<div
		class="tag-hover availability-tag absolute z-[2] hidden items-center gap-2 rounded-b-md border border-t-0 border-white/10 bg-white/[0.03] py-2 pr-4 pl-0 text-[10px] font-semibold uppercase tracking-[0.25em] text-white/50 sm:flex"
	>
		<span class="h-1.5 w-1.5 rounded-full bg-[#c70039]"></span>
		Disponible para proyectos
	</div>

	<div class="relative z-[2] mx-auto flex w-full max-w-[1680px] flex-1 flex-col items-center justify-center gap-4 px-6 pt-16 sm:px-10 lg:px-16">
		<!-- Line 1: MARKETING [icon] DIGITAL -->
		<div class="relative flex flex-col items-center justify-center gap-4 md:flex-row md:gap-8">
			<p class="line-in mb-2 max-w-[200px] text-center text-[10px] font-medium uppercase leading-relaxed tracking-[0.2em] text-white/50 md:mb-0 md:text-right" style="animation-delay: 0.2s">
				Hola, soy {name}. Marketing, desarrollo, IA y datos.
			</p>
			<div class="relative">
				<a
					href={socialLinks.github}
					target="_blank"
					rel="noopener noreferrer"
					title="GitHub"
					aria-label="GitHub"
					class="icon-entrance icon-float--y absolute -top-4 right-0 z-20 hidden text-white/40 transition-colors duration-300 hover:text-[#c70039] md:right-2 md:block"
					style="animation-delay: 0.3s"
				>
					<Icon name="mdi:github" class="h-7 w-7" />
				</a>
				<BlockReveal
					as="h1"
					class="flex items-center whitespace-nowrap font-poppins text-[7.8vw] font-black uppercase leading-[0.85] tracking-tighter sm:text-[8vw] lg:text-[6.2vw]"
					boxColor="#c70039"
					delay={0.1}
				>
					<span class="text-shiny">Marketing</span>
					<Icon name="mdi:bullhorn-outline" class="icon-bob mx-[0.05em] h-[0.7em] w-[0.7em] shrink-0 text-[#c70039]" style="animation-delay: 0s; animation-duration: 3.2s" />
					<span class="text-shiny">Digital</span>
				</BlockReveal>
			</div>
		</div>

		<!-- Line 2: DESARROLLO [icon] WEB -->
		<div class="relative flex items-center justify-center gap-8">
			<div class="relative">
				<a
					href={socialLinks.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					title="LinkedIn"
					aria-label="LinkedIn"
					class="icon-entrance icon-float--y-reverse absolute -top-8 left-4 z-20 hidden text-white/40 transition-colors duration-300 hover:text-[#c70039] md:block"
					style="animation-delay: 0.4s"
				>
					<Icon name="mdi:linkedin" class="h-7 w-7" />
				</a>
				<a
					href={socialLinks.instagram}
					target="_blank"
					rel="noopener noreferrer"
					title="Instagram"
					aria-label="Instagram"
					class="icon-entrance icon-float--x absolute -bottom-10 right-16 z-20 hidden text-white/40 transition-colors duration-300 hover:text-[#c70039] md:right-24 md:block"
					style="animation-delay: 0.5s"
				>
					<Icon name="mdi:instagram" class="h-7 w-7" />
				</a>
				<BlockReveal
					as="h1"
					class="flex items-center whitespace-nowrap font-poppins text-[7.8vw] font-black uppercase leading-[0.85] tracking-tighter sm:text-[8vw] lg:text-[6.2vw]"
					boxColor="#c70039"
					delay={0.3}
				>
					<span class="text-shiny">Desarrollo</span>
					<Icon name="mdi:code-tags" class="icon-bob mx-[0.05em] h-[0.7em] w-[0.7em] shrink-0 text-[#c70039]" style="animation-delay: 0.35s; animation-duration: 3.6s" />
					<span class="text-shiny">Web</span>
				</BlockReveal>
			</div>
		</div>

		<!-- Line 3: IA [icon] DATOS -->
		<div class="relative flex flex-col items-center justify-center gap-4 md:flex-row md:gap-8">
			<BlockReveal
				as="h1"
				class="flex items-center whitespace-nowrap font-poppins text-[7.8vw] font-black uppercase leading-[0.85] tracking-tighter sm:text-[8vw] lg:text-[6.2vw]"
				boxColor="#c70039"
				delay={0.5}
			>
				<span class="text-shiny">IA</span>
				<Icon name="mdi:robot-outline" class="icon-bob mx-[0.05em] h-[0.7em] w-[0.7em] shrink-0 text-[#c70039]" style="animation-delay: 0.7s; animation-duration: 2.8s" />
				<span class="text-shiny">Datos</span>
			</BlockReveal>

			<p class="line-in mt-2 max-w-[220px] text-center text-[10px] font-medium uppercase leading-relaxed tracking-[0.2em] text-white/50 md:mt-0 md:text-left" style="animation-delay: 0.6s">
				Abierto a nuevas oportunidades, sin importar ubicación o modalidad.
			</p>
		</div>

		<p class="line-in mt-6 text-center text-sm font-medium text-white/60 sm:text-base" style="animation-delay: 0.7s">
			{label}
		</p>
	</div>

	<div class="relative z-[2] mx-auto flex w-full max-w-[1680px] items-center justify-between gap-6 border-t border-white/10 px-6 py-5 sm:px-10 lg:px-16">
		<span class="text-xs font-semibold uppercase tracking-[0.2em] text-white/40">
			{location.city}, {location.countryCode} &mdash; {year}
		</span>

		<a
			href="/about"
			aria-label="Ver CV completo"
			class="resume-button group flex h-11 shrink-0 items-center overflow-hidden rounded-full bg-white text-black shadow-lg transition-[width] duration-500"
		>
			<span class="resume-button__label min-w-0 whitespace-nowrap text-[10px] font-black uppercase tracking-widest opacity-0 transition-opacity duration-200">
				Ver CV
			</span>
			<span class="flex h-11 w-11 shrink-0 items-center justify-center transition-transform duration-500 group-hover:rotate-45">
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M7 17L17 7M17 7H8M17 7V16" />
				</svg>
			</span>
		</a>
	</div>
</section>

<style>
	/* ── Entrance animations ── */
	@keyframes line-in {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.line-in {
		animation: line-in 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	@keyframes icon-entrance {
		from {
			opacity: 0;
			transform: translateY(40px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.icon-entrance {
		animation: icon-entrance 1s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	/* ── Continuous float loops (composes with the parent's icon-entrance transform since it's the same element's own additional keyframe target: translate only, run after entrance via delay) ── */
	@keyframes icon-float-y {
		50% {
			transform: translateY(-10px);
		}
	}

	@keyframes icon-float-y-reverse {
		50% {
			transform: translateY(10px);
		}
	}

	@keyframes icon-float-x {
		50% {
			transform: translateX(10px);
		}
	}

	.icon-float--y {
		animation: icon-entrance 1s cubic-bezier(0.16, 1, 0.3, 1) both, icon-float-y 2s ease-in-out infinite 1s;
	}

	.icon-float--y-reverse {
		animation: icon-entrance 1s cubic-bezier(0.16, 1, 0.3, 1) both, icon-float-y-reverse 2.5s ease-in-out infinite 1s;
	}

	.icon-float--x {
		animation: icon-entrance 1s cubic-bezier(0.16, 1, 0.3, 1) both, icon-float-x 3s ease-in-out infinite 1s;
	}

	/* ── Inline headline icons: gentle continuous bob, small enough to stay clear of the tight line-height ── */
	@keyframes icon-bob {
		50% {
			transform: translateY(-0.08em);
		}
	}

	.icon-bob {
		display: inline-block;
		animation: icon-bob 3s ease-in-out infinite;
	}

	/* ── Availability tag: flush on the left edge, vertically centered ── */
	.availability-tag {
		top: 50%;
		left: 0;
		writing-mode: vertical-rl;
		text-orientation: mixed;
		transform: translateY(-50%);
	}

	/* ── Availability tag hover ── */
	.tag-hover:hover {
		transform: translateY(-50%) translateX(6px);
	}

	/* ── Resume button: circle that widens to a pill on hover ── */
	.resume-button {
		width: 2.75rem;
	}

	.resume-button:hover {
		width: 8rem;
	}

	.resume-button:hover .resume-button__label {
		padding-left: 1.25rem;
		padding-right: 0.25rem;
		opacity: 1;
		transition-delay: 150ms;
	}

	/* ── Spotlight beams (adapted from PersonalBlog's Spotlight component) ── */
	.spotlight-drift {
		animation: spotlight-drift 7s ease-in-out infinite alternate;
	}

	.spotlight-beam {
		position: absolute;
		top: 0;
		left: 0;
		transform-origin: top left;
	}

	.spotlight-beam--1 {
		width: 560px;
		height: 1380px;
		transform: translateY(-350px) rotate(-45deg);
		background: radial-gradient(68.54% 68.72% at 55.02% 31.46%, rgba(255, 255, 255, 0.15) 0, rgba(255, 255, 255, 0.05) 50%, transparent 80%);
	}

	.spotlight-beam--2 {
		width: 240px;
		height: 1380px;
		transform: rotate(-45deg) translate(5%, -50%);
		background: radial-gradient(50% 50% at 50% 50.01%, rgba(255, 255, 255, 0.1) 0, rgba(255, 255, 255, 0.02) 80%, transparent 100%);
	}

	.spotlight-beam--3 {
		width: 240px;
		height: 1380px;
		transform: rotate(-45deg) translate(-180%, -70%);
		background: radial-gradient(50% 50% at 50% 50.01%, rgba(255, 255, 255, 0.08) 0, transparent 80%);
	}

	@keyframes spotlight-drift {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(120px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.line-in,
		.icon-entrance,
		.icon-float--y,
		.icon-float--y-reverse,
		.icon-float--x,
		.icon-bob,
		.spotlight-drift {
			animation: none;
		}
	}
</style>
