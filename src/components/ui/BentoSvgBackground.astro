---
interface Props {
	theme:
		| 'rocket'
		| 'timeline'
		| 'code'
		| 'education'
		| 'identity'
		| 'gallery'
		| 'document'
		| 'chat'
		| 'post'
		| 'archive'
		| 'palette'
		| 'marketing'
		| 'tags'
		| 'productivity'
		| 'rss'
	variant?: 'hero' | 'compact' | 'stack'
}

const { theme, variant = 'compact' } = Astro.props
---

<div class="bento-bg pointer-events-none absolute inset-0 overflow-hidden rounded-[inherit]">
	<!-- Grid mesh background -->
	<div class="bento-grid absolute inset-0 opacity-40 transition-opacity duration-500 group-hover:opacity-65"></div>

	<!-- Radial subtle glow -->
	<div
		class="bento-glow absolute -right-6 -top-6 h-28 w-28 rounded-full bg-[#c70039]/10 blur-2xl transition-all duration-500 group-hover:scale-125 group-hover:bg-[#c70039]/20"
	></div>

	<!-- Thematic SVG Illustration -->
	<div
		class={`bento-svg-wrap absolute transition-all duration-500 ${
			variant === 'hero'
				? 'right-2 top-6 h-24 w-24 text-white/20 group-hover:text-white/60 group-hover:scale-105'
				: variant === 'stack'
					? 'left-20 right-14 top-1/2 -translate-y-1/2 h-9 text-white/15 group-hover:text-white/45'
					: 'right-1.5 bottom-1 h-12 w-12 text-white/15 group-hover:text-white/45'
		}`}
	>
		{
			theme === 'rocket' && (
				<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
					<!-- Constellation stars -->
					<circle cx="28" cy="24" r="0.9" class="star star-1 fill-current" />
					<circle cx="86" cy="42" r="1" class="star star-2 fill-current" />
					<circle cx="20" cy="56" r="0.8" class="star star-3 fill-current" />

					<!-- Flight trajectory: starts from bottom-left and aligns directly into the rocket thruster -->
					<path
						d="M 16 88 C 26 80, 36 68, 51 53"
						class="orbit-line"
						stroke-dasharray="3 3"
						stroke-width="1"
					/>
					<path
						d="M 20 92 C 30 84, 40 72, 55 57"
						class="opacity-30"
						stroke-dasharray="2 3"
						stroke-width="0.7"
					/>

					<!-- Rocket container with hover translation -->
					<g class="rocket-hover-group transition-transform duration-500 group-hover:-translate-y-2 group-hover:translate-x-2">
						<!-- Seamless unified rocket vessel rotated at exactly 45 degrees -->
						<g transform="translate(68, 36) rotate(45)">
							<!-- Thruster Flame: connected directly to nozzle exit at Y=12 -->
							<path
								d="M -4 12 Q -5 18 0 25 Q 5 18 4 12 Z"
								class="thrust-flame fill-[#c70039]/25 stroke-[#c70039]"
								stroke-width="1.3"
							/>
							<path
								d="M -2.5 12 Q -3 16 0 20 Q 3 16 2.5 12 Z"
								class="fill-[#c70039] stroke-none"
							/>

							<!-- Thruster Nozzle: connected directly to fuselage base at Y=8 -->
							<polygon
								points="-4,8 -5,12 5,12 4,8"
								class="fill-[#0b0b0d] stroke-current"
								stroke-width="1"
							/>

							<!-- Left Stabilizer Fin: welded seamlessly to left wall from Y=-2 to Y=8 -->
							<polygon
								points="-7,-2 -14,9 -7,8"
								class="fill-[#0b0b0d] stroke-current"
								stroke-width="1.1"
							/>

							<!-- Right Stabilizer Fin: welded seamlessly to right wall from Y=-2 to Y=8 -->
							<polygon
								points="7,-2 14,9 7,8"
								class="fill-[#0b0b0d] stroke-current"
								stroke-width="1.1"
							/>

							<!-- Rocket Fuselage: seamless aerodynamic hull tapering to nose cone tip at (0, -26) -->
							<path
								d="M 0 -26 C -4 -16, -7 -6, -7 8 L 7 8 C 7 -6, 4 -16, 0 -26 Z"
								class="fill-[#0b0b0d] stroke-current"
								stroke-width="1.2"
							/>

							<!-- Nose Cone Accent Ring -->
							<line x1="-5" y1="-16" x2="5" y2="-16" class="stroke-[#c70039]" stroke-width="1.2" />

							<!-- Porthole Window -->
							<circle cx="0" cy="-4" r="3.2" class="fill-[#0b0b0d] stroke-current" stroke-width="1.1" />
							<circle cx="0" cy="-4" r="1.4" class="fill-[#c70039] stroke-none" />

							<!-- Center spine ridge -->
							<line x1="0" y1="-2" x2="0" y2="8" stroke-dasharray="2 2" class="opacity-40" stroke-width="0.8" />
						</g>
					</g>

					<!-- Projected vector path ahead of the rocket nose -->
					<line x1="88" y1="16" x2="94" y2="10" stroke-dasharray="2 2" class="stroke-[#c70039] opacity-75" stroke-width="1" />
					<polyline points="91,10 94,10 94,13" class="stroke-[#c70039] opacity-85" stroke-width="1.2" />
				</svg>
			)
		}

		{
			theme === 'timeline' && (
				<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
					<!-- Baseline coordinate axis -->
					<line x1="18" y1="86" x2="92" y2="86" class="opacity-25" stroke-dasharray="3 3" stroke-width="0.8" />
					<!-- Axis tick marks -->
					<line x1="24" y1="84" x2="24" y2="88" class="opacity-35" stroke-width="0.8" />
					<line x1="54" y1="84" x2="54" y2="88" class="opacity-35" stroke-width="0.8" />
					<line x1="84" y1="84" x2="84" y2="88" class="opacity-35" stroke-width="0.8" />
					<!-- Vertical drop lines from each milestone node to baseline -->
					<line x1="24" y1="72" x2="24" y2="86" stroke-dasharray="2 2" class="opacity-30" stroke-width="0.8" />
					<line x1="54" y1="46" x2="54" y2="86" stroke-dasharray="2 2" class="opacity-30" stroke-width="0.8" />
					<line x1="84" y1="22" x2="84" y2="86" stroke-dasharray="2 2" class="opacity-30" stroke-width="0.8" />
					<!-- Mathematically exact career curve passing precisely through (24,72), (54,46) and terminating at (84,22) -->
					<path
						d="M 24 72 C 36 72, 44 46, 54 46 C 64 46, 74 22, 84 22"
						class="timeline-path stroke-current"
						stroke-width="1.3"
					/>
					<!-- Milestone Node 1 (Initial career foundation) -->
					<g class="node node-1">
						<circle cx="24" cy="72" r="3.5" class="fill-[#0b0b0d] stroke-current" stroke-width="1.2" />
						<circle cx="24" cy="72" r="1.5" class="fill-current stroke-none opacity-80" />
					</g>
					<!-- Milestone Node 2 (Midpoint / growth) -->
					<g class="node node-2">
						<circle cx="54" cy="46" r="3.5" class="fill-[#0b0b0d] stroke-current" stroke-width="1.2" />
						<circle cx="54" cy="46" r="1.5" class="fill-[#c70039] stroke-none" />
					</g>
					<!-- Milestone Node 3 (Senior / current peak destination) -->
					<g class="node node-3">
						<circle cx="84" cy="22" r="4.5" class="fill-[#0b0b0d] stroke-[#c70039]" stroke-width="1.5" />
						<circle cx="84" cy="22" r="2" class="fill-[#c70039] stroke-none" />
						<circle cx="84" cy="22" r="8" class="pulse-ring stroke-[#c70039] opacity-50" stroke-width="1" />
					</g>
				</svg>
			)
		}

		{
			theme === 'code' && (
				<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
					<polyline
						points="36,32 20,48 36,64"
						class="brace-left transition-transform duration-300 group-hover:-translate-x-1"
					/>
					<line x1="44" y1="68" x2="56" y2="28" class="stroke-[#c70039] opacity-80" stroke-width="1.3" />
					<polyline
						points="64,32 80,48 64,64"
						class="brace-right transition-transform duration-300 group-hover:translate-x-1"
					/>
					<rect x="42" y="74" width="8" height="2" class="term-cursor fill-current stroke-none opacity-60" />
				</svg>
			)
		}

		{
			theme === 'education' && (
				<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
					<polygon points="50,30 84,43 50,56 16,43" class="cap-top" />
					<path d="M 28 49 L 28 64 C 28 72, 72 72, 72 64 L 72 49" class="cap-base opacity-70" />
					<path d="M 50 43 L 84 55 L 84 68" class="tassel-line stroke-[#c70039]" stroke-width="1" />
					<circle cx="84" cy="70" r="1.8" class="fill-[#c70039] stroke-none" />
					<g class="sparkle-star transition-transform duration-700 group-hover:rotate-45">
						<path d="M 76 18 Q 76 25 83 25 Q 76 25 76 32 Q 76 25 69 25 Q 76 25 76 18 Z" class="fill-current stroke-none opacity-80" />
					</g>
				</svg>
			)
		}

		{
			theme === 'identity' && (
				<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
					<circle cx="68" cy="48" r="10" class="stroke-current opacity-80" />
					<circle cx="68" cy="48" r="18" stroke-dasharray="3 3" class="opacity-50" />
					<circle cx="68" cy="48" r="26" class="stroke-[#c70039] opacity-40" stroke-width="1" />
					<circle cx="68" cy="48" r="34" stroke-dasharray="4 3" class="opacity-25" />
					<circle cx="68" cy="48" r="3" class="fill-[#c70039] stroke-none" />
				</svg>
			)
		}

		{
			theme === 'gallery' && (
				variant === 'stack' ? (
					<svg viewBox="0 0 120 40" class="h-full w-full fill-none stroke-current" stroke-width="1">
						<path d="M 15 10 L 8 10 L 8 20" class="opacity-50" />
						<path d="M 105 10 L 112 10 L 112 20" class="opacity-50" />
						<path d="M 15 30 L 8 30 L 8 20" class="opacity-50" />
						<path d="M 105 30 L 112 30 L 112 20" class="opacity-50" />
						<circle cx="60" cy="20" r="8" class="stroke-[#c70039] opacity-60" stroke-width="1" />
						<circle cx="60" cy="20" r="2" class="fill-current stroke-none" />
						<line x1="60" y1="7" x2="60" y2="10" class="opacity-60" />
						<line x1="60" y1="30" x2="60" y2="33" class="opacity-60" />
						<line x1="47" y1="20" x2="50" y2="20" class="opacity-60" />
						<line x1="70" y1="20" x2="73" y2="20" class="opacity-60" />
					</svg>
				) : (
					<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
						<path d="M 24 34 L 24 24 L 34 24" class="bracket tl" />
						<path d="M 76 34 L 76 24 L 66 24" class="bracket tr" />
						<path d="M 24 66 L 24 76 L 34 76" class="bracket bl" />
						<path d="M 76 66 L 76 76 L 66 76" class="bracket br" />
						<circle cx="50" cy="50" r="12" class="stroke-[#c70039] opacity-70 group-hover:opacity-100" />
						<circle cx="50" cy="50" r="2" class="fill-current stroke-none" />
						<line x1="50" y1="32" x2="50" y2="36" />
						<line x1="50" y1="64" x2="50" y2="68" />
						<line x1="32" y1="50" x2="36" y2="50" />
						<line x1="64" y1="50" x2="68" y2="50" />
					</svg>
				)
			)
		}

		{
			theme === 'document' && (
				variant === 'stack' ? (
					<svg viewBox="0 0 120 40" class="h-full w-full fill-none stroke-current" stroke-width="1">
						<line x1="10" y1="12" x2="75" y2="12" class="opacity-35" stroke-dasharray="3 2" />
						<line x1="10" y1="20" x2="90" y2="20" class="opacity-45" />
						<line x1="10" y1="28" x2="60" y2="28" class="opacity-35" stroke-dasharray="4 2" />
						<line
							x1="45"
							y1="6"
							x2="45"
							y2="34"
							class="laser-sweep stroke-[#c70039] opacity-70"
							stroke-width="1.5"
						/>
					</svg>
				) : (
					<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
						<path d="M 30 22 L 58 22 L 74 38 L 74 78 L 30 78 Z" class="stroke-current" />
						<path d="M 58 22 L 58 38 L 74 38" class="stroke-current opacity-60" />
						<line x1="38" y1="46" x2="66" y2="46" class="opacity-40" />
						<line x1="38" y1="54" x2="60" y2="54" class="opacity-40" />
						<line x1="38" y1="62" x2="52" y2="62" class="opacity-40" />
						<line
							x1="24"
							y1="42"
							x2="80"
							y2="42"
							class="laser-beam stroke-[#c70039] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
							stroke-width="1.4"
						/>
					</svg>
				)
			)
		}

		{
			theme === 'chat' && (
				variant === 'stack' ? (
					<svg viewBox="0 0 120 40" class="h-full w-full fill-none stroke-current" stroke-width="1.2">
						<line x1="15" y1="20" x2="25" y2="20" class="opacity-40" />
						<line x1="30" y1="14" x2="30" y2="26" class="stroke-current opacity-60" />
						<line x1="40" y1="8" x2="40" y2="32" class="stroke-[#c70039] opacity-80" stroke-width="1.5" />
						<line x1="50" y1="12" x2="50" y2="28" class="stroke-current opacity-70" />
						<line x1="60" y1="6" x2="60" y2="34" class="stroke-[#c70039] opacity-90" stroke-width="1.5" />
						<line x1="70" y1="15" x2="70" y2="25" class="stroke-current opacity-60" />
						<line x1="80" y1="10" x2="80" y2="30" class="stroke-[#c70039] opacity-80" stroke-width="1.5" />
						<line x1="90" y1="18" x2="90" y2="22" class="opacity-40" />
						<line x1="95" y1="20" x2="105" y2="20" class="opacity-40" />
					</svg>
				) : (
					<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
						<path
							d="M 22 46 C 22 34, 34 24, 52 24 C 70 24, 82 34, 82 46 C 82 58, 70 68, 54 68 L 38 75 L 40 66 C 28 62, 22 55, 22 46 Z"
							class="speech-bubble"
						/>
						<circle cx="42" cy="46" r="2.2" class="fill-current stroke-none" />
						<circle cx="52" cy="46" r="2.2" class="fill-[#c70039] stroke-none" />
						<circle cx="62" cy="46" r="2.2" class="fill-current stroke-none" />
					</svg>
				)
			)
		}

		{
			theme === 'post' && (
				<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
					<path
						d="M 45 42 L 78 36 L 86 68 L 53 74 Z"
						class="opacity-25 stroke-current"
						stroke-dasharray="2 3"
					/>
					<path
						d="M 35 72 C 50 72, 55 52, 70 54 S 82 44, 86 38"
						class="quill-stroke stroke-[#c70039]"
						stroke-width="1.6"
					/>
					<circle cx="86" cy="38" r="2.5" class="fill-[#c70039] stroke-none" />
					<circle cx="86" cy="38" r="6" class="pulse-ring stroke-[#c70039] opacity-45" stroke-width="0.8" />
					<line x1="48" y1="52" x2="68" y2="52" stroke-dasharray="2 2" class="opacity-35" stroke-width="0.8" />
					<line x1="52" y1="60" x2="72" y2="60" stroke-dasharray="2 2" class="opacity-35" stroke-width="0.8" />
				</svg>
			)
		}

		{
			theme === 'archive' && (
				<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
					<rect
						x="42"
						y="24"
						width="42"
						height="48"
						rx="3"
						class="sheet sheet-3 opacity-30 transition-transform duration-500 group-hover:-translate-x-2 group-hover:-translate-y-1"
					/>
					<rect
						x="34"
						y="30"
						width="42"
						height="48"
						rx="3"
						class="sheet sheet-2 opacity-55 transition-transform duration-500 group-hover:-translate-x-1 group-hover:-translate-y-0.5"
					/>
					<rect x="26" y="36" width="42" height="48" rx="3" class="sheet sheet-1 fill-[#0b0b0d] stroke-current" />
					<line x1="32" y1="46" x2="54" y2="46" class="stroke-[#c70039]" stroke-width="1.4" />
					<line x1="32" y1="54" x2="58" y2="54" class="opacity-45" />
					<line x1="32" y1="62" x2="48" y2="62" class="opacity-45" />
				</svg>
			)
		}

		{
			theme === 'palette' && (
				<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
					<path d="M 22 70 C 30 32, 70 32, 78 70" class="bezier-curve stroke-current" />
					<line x1="30" y1="32" x2="70" y2="32" stroke-dasharray="2 2" class="opacity-40" stroke-width="0.8" />
					<circle cx="30" cy="32" r="3" class="fill-[#0b0b0d] stroke-[#c70039]" stroke-width="1.3" />
					<circle cx="70" cy="32" r="3" class="fill-[#0b0b0d] stroke-[#c70039]" stroke-width="1.3" />
					<rect x="19" y="67" width="5" height="5" class="fill-[#c70039] stroke-none" />
					<rect x="76" y="67" width="5" height="5" class="fill-current stroke-none" />
				</svg>
			)
		}

		{
			theme === 'marketing' && (
				<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
					<path
						d="M 22 76 L 44 54 L 58 64 L 82 32"
						class="trend-line stroke-[#c70039]"
						stroke-width="1.6"
					/>
					<polyline points="72,32 82,32 82,42" class="stroke-[#c70039]" stroke-width="1.6" />
					<rect x="24" y="66" width="6" height="16" rx="1" class="opacity-25 fill-current stroke-none" />
					<rect x="38" y="54" width="6" height="28" rx="1" class="opacity-45 fill-current stroke-none" />
					<rect x="52" y="60" width="6" height="22" rx="1" class="opacity-35 fill-current stroke-none" />
					<rect x="66" y="42" width="6" height="40" rx="1" class="opacity-65 fill-current stroke-none" />
				</svg>
			)
		}

		{
			theme === 'tags' && (
				variant === 'stack' ? (
					<svg viewBox="0 0 120 40" class="h-full w-full fill-none stroke-current" stroke-width="1">
						<line x1="10" y1="20" x2="110" y2="20" stroke-dasharray="3 3" class="opacity-30" />
						<rect x="30" y="12" width="24" height="16" rx="3" class="stroke-current opacity-50" />
						<circle cx="36" cy="20" r="1.5" class="fill-[#c70039] stroke-none" />
						<rect x="65" y="10" width="28" height="20" rx="3" class="stroke-[#c70039] opacity-75" />
						<circle cx="72" cy="20" r="1.8" class="fill-[#c70039] stroke-none" />
					</svg>
				) : (
					<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
						<path
							d="M 30 34 L 58 34 L 80 56 L 62 74 L 40 52 L 30 52 Z"
							class="tag-shape transition-transform duration-500 group-hover:rotate-6"
						/>
						<circle cx="40" cy="43" r="2.5" class="fill-[#c70039] stroke-none" />
					</svg>
				)
			)
		}

		{
			theme === 'productivity' && (
				variant === 'stack' ? (
					<svg viewBox="0 0 120 40" class="h-full w-full fill-none stroke-current" stroke-width="1">
						<line x1="15" y1="20" x2="105" y2="20" class="opacity-30" />
						<line x1="15" y1="20" x2="70" y2="20" class="stroke-[#c70039] opacity-80" stroke-width="1.4" />
						<circle cx="25" cy="20" r="4" class="fill-[#0b0b0d] stroke-[#c70039]" stroke-width="1.2" />
						<circle cx="25" cy="20" r="1.5" class="fill-[#c70039] stroke-none" />
						<circle cx="65" cy="20" r="4" class="fill-[#0b0b0d] stroke-[#c70039]" stroke-width="1.2" />
						<circle cx="65" cy="20" r="1.5" class="fill-[#c70039] stroke-none" />
						<circle cx="100" cy="20" r="3.5" class="fill-[#0b0b0d] stroke-current opacity-40" />
					</svg>
				) : (
					<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
						<circle cx="50" cy="50" r="28" stroke-dasharray="180" stroke-dashoffset="35" class="stroke-[#c70039]" stroke-width="1.4" />
						<polyline points="38,51 47,60 65,41" class="check-mark stroke-current" stroke-width="1.8" />
					</svg>
				)
			)
		}

		{
			theme === 'rss' && (
				variant === 'stack' ? (
					<svg viewBox="0 0 120 40" class="h-full w-full fill-none stroke-current" stroke-width="1.2">
						<circle cx="25" cy="20" r="3" class="fill-[#c70039] stroke-none" />
						<path d="M 40 10 A 15 15 0 0 1 40 30" class="arc-1 stroke-current opacity-60" />
						<path d="M 55 5 A 25 25 0 0 1 55 35" class="arc-2 stroke-current opacity-80" />
						<path d="M 70 0 A 35 35 0 0 1 70 40" class="arc-3 stroke-[#c70039] opacity-90" stroke-width="1.5" />
						<line x1="75" y1="20" x2="105" y2="20" stroke-dasharray="2 3" class="opacity-35" />
					</svg>
				) : (
					<svg viewBox="0 0 100 100" class="h-full w-full fill-none stroke-current" stroke-width="1.1">
						<circle cx="28" cy="72" r="3.5" class="fill-[#c70039] stroke-none" />
						<path d="M 28 52 A 20 20 0 0 1 48 72" class="rss-arc arc-1 stroke-current" stroke-width="1.6" />
						<path d="M 28 34 A 38 38 0 0 1 66 72" class="rss-arc arc-2 stroke-current opacity-80" stroke-width="1.6" />
