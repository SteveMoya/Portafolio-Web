---
/**
 * Section heading shared by the top-level views. Pairs with PageHero so every
 * section in /skills, /experience, /education and /gallery opens the same way.
 */
interface Props {
	eyebrow: string
	title: string
	description?: string
	align?: 'left' | 'center'
	id?: string
	class?: string
}

const {
	eyebrow,
	title,
	description,
	align = 'left',
	id,
	class: className = '',
} = Astro.props

const centered = align === 'center'
---

<div
	id={id}
	class:list={[
		'mb-12 flex flex-col gap-4 sm:mb-16',
		centered && 'items-center text-center',
		className,
	]}
>
	<div class:list={['flex items-center gap-4', centered && 'justify-center']}>
		<span class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40">
			{eyebrow}
		</span>
		<span class="h-px max-w-[80px] flex-1 bg-white/20"></span>
	</div>

	<h2
		class="font-poppins text-3xl font-black uppercase leading-[0.95] tracking-tight text-white sm:text-4xl lg:text-5xl"
	>
		{title}
	</h2>

	{
		description && (
			<p
				class:list={[
					'max-w-xl text-sm leading-relaxed text-white/60 sm:text-base',
					centered && 'mx-auto',
				]}
			>
				{description}
			</p>
		)
	}
</div>
