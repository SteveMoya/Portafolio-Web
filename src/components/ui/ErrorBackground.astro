---
import { Icon } from 'astro-icon/components'

interface Item {
	icon: string
	x: number
	y: number
	size: number
	delay: number
	dur: number
}
interface Props {
	items: Item[]
	// RGB triplet of the accent color, e.g. "199,0,57"
	accent?: string
}
const { items, accent = '199,0,57' } = Astro.props
---

<canvas id="nf-bg" data-accent={accent} class="pointer-events-none absolute inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>
<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
	{items.map((f) => (
		<span class="nf-float absolute" style={`color:rgba(${accent},0.3);left:${f.x}%;top:${f.y}%;animation-delay:${f.delay}s;animation-duration:${f.dur}s`}>
			<Icon name={f.icon} style={`width:${f.size}rem;height:${f.size}rem`} />
		</span>
	))}
</div>

<style>
	.nf-float {
		animation: nf-drift 10s ease-in-out infinite;
	}
	:global(.nf-pulse) {
		animation: nf-pulse 2.4s ease-in-out infinite;
		filter: drop-shadow(0 0 14px rgba(var(--nf-accent, 199, 0, 57), 0.6));
	}
	@keyframes nf-drift {
		0%, 100% { transform: translate(0, 0) rotate(-6deg); }
		50% { transform: translate(14px, -26px) rotate(8deg); }
	}
	@keyframes nf-pulse {
		0%, 100% { transform: scale(1); opacity: 0.85; }
		50% { transform: scale(1.12); opacity: 1; }
	}
	@media (prefers-reduced-motion: reduce) {
		.nf-float, :global(.nf-pulse) { animation: none; }
	}
</style>

<script>
	const canvas = document.getElementById('nf-bg') as HTMLCanvasElement | null
	const ctx = canvas?.getContext('2d')
	if (canvas && ctx) {
		const accent = canvas.dataset.accent ?? '199,0,57'
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
		const GAP = 34
		let w = 0, h = 0, dpr = 1, raf = 0
		const mouse = { x: -9999, y: -9999 }

		const resize = () => {
			dpr = Math.min(devicePixelRatio || 1, 2)
			w = canvas.clientWidth
			h = canvas.clientHeight
			canvas.width = w * dpr
			canvas.height = h * dpr
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
		}

		const draw = (t: number) => {
			ctx.clearRect(0, 0, w, h)
			const time = t / 1000
			for (let x = GAP / 2; x < w; x += GAP) {
				for (let y = GAP / 2; y < h; y += GAP) {
					const wave = Math.sin(x * 0.012 + time * 1.2) + Math.cos(y * 0.014 - time * 0.9)
					const dx = x - mouse.x
					const dy = y - mouse.y
					const near = Math.max(0, 1 - Math.hypot(dx, dy) / 160)
					const r = 1.1 + (wave + 2) * 0.45 + near * 2.6
					const a = 0.1 + (wave + 2) * 0.06 + near * 0.6
					// Occasional "glitch" dots flicker in the error color
					const glitch = Math.sin(x * 12.9898 + y * 78.233 + Math.floor(time * 2)) > 0.985
					ctx.fillStyle = glitch || near > 0.05 ? `rgba(${accent},${Math.min(a + 0.2, 1)})` : `rgba(245,245,245,${a * 0.5})`
					ctx.beginPath()
					ctx.arc(x, y + wave * 3, r, 0, Math.PI * 2)
					ctx.fill()
				}
			}
			if (!reduced) raf = requestAnimationFrame(draw)
		}

		resize()
		addEventListener('resize', () => { resize(); if (reduced) draw(0) })
		addEventListener('pointermove', (e) => {
			const r = canvas.getBoundingClientRect()
			mouse.x = e.clientX - r.left
			mouse.y = e.clientY - r.top
		})
		document.addEventListener('visibilitychange', () => {
			if (reduced) return
			cancelAnimationFrame(raf)
			if (!document.hidden) raf = requestAnimationFrame(draw)
		})
		raf = requestAnimationFrame(draw)
	}
</script>