---
import { Icon } from 'astro-icon/components'

interface Props {
	title: string
	description: string
	href: string
	icon: string
	span?: 2 | 3 | 6
	featured?: boolean
	external?: boolean
}

const { title, description, href, icon, span = 2, featured = false, external = false } = Astro.props

const spanClass: Record<number, string> = {
	2: 'col-span-2',
	3: 'col-span-3',
	6: 'col-span-6'
}
---

{
	featured ? (
		<a
			href={href}
			target={external ? '_blank' : undefined}
			rel={external ? 'noopener' : undefined}
			class={`group flex items-center gap-3 rounded-xl p-3 transition-colors duration-200 hover:bg-white/[0.06] ${spanClass[span]}`}
		>
			<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#c70039]/10 text-[#c70039]">
				<Icon name={icon} class="h-5 w-5" />
			</span>
			<span class="flex-1">
				<span class="block text-sm font-semibold text-white">{title}</span>
				<span class="block text-xs text-white/40">{description}</span>
			</span>
			<Icon name="mdi:arrow-top-right" class="h-4 w-4 shrink-0 text-white/20 transition-colors duration-200 group-hover:text-white/50" />
		</a>
	) : (
		<a
			href={href}
			target={external ? '_blank' : undefined}
			rel={external ? 'noopener' : undefined}
			class={`group flex flex-col gap-1.5 rounded-xl p-3 transition-colors duration-200 hover:bg-white/[0.06] ${spanClass[span]}`}
		>
			<span class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/5 text-white/50 transition-colors duration-200 group-hover:bg-[#c70039]/10 group-hover:text-[#c70039]">
				<Icon name={icon} class="h-4 w-4" />
			</span>
			<span class="text-sm font-semibold text-white">{title}</span>
			<span class="text-xs text-white/40">{description}</span>
		</a>
	)
}
