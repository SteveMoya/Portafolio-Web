---
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'
import CleanFilmGrid from '@/components/sections/gallery/CleanFilmGrid'
import PageHero from '@/components/ui/PageHero.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import SectionRail from '@/components/ui/SectionRail.astro'
import ScrollReveals from '@/components/ui/ScrollReveals.astro'
import CountUp from '@/components/ui/CountUp.astro'
import FormattedDate from '@/components/ui/FormattedDate.astro'
import { getPosts } from '@src/utils'
import { principles } from '@/data/capabilities'

// Get images from Cloudinary collections
const fotografiaImages = await getCollection('fotografia')
const disenoImages = await getCollection('diseno')

// Combine and sort by date (newest first)
const allImages = [...fotografiaImages, ...disenoImages].sort((a, b) => {
	return new Date(b.data.uploaded_at || 0).getTime() - new Date(a.data.uploaded_at || 0).getTime()
})

// Transform for CleanFilmGrid component - map collection names to categories
const galleryImages = allImages.map((image) => ({
	id: image.id,
	src: image.data.secure_url,
	alt: image.data.display_name || 'Imagen de la galería',
	category: image.collection
}))

const pageTitle = 'Galería'
const pageDescription =
	'Archivo visual de fotografía y diseño: imágenes documentales, composiciones y piezas gráficas.'

// Archive counters, reused by the hero meta rail and the stats cards.
const stats = [
	{ value: allImages.length, label: 'Obras totales' },
	{ value: fotografiaImages.length, label: 'Fotografías' },
	{ value: disenoImages.length, label: 'Piezas de diseño' }
]

const heroMeta = stats.map((stat) => `${stat.value} ${stat.label.toLowerCase()}`)

// Names already curated inside the archive. The Cloudinary loader only exposes
// `display_name` for some accounts, so the fallback string is skipped and the
// folders that actually returned assets are used instead — both come straight
// from the collection data, nothing is invented.
const GENERIC_ALT = 'Imagen de la galería'
const COLLECTION_LABELS: Record<string, string> = {
	fotografia: 'Fotografía',
	diseno: 'Diseño'
}

const collectionNames = Array.from(
	new Set([
		...galleryImages
			.map((image) => image.alt.trim())
			.filter((name) => name && name !== GENERIC_ALT),
		...Array.from(new Set(galleryImages.map((image) => image.category))).map(
			(category) => COLLECTION_LABELS[category] ?? category
		)
	])
).slice(0, 20)

// The strip is decorative: a short list is repeated so one half still fills the
// row, and the loop stays seamless because both halves are identical.
const marqueeNames = Array.from(
	{ length: Math.max(1, Math.ceil(8 / Math.max(1, collectionNames.length))) },
	() => collectionNames
).flat()

// Longer strips travel slower so the perceived speed stays constant.
const marqueeDuration = Math.max(30, marqueeNames.length * 3.5)

// Newest published story, reused by the editorial feature block.
const [featuredPost] = await getPosts(1)

// In-page index: the story block only exists when the blog returned a post.
const railSections = (
	[
		{ id: 'archivo', label: 'Archivo' },
		{ id: 'proceso', label: 'Proceso' },
		{ id: 'numeros', label: 'Números' },
		...(featuredPost ? [{ id: 'historia', label: 'Historia' }] : [])
	] as { id: string; label: string }[]
).map((section, index) => ({ ...section, index: String(index + 1).padStart(2, '0') }))
---

<Layout title={pageTitle} description={pageDescription}>
	<!-- Reading progress: 2px, scroll-driven, no JS. -->
	<div class="scroll-progress" aria-hidden="true"></div>

	<!-- Arms the `[data-reveal]` elements of this page and counts the stats. -->
	<ScrollReveals />
	<CountUp />

	<!-- Layout.astro already renders the page <main>; nesting another one is
	     invalid HTML and breaks the landmark structure for screen readers. -->
	<div class="min-h-screen bg-[#0a0a0a]">
		<PageHero
			eyebrow="Archivo visual"
			lines={['Visual', 'Archive']}
			accentIndex={1}
			align="center"
			background="pattern"
			motion="scroll"
			subtitle="Un archivo abierto de fotografía y diseño: imagen documental, composición y experimentación gráfica, ordenados del trabajo más reciente al más antiguo."
			meta={heroMeta}
		/>

		<!-- In-page index, shared with the other top-level views. -->
		<SectionRail sections={railSections} label="Secciones del archivo visual" />

		<!-- Gallery heading -->
		<div id="archivo" class="mx-auto max-w-7xl scroll-mt-28 px-6 pt-20 sm:px-10 lg:px-16 lg:pt-24">
			<SectionHeading
				scrub
				eyebrow="Selección"
				title="Momentos seleccionados"
				description="Filtrá por colección o cambiá la vista para recorrer el archivo completo."
			/>
		</div>

		<!-- Gallery Grid Component -->
		{
			galleryImages.length > 0 ? (
				<CleanFilmGrid client:visible images={galleryImages} />
			) : (
				<div class="mx-auto flex min-h-[50vh] max-w-7xl items-center justify-center px-6 py-20 sm:px-10 lg:px-16">
					<div class="dotted-card relative w-full max-w-xl rounded-2xl border border-white/10 p-10 text-center sm:p-12">
						<span class="corner-tick corner-tick--tl" aria-hidden="true" />
						<span class="corner-tick corner-tick--br" aria-hidden="true" />
						<p class="text-sm leading-relaxed text-white/60">
							Todavía no hay imágenes publicadas en el archivo. Volvé pronto para ver las novedades.
						</p>
					</div>
				</div>
			)
		}

		<!-- Collection marquee: a slim index of what the archive holds -->
		{
			marqueeNames.length > 0 && (
				<section
					class="relative border-y border-white/10 bg-[#0a0a0a] py-7"
					aria-labelledby="colecciones-archivo"
				>
					<h2 id="colecciones-archivo" class="sr-only">
						Colecciones presentes en el archivo
					</h2>

					{/* Decorative ticker: the heading above carries the information
					    for assistive tech, so the repeated names stay hidden. */}
					<div class="marquee" style={`--marquee-duration: ${marqueeDuration}s`} aria-hidden="true">
						<div class="marquee-track">
							{[0, 1].map(() => (
								<ul class="flex shrink-0 items-center">
									{marqueeNames.map((name) => (
										<li class="flex shrink-0 items-center gap-6 px-6">
											<span class="text-[11px] font-bold uppercase tracking-[0.3em] text-white/25 transition-colors duration-300 hover:text-white/50">
												{name}
											</span>
											<span class="h-1 w-1 rounded-full bg-[#c70039]" aria-hidden="true" />
										</li>
									))}
								</ul>
							))}
						</div>
					</div>
				</section>
			)
		}

		<!-- Process: the four principles, in the same order used site-wide -->
		<section
			id="proceso"
			class="relative scroll-mt-28 bg-[#0a0a0a] px-6 py-20 sm:px-10 lg:px-16 lg:py-24"
			aria-label="El proceso"
		>
			<div class="mx-auto max-w-7xl">
				<SectionHeading
					scrub
					eyebrow="Método"
					title="El proceso"
					description="Cuatro reglas que se repiten en cada pieza del archivo, del primer boceto a la entrega final."
				/>

				<ol class="border-t border-white/10">
					{
						principles.map((principle, index) => (
							<li
								data-reveal
								style={`--i:${index}`}
								class="io-reveal border-b border-white/10"
							>
								<div class="group relative grid grid-cols-1 items-start gap-4 px-1 py-8 transition-colors duration-200 hover:bg-white/[0.02] sm:grid-cols-[auto_1fr] sm:gap-8 md:grid-cols-[140px_minmax(0,1fr)_minmax(0,1.1fr)] md:gap-12 md:px-4 md:py-10">
									{/* Accent rule that grows on hover, instead of scaling a
									    full-width row. */}
									<span
										class="absolute left-0 top-0 h-full w-px origin-top scale-y-0 bg-[#c70039] transition-transform duration-300 ease-out group-hover:scale-y-100"
										aria-hidden="true"
									/>

									<span
										class="font-poppins text-5xl font-black leading-none text-white/10 transition-colors duration-200 group-hover:text-[#c70039]/60"
										aria-hidden="true"
									>
										{principle.number}
									</span>

									<h3 class="font-poppins text-xl font-black uppercase leading-tight tracking-tight text-white sm:text-2xl">
										{principle.title}
									</h3>

									<p class="max-w-lg text-sm leading-relaxed text-white/60">
										{principle.description}
									</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- Stats Section -->
		<section
			id="numeros"
			class="relative scroll-mt-28 border-t border-white/10 bg-[#0a0a0a] px-6 py-20 sm:px-10 lg:px-16 lg:py-24"
		>
			<div class="mx-auto max-w-7xl">
				<SectionHeading scrub eyebrow="Archivo en números" title="El volumen del trabajo" />

				<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
					{
						stats.map((stat, index) => (
							<div
								data-reveal
								style={`--i:${index}`}
								class="io-reveal dotted-card hover-lift group relative rounded-2xl border border-white/10 p-8 text-center transition-colors duration-200 hover:border-[#c70039]/40"
							>
								<span class="corner-tick corner-tick--tl" aria-hidden="true" />
								<span class="corner-tick corner-tick--br" aria-hidden="true" />
								<p
									data-count-to={stat.value}
									data-count-pad="2"
									class="font-poppins text-4xl font-black tabular-nums text-white"
								>
									{String(stat.value).padStart(2, '0')}
								</p>
								<p class="mt-3 text-[10px] font-bold uppercase tracking-[0.3em] text-white/40">
									{stat.label}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Featured story: the newest published article -->
		{
			featuredPost && (
				<section
					id="historia"
					class="relative scroll-mt-28 border-t border-white/10 bg-[#0a0a0a] px-6 py-20 sm:px-10 lg:px-16 lg:py-24"
					aria-labelledby="ultima-historia"
				>
					<div class="mx-auto max-w-7xl">
						<div class="mb-10 flex items-center gap-4">
							<span
								id="ultima-historia"
								class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40"
							>
								Última historia
							</span>
							<span class="h-px max-w-[120px] flex-1 bg-white/20" />
						</div>

						<a
							href={`/blog/${featuredPost.id}/`}
							data-reveal
							style="--i:0"
							class="io-reveal dotted-card hover-lift group relative block rounded-2xl border border-white/10 p-8 transition-colors duration-200 hover:border-[#c70039]/40 sm:p-10 lg:p-14"
						>
							<span class="corner-tick corner-tick--tl" aria-hidden="true" />
							<span class="corner-tick corner-tick--br" aria-hidden="true" />

							<div class="flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] uppercase tracking-[0.3em] text-white/40">
								<span class="text-[#c70039]">{featuredPost.data.category}</span>
								<span class="h-px w-6 bg-white/20" aria-hidden="true" />
								<FormattedDate date={featuredPost.data.pubDate} />
							</div>

							<h3 class="mt-6 max-w-3xl font-poppins text-2xl font-black uppercase leading-[0.98] tracking-tight text-white transition-colors duration-300 group-hover:text-[#c70039] sm:text-3xl lg:text-4xl">
								{featuredPost.data.title}
							</h3>

							<p class="mt-5 max-w-2xl text-sm leading-relaxed text-white/60 sm:text-base">
								{featuredPost.data.description}
							</p>

							<span class="mt-10 inline-flex items-center gap-3 text-xs font-black uppercase tracking-widest text-white">
								Leer la historia
								<svg
									class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M7 17L17 7M17 7H8M17 7V16" />
								</svg>
							</span>
						</a>

						<div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
							<p class="text-sm leading-relaxed text-white/60">
								Todo el archivo escrito, ordenado del más reciente al más antiguo.
							</p>

							<a
								href="/blog/todos-los-blogs/1"
								class="group inline-flex items-center gap-3 text-xs font-black uppercase tracking-widest text-white/60 transition-colors duration-300 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0a]"
							>
								Todas las historias
								<svg
									class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M5 12h14M13 5l7 7-7 7" />
								</svg>
							</a>
						</div>
					</div>
				</section>
			)
		}

		<!-- Closing CTA -->
		<section
			class="relative overflow-hidden border-t border-white/10 bg-[#0a0a0a] px-6 py-24 sm:px-10 lg:px-16 lg:py-28"
		>
			<!-- Ambient accent wash, same visual language as the closing CTA on the home page -->
			<div
				class="pointer-events-none absolute inset-0 z-0"
				aria-hidden="true"
				style="background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(199,0,57,0.10), transparent 65%);"
			>
			</div>

			<div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center gap-6 text-center">
				<p class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40">Siguiente paso</p>

				<h2
					class="font-poppins text-4xl font-black uppercase leading-[0.95] tracking-tight text-white sm:text-5xl lg:text-6xl"
				>
					Construyamos la <span class="text-[#c70039]">próxima imagen</span>
				</h2>

				<p class="max-w-md text-sm leading-relaxed text-white/60 sm:text-base">
					¿Te interesa una sesión, una pieza gráfica o el archivo completo? Contame qué necesitás y
					lo vemos juntos.
				</p>

				<div class="mt-2 flex flex-col items-center gap-4 sm:flex-row">
					<a
						href="/contact"
						class="inline-flex items-center gap-3 rounded-full bg-[#c70039] px-8 py-4 text-sm font-black uppercase tracking-widest text-white transition duration-200 hover:scale-105 hover:shadow-[0_0_40px_rgba(199,0,57,0.35)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0a]"
					>
						Hablemos
						<svg
							class="h-4 w-4"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M7 17L17 7M17 7H8M17 7V16"></path>
						</svg>
					</a>

					<a
						href="/about"
						class="inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/5 px-8 py-4 text-sm font-black uppercase tracking-widest text-white/80 transition duration-200 hover:border-[#c70039]/50 hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0a]"
					>
						Sobre mí
					</a>
				</div>
			</div>
		</section>
	</div>

	<style>
		:global(html) {
			scroll-behavior: smooth;
		}

		@media (prefers-reduced-motion: reduce) {
			:global(html) {
				scroll-behavior: auto;
			}
		}
	</style>
</Layout>
