---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CleanFilmGrid from '@/components/sections/gallery/CleanFilmGrid';

// Get images from Cloudinary collections
const fotografiaImages = await getCollection('fotografia');
const disenoImages = await getCollection('diseno');

// Combine and sort by date (newest first)
const allImages = [...fotografiaImages, ...disenoImages].sort((a, b) => {
	return new Date(b.data.uploaded_at || 0).getTime() - new Date(a.data.uploaded_at || 0).getTime();
});

// Transform for CleanFilmGrid component
const galleryImages = allImages.map((image) => ({
	id: image.id,
	src: `https://res.cloudinary.com/${import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME}/image/fetch/q_auto,f_auto/${image.id}`,
	alt: image.data.display_name || 'Gallery Image',
	category: image.data.tags?.[0] || undefined,
}));

const pageTitle = 'Gallery';
const pageDescription = 'My photography and design work';
---

<Layout title={pageTitle} description={pageDescription}>
	<main class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 py-20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<!-- Header -->
			<div class="mb-16 text-center">
				<h1
					class="text-5xl md:text-6xl font-bold text-white mb-4 tracking-tight"
				>
					Gallery
				</h1>
				<p class="text-xl text-slate-300 max-w-2xl mx-auto">
					A collection of my photography and design projects
				</p>
			</div>

			{
				galleryImages.length > 0 ? (
					<>
						{/* CleanFilmGrid Component */}
						<CleanFilmGrid client:load images={galleryImages} columns={3} />

						<!-- Stats -->
						<div class="mt-16 grid grid-cols-2 md:grid-cols-3 gap-4 text-center">
							<div class="bg-gradient-to-br from-blue-500/10 to-purple-500/10 border border-slate-700 rounded-lg p-6">
								<p class="text-3xl font-bold text-white mb-2">
									{allImages.length}
								</p>
								<p class="text-slate-400 text-sm">Total Images</p>
							</div>
							<div class="bg-gradient-to-br from-blue-500/10 to-purple-500/10 border border-slate-700 rounded-lg p-6">
								<p class="text-3xl font-bold text-white mb-2">
									{disenoImages.length}
								</p>
								<p class="text-slate-400 text-sm">Design Works</p>
							</div>
							<div class="bg-gradient-to-br from-blue-500/10 to-purple-500/10 border border-slate-700 rounded-lg p-6">
								<p class="text-3xl font-bold text-white mb-2">
									{fotografiaImages.length}
								</p>
								<p class="text-slate-400 text-sm">Photography</p>
							</div>
						</div>
					</>
				) : (
					<div class="text-center py-20">
						<p class="text-slate-400 text-lg">
							No images available at the moment
						</p>
					</div>
				)
			}
		</div>
	</main>
</Layout>
