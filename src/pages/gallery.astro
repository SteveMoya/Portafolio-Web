---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CleanFilmGrid from '@/components/sections/gallery/CleanFilmGrid';

// Get images from Cloudinary collections
const fotografiaImages = await getCollection('fotografia');
const disenoImages = await getCollection('diseno');

// Combine and sort by date (newest first)
const allImages = [...fotografiaImages, ...disenoImages].sort((a, b) => {
	return new Date(b.data.uploaded_at || 0).getTime() - new Date(a.data.uploaded_at || 0).getTime();
});

// Transform for CleanFilmGrid component - map collection names to categories
const galleryImages = allImages.map((image) => ({
	id: image.id,
	src: `https://res.cloudinary.com/${import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME}/image/fetch/q_auto,f_auto/${image.id}`,
	alt: image.data.display_name || 'Gallery Image',
	category: image.collection === 'fotografia' ? 'fotografia' : 'diseno',
}));

const pageTitle = 'Gallery';
const pageDescription = 'My photography and design work';
---

<Layout title={pageTitle} description={pageDescription}>
	<main class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
		<!-- Hero Section with Parallax -->
		<section class="relative h-[150vh] text-white overflow-hidden">
			<div class="sticky top-0 h-screen overflow-hidden flex flex-col items-center justify-center bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
				<div class="relative z-10 px-4 md:px-12 max-w-7xl mx-auto text-center">
					<!-- Hero Content -->
					<div class="flex flex-col gap-6 md:gap-8">
						<div class="overflow-hidden">
							<h1 class="text-6xl md:text-8xl font-black tracking-tighter uppercase leading-[0.9] text-white">
								<span class="font-serif italic font-light opacity-70 text-slate-300">Visual</span> Archive
							</h1>
						</div>

						<div class="flex items-center justify-center gap-8 overflow-hidden">
							<div class="h-px bg-slate-400/30 w-32" />
							<p class="font-mono text-xs md:text-sm uppercase tracking-widest text-slate-400">
								Photography & Design
							</p>
							<div class="h-px bg-slate-400/30 w-32" />
						</div>

						<div class="overflow-hidden">
							<h2 class="text-4xl md:text-7xl font-black tracking-tighter uppercase leading-[0.9] text-white">
								Selected <span class="font-serif italic font-light text-sky-300">Moments.</span>
							</h2>
						</div>
					</div>

					<div class="mt-6 md:mt-10 max-w-2xl mx-auto">
						<p class="text-lg md:text-xl font-light text-slate-300 leading-relaxed">
							A curated collection of photography and design work that captures the intersection of technical precision and creative vision.
						</p>
					</div>
				</div>

				<!-- Scroll Prompt -->
				<div class="absolute bottom-12 flex flex-col items-center gap-4 z-10 animate-bounce">
					<span class="text-[10px] font-mono uppercase tracking-widest text-slate-400">See More</span>
					<svg class="w-5 h-5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
					</svg>
				</div>
			</div>
		</section>

		<!-- Gallery Grid Component -->
		{
			galleryImages.length > 0 ? (
				<CleanFilmGrid client:load images={galleryImages} />
			) : (
				<div class="min-h-screen flex items-center justify-center">
					<div class="text-center py-20">
						<p class="text-slate-400 text-lg font-mono">
							No images available at the moment
						</p>
					</div>
				</div>
			)
		}

		<!-- Stats Section -->
		<section class="relative py-24 px-6 md:px-16 lg:px-24 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 border-t border-slate-700">
			<div class="max-w-7xl mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<div class="bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-700 rounded-lg p-8 text-center group hover:border-sky-500/50 transition-all duration-300">
						<p class="text-4xl md:text-5xl font-bold text-white mb-3 group-hover:text-sky-400 transition-colors">
							{allImages.length}
						</p>
						<p class="text-slate-400 text-sm font-mono uppercase tracking-widest">
							Total Works
						</p>
					</div>
					<div class="bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-700 rounded-lg p-8 text-center group hover:border-sky-500/50 transition-all duration-300">
						<p class="text-4xl md:text-5xl font-bold text-white mb-3 group-hover:text-sky-400 transition-colors">
							{disenoImages.length}
						</p>
						<p class="text-slate-400 text-sm font-mono uppercase tracking-widest">
							Design Pieces
						</p>
					</div>
					<div class="bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-700 rounded-lg p-8 text-center group hover:border-sky-500/50 transition-all duration-300">
						<p class="text-4xl md:text-5xl font-bold text-white mb-3 group-hover:text-sky-400 transition-colors">
							{fotografiaImages.length}
						</p>
						<p class="text-slate-400 text-sm font-mono uppercase tracking-widest">
							Photographs
						</p>
					</div>
				</div>
			</div>
		</section>
	</main>

	<style>
		:global(html) {
			scroll-behavior: smooth;
		}
	</style>
</Layout>
