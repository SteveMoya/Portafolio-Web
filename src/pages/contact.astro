---
import { siteConfig } from '@src/data/config'
import Layout from '@src/layouts/Layout.astro'
import Header from '@components/Header.astro'
import Input from '@components/ui/Input.astro'
import Button from '@components/ui/Button.astro'
import { Icon } from 'astro-icon/components'
import socialLinks from '@src/data/socialLinks.json'

const { author } = siteConfig

const connectLinks = socialLinks.links.filter((link) => link.url.startsWith('http') || link.url.startsWith('mailto'))

const faqs = [
	{
		question: '¿Qué servicios ofrecés?',
		answer:
			'Desarrollo web (front y back), marketing digital, SEO y análisis de datos. Puedo encargarme de un proyecto completo o sumarme a un equipo que ya tiene algo en marcha.'
	},
	{
		question: '¿Con qué tecnologías trabajás?',
		answer:
			'Principalmente JavaScript/TypeScript, Astro, React y Node.js, además de WordPress para proyectos que lo requieren. También manejo SEO técnico, Google Analytics/Ads y Cloudflare.'
	},
	{
		question: '¿Cómo es tu proceso de trabajo?',
		answer:
			'Arrancamos con una charla para entender el objetivo y el alcance, sigo con una propuesta y estimación de tiempos, y avanzo en etapas cortas con entregas visibles para que puedas ir revisando el progreso.'
	},
	{
		question: '¿Cuánto tiempo toma un proyecto?',
		answer:
			'Depende del alcance: una landing puede estar lista en una o dos semanas, mientras que un producto más completo puede tomar varios meses. Te doy un estimado concreto apenas conozco los detalles.'
	},
	{
		question: '¿Trabajás con clientes de otros países?',
		answer:
			'Sí, trabajo de forma remota con clientes de cualquier zona horaria. Coordinamos las reuniones y entregas por videollamada, email o la herramienta que prefieras.'
	},
	{
		question: '¿Cómo me pongo en contacto?',
		answer: 'Lo más directo es el formulario de acá arriba, o escribirme por cualquiera de mis redes sociales. Te respondo a la brevedad.'
	}
]
---

<Layout title={`${author} | Contacto`} description="Hablemos de tu próximo proyecto. Escribime por redes o completá el formulario y te respondo a la brevedad.">
	<Header
		title="Hablemos"
		titleCaption="de tu proyecto"
		description="¿Tenés una idea en mente? Contame los detalles y"
		descriptionCaption="lo llevamos adelante juntos."
	/>

	{/* Main Contact Section - Split Layout */}
	<section class="relative w-full bg-[#0a0a0a] px-6 pb-24 sm:px-10 lg:px-16">
		<div class="mx-auto max-w-7xl">
			<div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">
				{/* Left Column - 3D Element */}
				<div class="flex items-center justify-center lg:sticky lg:top-24 lg:h-fit">
					<div id="canvas-container" class="h-full w-full"></div>
				</div>

				{/* Right Column - Form & Social */}
				<div class="flex flex-col gap-12">
					{/* Social Networks - Top */}
					<div class="social-section">
						<div class="mb-8">
							<p class="mb-2 text-xs font-bold uppercase tracking-[0.3em] text-white/40">Conecta conmigo</p>
							<h3 class="text-xl font-bold text-white">Encontrame en</h3>
						</div>

						{/* Carousel Container */}
						<div class="relative">
							<div class="overflow-hidden rounded-xl">
								<div id="social-carousel" class="flex transition-transform duration-500 ease-out">
									{
										connectLinks.map((link) => (
											<div class="w-full flex-shrink-0">
												<a
													href={link.url}
													target={link.url.startsWith('http') ? '_blank' : '_self'}
													rel={link.url.startsWith('http') ? 'noopener noreferrer' : ''}
													aria-label={`${link.title}${link.handle ? ` — ${link.handle}` : ''}`}
													class="group flex flex-col items-center gap-4 rounded-xl border border-white/10 bg-gradient-to-br from-white/8 to-white/3 p-6 backdrop-blur-sm transition-all duration-300 hover:border-[#c70039]/40 hover:shadow-[0_12px_40px_rgba(199,0,57,0.15)] sm:p-8"
												>
													<div class="flex h-16 w-16 items-center justify-center rounded-lg bg-white/10 text-3xl transition-all duration-300 group-hover:scale-110 group-hover:bg-[#c70039]/20">
														<Icon name={link.icon} class="h-8 w-8 text-[#c70039]" />
													</div>
													<div class="text-center">
														<h4 class="text-lg font-bold text-white">{link.title}</h4>
														{link.handle && <p class="mt-1 text-sm text-white/60">{link.handle}</p>}
													</div>
													<div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.15em] text-white/40 transition-colors duration-300 group-hover:text-[#c70039]">
														<span>Conectar</span>
														<Icon name="mdi:arrow-top-right" class="h-4 w-4" />
													</div>
												</a>
											</div>
										))
									}
								</div>
							</div>

							{/* Carousel Controls */}
							<div class="mt-4 flex items-center justify-center gap-2">
								<button id="carousel-prev" aria-label="Anterior" class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-white/40 transition-all hover:border-[#c70039]/40 hover:text-[#c70039]">
									<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
									</svg>
								</button>

								<div id="carousel-dots" class="flex gap-2">
									{
										connectLinks.map((_, index) => (
											<button
												data-index={index}
												aria-label={`Ir a red ${index + 1}`}
												class={`h-2 w-2 rounded-full transition-all duration-300 ${
													index === 0 ? 'w-8 bg-[#c70039]' : 'bg-white/20 hover:bg-white/40'
												}`}
											/>
										))
									}
								</div>

								<button id="carousel-next" aria-label="Siguiente" class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-white/40 transition-all hover:border-[#c70039]/40 hover:text-[#c70039]">
									<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
									</svg>
								</button>
							</div>
						</div>
					</div>

					{/* Contact Form - Middle */}
					<div class="contact-section">
						<div class="mb-6">
							<h3 class="text-xl font-bold text-white">Escribime un mensaje</h3>
							<p class="mt-1 text-sm text-white/60">Te respondo a la brevedad</p>
						</div>

						<form id="contact-form" novalidate class="space-y-4">
							<div class="grid gap-4 sm:grid-cols-2">
								<div>
									<label for="nombre" class="mb-2 block text-xs font-bold uppercase tracking-[0.15em] text-white/50">Nombre</label>
									<Input id="nombre" name="nombre" type="text" required placeholder="Tu nombre" class="m-0 w-full" />
									<p data-error-for="nombre" class="mt-1.5 hidden text-xs font-semibold text-[#c70039]">Ingresá tu nombre.</p>
								</div>

								<div>
									<label for="email" class="mb-2 block text-xs font-bold uppercase tracking-[0.15em] text-white/50">Email</label>
									<Input id="email" name="email" type="email" required placeholder="tu@email.com" class="m-0 w-full" />
									<p data-error-for="email" class="mt-1.5 hidden text-xs font-semibold text-[#c70039]">Ingresá un email válido.</p>
								</div>
							</div>

							<div>
								<label for="asunto" class="mb-2 block text-xs font-bold uppercase tracking-[0.15em] text-white/50">Asunto</label>
								<Input id="asunto" name="asunto" type="text" required placeholder="¿De qué se trata?" class="m-0 w-full" />
								<p data-error-for="asunto" class="mt-1.5 hidden text-xs font-semibold text-[#c70039]">Contame el asunto.</p>
							</div>

							<div>
								<label for="descripcion" class="mb-2 block text-xs font-bold uppercase tracking-[0.15em] text-white/50">Descripción</label>
								<Input id="descripcion" name="descripcion" type="textarea" required placeholder="Contame más sobre tu proyecto" class="m-0 w-full" />
								<p data-error-for="descripcion" class="mt-1.5 hidden text-xs font-semibold text-[#c70039]">Contame un poco más.</p>
							</div>

							<div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between pt-2">
								<div class="group relative">
									<Button type="submit" variant="primary" text="Enviar mensaje" class="m-0 cursor-not-allowed opacity-50" disabled />
									<div class="absolute bottom-full left-0 mb-2 hidden whitespace-nowrap rounded-lg bg-white/10 px-3 py-2 text-xs text-white/60 backdrop-blur-sm group-hover:block">
										Funcionalidad en desarrollo
									</div>
								</div>
								<p id="form-status" class="hidden text-sm font-semibold" role="status"></p>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</section>

	{/* FAQ Section - Full Width */}
	<section class="relative w-full bg-gradient-to-b from-[#0a0a0a] to-[#050505] px-6 py-24 sm:px-10 lg:px-16">
		<div class="mx-auto max-w-4xl">
			<div class="mb-12 text-center">
				<p class="mb-2 text-xs font-bold uppercase tracking-[0.3em] text-white/40">Dudas frecuentes</p>
				<h2 class="text-3xl font-bold text-white sm:text-4xl">Preguntas que suelen surgir</h2>
			</div>

			<div class="space-y-3">
				{
					faqs.map((faq, index) => (
						<details
							class="group rounded-xl border border-white/10 bg-white/5 backdrop-blur-sm transition-all duration-300 open:border-[#c70039]/30 open:bg-white/8"
							style={`animation-delay: ${index * 0.05}s`}
						>
							<summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-4 text-base font-semibold text-white select-none hover:text-[#c70039] transition-colors duration-300">
								<span>{faq.question}</span>
								<svg
									class="mt-0.5 h-5 w-5 shrink-0 text-white/40 transition-all duration-300 group-open:rotate-180 group-open:text-[#c70039]"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
								</svg>
							</summary>
							<div class="border-t border-white/10 px-5 pb-4 pt-4">
								<p class="text-sm leading-relaxed text-white/70">{faq.answer}</p>
							</div>
						</details>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	@keyframes fade-in-up {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.social-section,
	.contact-section {
		animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	details[open] {
		animation: fade-in-up 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	#canvas-container {
		min-height: 400px;
	}

	@media (min-width: 1024px) {
		#canvas-container {
			min-height: 600px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.social-section,
		.contact-section,
		details[open] {
			animation: none;
		}
	}
</style>

<script>
	// Contact Form Functionality
	const CONTACT_EMAIL = 'contacto@stevemoya.com'
	const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

	const form = document.getElementById('contact-form') as HTMLFormElement | null
	const status = document.getElementById('form-status') as HTMLParagraphElement | null

	const setError = (field: string, show: boolean) => {
		const el = form?.querySelector<HTMLElement>(`[data-error-for="${field}"]`)
		el?.classList.toggle('hidden', !show)
	}

	const showStatus = (message: string, tone: 'success' | 'error') => {
		if (!status) return
		status.textContent = message
		status.classList.remove('hidden', 'text-[#c70039]', 'text-emerald-400')
		status.classList.add(tone === 'success' ? 'text-emerald-400' : 'text-[#c70039]')
	}

	form?.addEventListener('submit', (event) => {
		event.preventDefault()

		const data = new FormData(form)
		const nombre = String(data.get('nombre') || '').trim()
		const email = String(data.get('email') || '').trim()
		const asunto = String(data.get('asunto') || '').trim()
		const descripcion = String(data.get('descripcion') || '').trim()

		const nombreValid = nombre.length > 0
		const emailValid = EMAIL_RE.test(email)
		const asuntoValid = asunto.length > 0
		const descripcionValid = descripcion.length > 0

		setError('nombre', !nombreValid)
		setError('email', !emailValid)
		setError('asunto', !asuntoValid)
		setError('descripcion', !descripcionValid)

		if (!nombreValid || !emailValid || !asuntoValid || !descripcionValid) {
			showStatus('Revisá los campos marcados antes de continuar.', 'error')
			return
		}

		const body = `${nombre}\n${email}\n\n${descripcion}`
		const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(body)}`
		window.location.href = mailto

		showStatus('Se abrió tu cliente de correo con el mensaje listo para enviar.', 'success')
	})

	// Carousel Logic
	const carousel = document.getElementById('social-carousel')
	const prevBtn = document.getElementById('carousel-prev')
	const nextBtn = document.getElementById('carousel-next')
	const dots = document.querySelectorAll('#carousel-dots button')

	if (carousel && prevBtn && nextBtn) {
		let currentIndex = 0
		const totalCards = dots.length
		let autoPlayTimeout: ReturnType<typeof setTimeout>

		const goToSlide = (index: number) => {
			currentIndex = (index + totalCards) % totalCards
			const offset = -currentIndex * 100
			carousel.style.transform = `translateX(${offset}%)`

			dots.forEach((dot, i) => {
				if (i === currentIndex) {
					dot.classList.add('w-8', 'bg-[#c70039]')
					dot.classList.remove('bg-white/20', 'hover:bg-white/40')
				} else {
					dot.classList.remove('w-8', 'bg-[#c70039]')
					dot.classList.add('bg-white/20', 'hover:bg-white/40')
				}
			})

			clearTimeout(autoPlayTimeout)
			autoPlayTimeout = setTimeout(() => nextSlide(), 5000)
		}

		const nextSlide = () => goToSlide(currentIndex + 1)
		const prevSlide = () => goToSlide(currentIndex - 1)

		nextBtn.addEventListener('click', nextSlide)
		prevBtn.addEventListener('click', prevSlide)

		dots.forEach((dot, index) => {
			dot.addEventListener('click', () => goToSlide(index))
		})

		// Auto-play
		autoPlayTimeout = setTimeout(() => nextSlide(), 5000)

		// Cleanup
		window.addEventListener('beforeunload', () => clearTimeout(autoPlayTimeout))
	}

	// 3D Canvas - Data Flow Visualization
	const canvasContainer = document.getElementById('canvas-container')
	if (canvasContainer) {
		const canvas = document.createElement('canvas')
		canvasContainer.appendChild(canvas)

		const ctx = canvas.getContext('2d')
		if (!ctx) throw new Error('Could not get canvas context')

		let animationId: number

		const resizeCanvas = () => {
			canvas.width = canvasContainer.clientWidth * window.devicePixelRatio
			canvas.height = canvasContainer.clientHeight * window.devicePixelRatio
			ctx.scale(window.devicePixelRatio, window.devicePixelRatio)
		}

		resizeCanvas()
		window.addEventListener('resize', resizeCanvas)

		// Data node network
		class DataNode {
			x: number
			y: number
			vx: number
			vy: number
			radius: number
			label: string
			dataFlow: number = 0
			isActive: boolean = false

			constructor(x: number, y: number, label: string) {
				this.x = x
				this.y = y
				this.vx = (Math.random() - 0.5) * 0.5
				this.vy = (Math.random() - 0.5) * 0.5
				this.radius = Math.random() * 3 + 2
				this.label = label
			}

			update(width: number, height: number, mouseX: number, mouseY: number) {
				this.x += this.vx
				this.y += this.vy
				this.dataFlow += 0.02

				// Bounce off walls
				if (this.x - this.radius < 0 || this.x + this.radius > width) this.vx *= -1
				if (this.y - this.radius < 0 || this.y + this.radius > height) this.vy *= -1

				this.x = Math.max(this.radius, Math.min(width - this.radius, this.x))
				this.y = Math.max(this.radius, Math.min(height - this.radius, this.y))

				// Attraction to mouse
				const dx = mouseX - this.x
				const dy = mouseY - this.y
				const dist = Math.sqrt(dx * dx + dy * dy)
				this.isActive = dist < 100

				if (this.isActive) {
					this.vx += (dx / dist) * 0.2
					this.vy += (dy / dist) * 0.2
				}

				this.vx *= 0.96
				this.vy *= 0.96
			}

			draw(ctx: CanvasRenderingContext2D) {
				const pulse = Math.sin(this.dataFlow) * 0.5 + 0.5
				const glow = this.isActive ? 12 : 6

				// Glow
				ctx.fillStyle = `rgba(199, 0, 57, ${0.1 * pulse})`
				ctx.beginPath()
				ctx.arc(this.x, this.y, this.radius + glow, 0, Math.PI * 2)
				ctx.fill()

				// Core
				ctx.fillStyle = `rgba(199, 0, 57, ${0.5 + pulse * 0.5})`
				ctx.beginPath()
				ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2)
				ctx.fill()

				// Inner core
				ctx.fillStyle = 'rgba(255, 255, 255, 0.3)'
				ctx.beginPath()
				ctx.arc(this.x, this.y, this.radius * 0.5, 0, Math.PI * 2)
				ctx.fill()
			}
		}

		const width = canvasContainer.clientWidth
		const height = canvasContainer.clientHeight
		const nodes = [
			new DataNode(width * 0.2, height * 0.3, 'DATA'),
			new DataNode(width * 0.5, height * 0.2, 'WEB'),
			new DataNode(width * 0.8, height * 0.4, 'AI'),
			new DataNode(width * 0.3, height * 0.7, 'CODE'),
			new DataNode(width * 0.7, height * 0.75, 'DEV'),
			new DataNode(width * 0.5, height * 0.5, 'CORE')
		]

		let mouseX = width / 2
		let mouseY = height / 2

		canvasContainer.addEventListener('mousemove', (e) => {
			const rect = canvasContainer.getBoundingClientRect()
			mouseX = e.clientX - rect.left
			mouseY = e.clientY - rect.top
		})

		const animate = () => {
			ctx.fillStyle = '#0a0a0a'
			ctx.fillRect(0, 0, width, height)

			// Update and draw nodes
			nodes.forEach((node) => {
				node.update(width, height, mouseX, mouseY)
				node.draw(ctx)
			})

			// Draw connections
			for (let i = 0; i < nodes.length; i++) {
				for (let j = i + 1; j < nodes.length; j++) {
					const dx = nodes[i].x - nodes[j].x
					const dy = nodes[i].y - nodes[j].y
					const dist = Math.sqrt(dx * dx + dy * dy)
					const maxDist = 150

					if (dist < maxDist) {
						const opacity = (1 - dist / maxDist) * 0.4
						const lineWidth = (1 - dist / maxDist) * 2

						// Data flow animation
						const flowProgress = (nodes[i].dataFlow + nodes[j].dataFlow) * 0.5
						const flowPos = flowProgress % 1

						ctx.strokeStyle = `rgba(199, 0, 57, ${opacity})`
						ctx.lineWidth = lineWidth
						ctx.beginPath()
						ctx.moveTo(nodes[i].x, nodes[i].y)
						ctx.lineTo(nodes[j].x, nodes[j].y)
						ctx.stroke()

						// Animated data packets
						ctx.fillStyle = `rgba(199, 0, 57, ${0.6 + Math.sin(flowProgress * Math.PI * 4) * 0.4})`
						const packetX = nodes[i].x + (nodes[j].x - nodes[i].x) * flowPos
						const packetY = nodes[i].y + (nodes[j].y - nodes[i].y) * flowPos
						ctx.beginPath()
						ctx.arc(packetX, packetY, 2, 0, Math.PI * 2)
						ctx.fill()
					}
				}
			}

			animationId = requestAnimationFrame(animate)
		}

		animate()

		window.addEventListener('beforeunload', () => {
			cancelAnimationFrame(animationId)
		})
	}
</script>
