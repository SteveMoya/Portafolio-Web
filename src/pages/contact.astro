---
import { siteConfig } from '@src/data/config'
import Layout from '@src/layouts/Layout.astro'
import Header from '@components/Header.astro'
import Input from '@components/ui/Input.astro'
import Button from '@components/ui/Button.astro'
import { Icon } from 'astro-icon/components'
import socialLinks from '@src/data/socialLinks.json'

const { author } = siteConfig

const connectLinks = socialLinks.links.filter((link) => link.url.startsWith('http') || link.url.startsWith('mailto'))

const faqs = [
	{
		question: '¿Qué servicios ofrecés?',
		answer:
			'Desarrollo web (front y back), marketing digital, SEO y análisis de datos. Puedo encargarme de un proyecto completo o sumarme a un equipo que ya tiene algo en marcha.'
	},
	{
		question: '¿Con qué tecnologías trabajás?',
		answer:
			'Principalmente JavaScript/TypeScript, Astro, React y Node.js, además de WordPress para proyectos que lo requieren. También manejo SEO técnico, Google Analytics/Ads y Cloudflare.'
	},
	{
		question: '¿Cómo es tu proceso de trabajo?',
		answer:
			'Arrancamos con una charla para entender el objetivo y el alcance, sigo con una propuesta y estimación de tiempos, y avanzo en etapas cortas con entregas visibles para que puedas ir revisando el progreso.'
	},
	{
		question: '¿Cuánto tiempo toma un proyecto?',
		answer:
			'Depende del alcance: una landing puede estar lista en una o dos semanas, mientras que un producto más completo puede tomar varios meses. Te doy un estimado concreto apenas conozco los detalles.'
	},
	{
		question: '¿Trabajás con clientes de otros países?',
		answer:
			'Sí, trabajo de forma remota con clientes de cualquier zona horaria. Coordinamos las reuniones y entregas por videollamada, email o la herramienta que prefieras.'
	},
	{
		question: '¿Cómo me pongo en contacto?',
		answer: 'Lo más directo es el formulario de acá arriba, o escribirme por cualquiera de mis redes sociales. Te respondo a la brevedad.'
	}
]
---

<Layout title={`${author} | Contacto`} description="Hablemos de tu próximo proyecto. Escribime por redes o completá el formulario y te respondo a la brevedad.">
	<Header
		title="Hablemos"
		titleCaption="de tu proyecto"
		description="¿Tenés una idea en mente? Contame los detalles y"
		descriptionCaption="lo llevamos adelante juntos."
	/>

	{/* Main Contact Section - Split Layout */}
	<section class="relative w-full bg-[#0a0a0a] px-6 pb-24 sm:px-10 lg:px-16">
		<div class="mx-auto max-w-7xl">
			<div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">
				{/* Left Column - 3D Element */}
				<div class="flex items-center justify-center lg:sticky lg:top-24 lg:h-fit">
					<div id="canvas-container" class="h-full w-full"></div>
				</div>

				{/* Right Column - Form & Social */}
				<div class="flex flex-col gap-12">
					{/* Social Networks - Top */}
					<div class="social-section">
						<div class="mb-8">
							<p class="mb-2 text-xs font-bold uppercase tracking-[0.3em] text-white/40">Conecta conmigo</p>
							<h3 class="text-xl font-bold text-white">Encontrame en</h3>
						</div>

						<div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
							{
								connectLinks.map((link) => (
									<a
										href={link.url}
										target={link.url.startsWith('http') ? '_blank' : '_self'}
										rel={link.url.startsWith('http') ? 'noopener noreferrer' : ''}
										aria-label={`${link.title}${link.handle ? ` — ${link.handle}` : ''}`}
										class="group flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3 py-2.5 transition-all duration-300 hover:border-[#c70039]/40 hover:bg-white/10"
									>
										<Icon name={link.icon} class="h-4 w-4 text-[#c70039]" />
										<span class="truncate text-xs font-semibold text-white">{link.title}</span>
									</a>
								))
							}
						</div>
					</div>

					{/* Contact Form - Middle */}
					<div class="contact-section">
						<div class="mb-6">
							<h3 class="text-xl font-bold text-white">Escribime un mensaje</h3>
							<p class="mt-1 text-sm text-white/60">Te respondo a la brevedad</p>
						</div>

						<form id="contact-form" novalidate class="space-y-4">
							<div class="grid gap-4 sm:grid-cols-2">
								<div>
									<label for="nombre" class="mb-2 block text-xs font-bold uppercase tracking-[0.15em] text-white/50">Nombre</label>
									<Input id="nombre" name="nombre" type="text" required placeholder="Tu nombre" class="m-0 w-full" />
									<p data-error-for="nombre" class="mt-1.5 hidden text-xs font-semibold text-[#c70039]">Ingresá tu nombre.</p>
								</div>

								<div>
									<label for="email" class="mb-2 block text-xs font-bold uppercase tracking-[0.15em] text-white/50">Email</label>
									<Input id="email" name="email" type="email" required placeholder="tu@email.com" class="m-0 w-full" />
									<p data-error-for="email" class="mt-1.5 hidden text-xs font-semibold text-[#c70039]">Ingresá un email válido.</p>
								</div>
							</div>

							<div>
								<label for="asunto" class="mb-2 block text-xs font-bold uppercase tracking-[0.15em] text-white/50">Asunto</label>
								<Input id="asunto" name="asunto" type="text" required placeholder="¿De qué se trata?" class="m-0 w-full" />
								<p data-error-for="asunto" class="mt-1.5 hidden text-xs font-semibold text-[#c70039]">Contame el asunto.</p>
							</div>

							<div>
								<label for="descripcion" class="mb-2 block text-xs font-bold uppercase tracking-[0.15em] text-white/50">Descripción</label>
								<Input id="descripcion" name="descripcion" type="textarea" required placeholder="Contame más sobre tu proyecto" class="m-0 w-full" />
								<p data-error-for="descripcion" class="mt-1.5 hidden text-xs font-semibold text-[#c70039]">Contame un poco más.</p>
							</div>

							<div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:justify-between pt-2">
								<Button type="submit" variant="primary" text="Enviar mensaje" class="m-0" />
								<p id="form-status" class="hidden text-sm font-semibold" role="status"></p>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</section>

	{/* FAQ Section - Full Width */}
	<section class="relative w-full bg-gradient-to-b from-[#0a0a0a] to-[#050505] px-6 py-24 sm:px-10 lg:px-16">
		<div class="mx-auto max-w-4xl">
			<div class="mb-12 text-center">
				<p class="mb-2 text-xs font-bold uppercase tracking-[0.3em] text-white/40">Dudas frecuentes</p>
				<h2 class="text-3xl font-bold text-white sm:text-4xl">Preguntas que suelen surgir</h2>
			</div>

			<div class="space-y-3">
				{
					faqs.map((faq, index) => (
						<details
							class="group rounded-xl border border-white/10 bg-white/5 backdrop-blur-sm transition-all duration-300 open:border-[#c70039]/30 open:bg-white/8"
							style={`animation-delay: ${index * 0.05}s`}
						>
							<summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-5 py-4 text-base font-semibold text-white select-none hover:text-[#c70039] transition-colors duration-300">
								<span>{faq.question}</span>
								<svg
									class="mt-0.5 h-5 w-5 shrink-0 text-white/40 transition-all duration-300 group-open:rotate-180 group-open:text-[#c70039]"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
								</svg>
							</summary>
							<div class="border-t border-white/10 px-5 pb-4 pt-4">
								<p class="text-sm leading-relaxed text-white/70">{faq.answer}</p>
							</div>
						</details>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	@keyframes fade-in-up {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.social-section,
	.contact-section {
		animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	details[open] {
		animation: fade-in-up 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	#canvas-container {
		min-height: 400px;
	}

	@media (min-width: 1024px) {
		#canvas-container {
			min-height: 600px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.social-section,
		.contact-section,
		details[open] {
			animation: none;
		}
	}
</style>

<script>
	// Contact Form Functionality
	const CONTACT_EMAIL = 'contacto@stevemoya.com'
	const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

	const form = document.getElementById('contact-form') as HTMLFormElement | null
	const status = document.getElementById('form-status') as HTMLParagraphElement | null

	const setError = (field: string, show: boolean) => {
		const el = form?.querySelector<HTMLElement>(`[data-error-for="${field}"]`)
		el?.classList.toggle('hidden', !show)
	}

	const showStatus = (message: string, tone: 'success' | 'error') => {
		if (!status) return
		status.textContent = message
		status.classList.remove('hidden', 'text-[#c70039]', 'text-emerald-400')
		status.classList.add(tone === 'success' ? 'text-emerald-400' : 'text-[#c70039]')
	}

	form?.addEventListener('submit', (event) => {
		event.preventDefault()

		const data = new FormData(form)
		const nombre = String(data.get('nombre') || '').trim()
		const email = String(data.get('email') || '').trim()
		const asunto = String(data.get('asunto') || '').trim()
		const descripcion = String(data.get('descripcion') || '').trim()

		const nombreValid = nombre.length > 0
		const emailValid = EMAIL_RE.test(email)
		const asuntoValid = asunto.length > 0
		const descripcionValid = descripcion.length > 0

		setError('nombre', !nombreValid)
		setError('email', !emailValid)
		setError('asunto', !asuntoValid)
		setError('descripcion', !descripcionValid)

		if (!nombreValid || !emailValid || !asuntoValid || !descripcionValid) {
			showStatus('Revisá los campos marcados antes de continuar.', 'error')
			return
		}

		const body = `${nombre}\n${email}\n\n${descripcion}`
		const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(body)}`
		window.location.href = mailto

		showStatus('Se abrió tu cliente de correo con el mensaje listo para enviar.', 'success')
	})

	// 3D Canvas - Interactive Element
	const canvasContainer = document.getElementById('canvas-container')
	if (canvasContainer) {
		const canvas = document.createElement('canvas')
		canvasContainer.appendChild(canvas)

		const ctx = canvas.getContext('2d')
		if (!ctx) throw new Error('Could not get canvas context')

		let animationId: number

		const resizeCanvas = () => {
			canvas.width = canvasContainer.clientWidth * window.devicePixelRatio
			canvas.height = canvasContainer.clientHeight * window.devicePixelRatio
			ctx.scale(window.devicePixelRatio, window.devicePixelRatio)
		}

		resizeCanvas()
		window.addEventListener('resize', resizeCanvas)

		// Particle system for 3D-like effect
		class Particle {
			x: number
			y: number
			vx: number
			vy: number
			size: number
			opacity: number
			pulseSpeed: number
			pulseAmount: number

			constructor(width: number, height: number) {
				this.x = Math.random() * width
				this.y = Math.random() * height
				this.vx = (Math.random() - 0.5) * 1
				this.vy = (Math.random() - 0.5) * 1
				this.size = Math.random() * 2 + 1
				this.opacity = Math.random() * 0.5 + 0.3
				this.pulseSpeed = Math.random() * 0.02 + 0.01
				this.pulseAmount = 0
			}

			update(width: number, height: number) {
				this.x += this.vx
				this.y += this.vy
				this.pulseAmount += this.pulseSpeed

				if (this.x < 0) this.x = width
				if (this.x > width) this.x = 0
				if (this.y < 0) this.y = height
				if (this.y > height) this.y = 0
			}

			draw(ctx: CanvasRenderingContext2D) {
				const pulse = Math.sin(this.pulseAmount) * 0.5 + 0.5
				ctx.fillStyle = `rgba(199, 0, 57, ${this.opacity * (0.5 + pulse * 0.5)})`
				ctx.beginPath()
				ctx.arc(this.x, this.y, this.size * (0.7 + pulse * 0.3), 0, Math.PI * 2)
				ctx.fill()
			}
		}

		class NodeConnection {
			x1: number
			y1: number
			x2: number
			y2: number
			opacity: number

			constructor(x1: number, y1: number, x2: number, y2: number) {
				this.x1 = x1
				this.y1 = y1
				this.x2 = x2
				this.y2 = y2
				this.opacity = 0.2
			}

			draw(ctx: CanvasRenderingContext2D) {
				ctx.strokeStyle = `rgba(199, 0, 57, ${this.opacity})`
				ctx.lineWidth = 1
				ctx.beginPath()
				ctx.moveTo(this.x1, this.y1)
				ctx.lineTo(this.x2, this.y2)
				ctx.stroke()
			}
		}

		const width = canvasContainer.clientWidth
		const height = canvasContainer.clientHeight
		const particles: Particle[] = Array.from({ length: 40 }, () => new Particle(width, height))
		const connections: NodeConnection[] = []

		let mouseX = width / 2
		let mouseY = height / 2

		canvasContainer.addEventListener('mousemove', (e) => {
			const rect = canvasContainer.getBoundingClientRect()
			mouseX = e.clientX - rect.left
			mouseY = e.clientY - rect.top
		})

		const animate = () => {
			ctx.fillStyle = '#0a0a0a'
			ctx.fillRect(0, 0, width, height)

			// Update and draw particles
			particles.forEach((p) => {
				p.update(width, height)
				p.draw(ctx)
			})

			// Draw connections between nearby particles
			for (let i = 0; i < particles.length; i++) {
				for (let j = i + 1; j < particles.length; j++) {
					const dx = particles[i].x - particles[j].x
					const dy = particles[i].y - particles[j].y
					const dist = Math.sqrt(dx * dx + dy * dy)

					if (dist < 120) {
						ctx.strokeStyle = `rgba(199, 0, 57, ${(1 - dist / 120) * 0.3})`
						ctx.lineWidth = 1
						ctx.beginPath()
						ctx.moveTo(particles[i].x, particles[i].y)
						ctx.lineTo(particles[j].x, particles[j].y)
						ctx.stroke()
					}
				}
			}

			// Draw mouse interaction circle
			ctx.strokeStyle = 'rgba(199, 0, 57, 0.2)'
			ctx.lineWidth = 1.5
			ctx.beginPath()
			ctx.arc(mouseX, mouseY, 80, 0, Math.PI * 2)
			ctx.stroke()

			// Attract particles to mouse
			particles.forEach((p) => {
				const dx = mouseX - p.x
				const dy = mouseY - p.y
				const dist = Math.sqrt(dx * dx + dy * dy)

				if (dist < 120) {
					p.vx += (dx / dist) * 0.3
					p.vy += (dy / dist) * 0.3
				}

				// Damping
				p.vx *= 0.98
				p.vy *= 0.98
			})

			animationId = requestAnimationFrame(animate)
		}

		animate()

		// Cleanup on page unload
		window.addEventListener('beforeunload', () => {
			cancelAnimationFrame(animationId)
		})
	}
</script>
