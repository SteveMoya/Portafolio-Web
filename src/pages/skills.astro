---
import Layout from '@/layouts/Layout.astro';
import { skills, categories, getSkillsByCategory } from '@/data/skills';
import HardSkills from '@/components/sections/skills/HardSkills';
import ToolsSection from '@/components/sections/skills/ToolsSection';

const pageTitle = 'Skills';
const pageDescription = 'My technical skills and expertise';

// Prepare skills data for components
const hardSkillsData = skills.map((skill) => ({
	name: skill.name,
	level: skill.level,
	icon: skill.icon,
}));

const toolsData = skills.slice(0, 18).map((skill) => ({
	name: skill.name,
	icon: skill.icon,
	category: skill.category,
}));
---

<Layout title={pageTitle} description={pageDescription}>
	<main class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 py-20">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<!-- Header -->
			<div class="mb-16 text-center">
				<h1
					class="text-5xl md:text-6xl font-bold text-white mb-4 tracking-tight"
				>
					Technical Skills
				</h1>
				<p class="text-xl text-slate-300 max-w-2xl mx-auto">
					Technologies and tools I've mastered across different domains
				</p>
			</div>

			<!-- HardSkills Component -->
			<div class="mb-20">
				<h2 class="text-3xl font-bold text-white mb-12 text-center">
					Technical Proficiency
				</h2>
				<HardSkills client:load skills={hardSkillsData} />
			</div>

			<!-- Tools & Technologies -->
			<ToolsSection client:load tools={toolsData} />

			<!-- Skills by Category (condensed) -->
			<div class="space-y-16 mt-20">
				{
					categories.map((category) => {
						const categorySkills = getSkillsByCategory(category);
						return (
							<section>
								<div class="mb-8">
									<h3 class="text-2xl font-bold text-white mb-2">
										{category}
									</h3>
									<div class="w-12 h-1 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full"></div>
								</div>

								<div class="flex flex-wrap gap-2">
									{categorySkills.map((skill) => (
										<span class="bg-slate-700/50 text-slate-200 px-3 py-1 rounded-lg text-sm border border-slate-600 hover:border-blue-400 transition-colors">
											{skill.name}
										</span>
									))}
								</div>
							</section>
						);
					})
				}
			</div>

			<!-- Summary Stats -->
			<div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-4">
				{
					[
						{ label: 'Total Skills', value: skills.length },
						{
							label: 'Expert Level',
							value: skills.filter((s) => s.level === 'expert').length,
						},
						{
							label: 'Advanced',
							value: skills.filter((s) => s.level === 'advanced').length,
						},
						{
							label: 'Categories',
							value: categories.length,
						},
					].map((stat) => (
						<div class="bg-gradient-to-br from-blue-500/10 to-purple-500/10 border border-slate-700 rounded-lg p-6 text-center">
							<p class="text-3xl font-bold text-white mb-2">
								{stat.value}
							</p>
							<p class="text-slate-400 text-sm">
								{stat.label}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</main>
</Layout>
