---
import Layout from '@/layouts/Layout.astro';
import { skills, categories } from '@/data/skills';
import HardSkillsNew from '@/components/sections/skills/HardSkillsNew';
import ToolsSectionNew from '@/components/sections/skills/ToolsSectionNew';

const pageTitle = 'Skills';
const pageDescription = 'My technical skills and expertise';

// Categorize skills by type
const aiSkills = skills.filter(s => s.category === 'AI & Data');
const softwareSkills = skills.filter(s => ['Frontend', 'Backend'].includes(s.category));
const additionalSkills = skills.filter(s => ['DevOps & Tools', 'Marketing'].includes(s.category));

// Prepare tools data
const toolsData = skills.slice(0, 12).map((skill) => ({
	name: skill.name,
	icon: skill.icon,
	category: skill.category,
}));
---

<Layout title={pageTitle} description={pageDescription}>
	<main class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
		<!-- Hero Section -->
		<section class="relative min-h-screen flex items-center justify-center py-20 overflow-hidden">
			<!-- Background gradient overlay -->
			<div class="absolute inset-0 bg-gradient-to-b from-slate-900/50 via-slate-800 to-slate-900 z-0"></div>

			<!-- Hero content -->
			<div class="relative z-10 text-center px-4 sm:px-6 lg:px-8">
				<div class="space-y-6 mb-12">
					<div class="inline-block">
						<span class="text-xs font-bold uppercase tracking-[0.4em] text-blue-400 bg-blue-500/10 px-4 py-2 rounded-full border border-blue-500/20">
							Capabilities & Expertise
						</span>
					</div>
					<h1 class="text-6xl md:text-7xl font-bold text-white tracking-tight leading-tight">
						Skills &<br />Tools
					</h1>
					<p class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
						Building scalable architectures and innovative solutions across AI, software engineering, and modern development tools.
					</p>
				</div>

				<!-- Scroll indicator -->
				<div class="flex flex-col items-center justify-center gap-3 mt-16">
					<div class="inline-flex gap-2 text-slate-400 text-sm">
						<span>Scroll to explore</span>
					</div>
					<svg class="w-5 h-5 text-slate-400 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
					</svg>
				</div>
			</div>
		</section>

		<!-- Core Focus Section with 3-Column Layout -->
		<section class="relative py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-slate-800 to-slate-900">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-16">
					<span class="text-xs font-bold uppercase tracking-[0.4em] text-blue-400 bg-blue-500/10 px-4 py-2 rounded-full border border-blue-500/20 inline-block mb-6">
						Core Focus
					</span>
					<h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
						Hard Skills & Expertise
					</h2>
					<p class="text-slate-400 max-w-2xl mx-auto">
						Technical depth across AI, software engineering, and development tools
					</p>
				</div>

				<HardSkillsNew client:load
					aiSkills={aiSkills}
					softwareSkills={softwareSkills}
					additionalSkills={additionalSkills}
				/>
			</div>
		</section>

		<!-- Professional Tooling Section -->
		<section class="relative py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-slate-900 to-slate-800">
			<div class="max-w-7xl mx-auto">
				<ToolsSectionNew client:load tools={toolsData} />
			</div>
		</section>

		<!-- Summary Stats -->
		<section class="relative py-20 px-4 sm:px-6 lg:px-8 bg-slate-900">
			<div class="max-w-6xl mx-auto">
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
					{
						[
							{ label: 'Total Skills', value: skills.length },
							{
								label: 'Expert Level',
								value: skills.filter((s) => s.level === 'expert').length,
							},
							{
								label: 'Advanced',
								value: skills.filter((s) => s.level === 'advanced').length,
							},
							{
								label: 'Categories',
								value: categories.length,
							},
						].map((stat) => (
							<div class="bg-gradient-to-br from-blue-500/10 to-purple-500/10 border border-slate-700 rounded-lg p-6 text-center hover:border-blue-500/50 transition-colors">
								<p class="text-3xl font-bold text-white mb-2">
									{stat.value}
								</p>
								<p class="text-slate-400 text-sm">
									{stat.label}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</main>
</Layout>
