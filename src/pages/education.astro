---
import Layout from '@/layouts/Layout.astro';
import { education } from '@/data/education';
import EducationStickyScroll from '@/components/sections/EducationStickyScroll';

const pageTitle = 'Education';
const pageDescription = 'My academic background and certifications';
---

<Layout title={pageTitle} description={pageDescription}>
	<main class="min-h-screen bg-background text-foreground relative overflow-hidden">
		<!-- Hero Section -->
		<section class="relative py-24 md:py-32 px-4 sm:px-6 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-16">
					<h1
						class="text-5xl md:text-7xl font-black text-foreground mb-6 tracking-tight"
					>
						Education
					</h1>
					<p class="text-xl md:text-2xl text-foreground/60 max-w-2xl mx-auto leading-relaxed">
						Building strong foundations through academic excellence and continuous learning
					</p>
				</div>
			</div>

			<!-- Animated Background Elements -->
			<div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
				<div
					class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-foreground/[0.02] blur-3xl animate-pulse"
					style="animation-duration: 5s"
				></div>
				<div
					class="absolute bottom-1/4 right-1/4 w-80 h-80 rounded-full bg-foreground/[0.015] blur-3xl animate-pulse"
					style="animation-duration: 6s; animation-delay: 1s"
				></div>
			</div>
		</section>

		<!-- Education Cards Section -->
		<section class="relative z-10 py-12">
			<div class="max-w-6xl mx-auto px-4">
				<EducationStickyScroll client:load education={education} />
			</div>
		</section>

		<!-- Additional Information Section -->
		<section class="relative z-10 py-24 border-t border-foreground/10">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{
						education.map((edu) => (
							<div class="group relative p-6 rounded-2xl border border-foreground/10 bg-foreground/[0.02] hover:bg-foreground/[0.05] hover:border-foreground/20 transition-all duration-300">
								<div class="absolute inset-0 opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity duration-500 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-500/10 via-transparent to-transparent rounded-2xl" />

								<div class="relative z-10">
									<h3 class="text-lg font-bold text-foreground mb-2 leading-tight">
										{edu.institution}
									</h3>
									<p class="text-sm font-semibold text-blue-600 dark:text-blue-400 mb-2">
										{edu.degree}
									</p>
									<p class="text-xs text-foreground/60 mb-4">{edu.major}</p>

									<div class="flex flex-wrap gap-2 mb-4">
										{edu.isOngoing && (
											<span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/30">
												Current
											</span>
										)}
										{edu.gpa && (
											<span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-foreground/10 text-foreground/70 border border-foreground/20">
												GPA {edu.gpa}
											</span>
										)}
									</div>

									{(edu.activities || []).slice(0, 2).map((activity) => (
										<p class="text-xs text-foreground/50 mb-1">• {activity}</p>
									))}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</main>
</Layout>
