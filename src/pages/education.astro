---
import Layout from '@/layouts/Layout.astro';
import { education } from '@/data/education';
import ExperienceStickyScroll from '@/components/sections/ExperienceStickyScroll';
import { GraduationCap, BookOpen } from 'lucide-react';

const pageTitle = 'Education';
const pageDescription = 'My academic background and certifications';

// Prepare education data for component
const educationCards = education.map((edu, idx) => ({
	institution: edu.institution,
	degree: edu.degree,
	major: edu.major,
	status: edu.isOngoing ? 'Current' : 'Completed',
	highlights: edu.achievements || edu.activities || [],
	icon: idx === 0 ? <GraduationCap className="w-20 h-20" /> : <BookOpen className="w-20 h-20" />,
	iconColor: 'text-white',
	hoverColor: 'hover:border-blue-500/50',
	glowColor: 'rgba(59,130,246,0.3)',
}));
---

<Layout title={pageTitle} description={pageDescription}>
	<main class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 py-20">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<!-- Header -->
			<div class="mb-16">
				<h1
					class="text-5xl md:text-6xl font-bold text-white mb-4 tracking-tight"
				>
					Education
				</h1>
				<p class="text-xl text-slate-300 max-w-2xl">
					Academic background, certifications, and continuous learning
				</p>
			</div>

			<!-- StickyScroll Component -->
			<ExperienceStickyScroll client:load education={educationCards} />

			<!-- Timeline (Legacy) -->
			<div class="relative hidden">
				{/* Vertical line */}
				<div
					class="absolute left-0 md:left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-purple-500 to-slate-700 md:-translate-x-1/2"
				></div>

				<!-- Education Items -->
				<div class="space-y-12">
					{
						education.map((edu, index) => (
							<div class="relative">
								{/* Timeline dot */}
								<div class="absolute left-0 md:left-1/2 -top-1 w-4 h-4 bg-purple-500 rounded-full border-4 border-slate-900 md:-translate-x-1/2"></div>

								{/* Content */}
								<div
									class={`ml-8 md:ml-0 ${
										index % 2 === 0 ? 'md:mr-1/2 md:pr-8' : 'md:ml-1/2 md:pl-8'
									}`}
								>
									<div class="bg-slate-800/50 backdrop-blur border border-slate-700 rounded-xl p-6 hover:border-purple-500/50 transition-colors duration-300">
										{/* Header */}
										<div class="mb-4">
											<h3 class="text-2xl font-bold text-white mb-1">
												{edu.degree}
											</h3>
											<p class="text-purple-400 font-semibold text-lg">
												{edu.institution}
											</p>
											<p class="text-slate-400 text-sm mt-1">
												{edu.major}
											</p>
										</div>

										{/* Dates */}
										<div class="flex flex-wrap gap-4 text-sm text-slate-400 mb-4 pb-4 border-b border-slate-700">
											<span class="flex items-center gap-2">
												📅
												{new Date(edu.startDate).toLocaleDateString('es-DO', {
													month: 'short',
													year: 'numeric',
												})}
												{edu.endDate
													? ` - ${new Date(edu.endDate).toLocaleDateString('es-DO', {
														month: 'short',
														year: 'numeric',
													})}`
													: edu.isOngoing
														? ' - Present'
														: ''}
											</span>
											{edu.gpa && (
												<span class="flex items-center gap-2">
													📊 GPA: {edu.gpa}
												</span>
											)}
										</div>

										{/* Activities */}
										{edu.activities && edu.activities.length > 0 && (
											<div class="mb-6">
												<h4 class="text-sm font-semibold text-slate-200 mb-3 uppercase tracking-wide">
													Activities
												</h4>
												<div class="flex flex-wrap gap-2">
													{edu.activities.map((activity) => (
														<span class="bg-purple-500/20 text-purple-200 px-3 py-1 rounded-lg text-sm border border-purple-500/30">
															{activity}
														</span>
													))}
												</div>
											</div>
										)}

										{/* Achievements */}
										{edu.achievements && edu.achievements.length > 0 && (
											<div>
												<h4 class="text-sm font-semibold text-slate-200 mb-3 uppercase tracking-wide">
													Achievements
												</h4>
												<ul class="space-y-2">
													{edu.achievements.map((achievement) => (
														<li class="flex items-start gap-3 text-sm text-slate-400">
															<span class="text-purple-400 mt-1">✓</span>
															<span>{achievement}</span>
														</li>
													))}
												</ul>
											</div>
										)}
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</main>
</Layout>
