---
import PrintLayout from "@/layouts/PrintLayout.astro";

import AboutSection from "@/components/sections/About.astro";
import Education from "@/components/sections/Education.astro";
import Experience from "@/components/sections/Experience.astro";
import Hero from "@/components/sections/Hero.astro";
import Projects from "@/components/sections/Projects.astro";
import Skills from "@/components/sections/Skills.astro";
import KeyboardManager from "@/components/KeyboardManager.astro";

import { basics, projects } from "@cv";
const { name, label } = basics;
---

<PrintLayout title={`${name} Portafolio - ${label}`}>
	<main class="relative grid max-w-7xl items-start gap-6 p-8 max-sm:py-16 md:grid-cols-6 md:p-16 xl:gap-8 print:max-w-none print:grid-cols-6 print:gap-x-8 print:gap-y-2">
		<div class="dotted-card relative space-y-6 self-start rounded-2xl border border-white/10 p-6 md:col-span-2 print:col-span-2 print:space-y-2 print:rounded-none print:border-none print:bg-transparent print:p-0">
			<Hero />
			<AboutSection />
			<span class="corner-tick corner-tick--tl print:hidden"></span>
			<span class="corner-tick corner-tick--br print:hidden"></span>
		</div>
		<div class="dotted-card relative space-y-12 self-start rounded-2xl border border-white/10 p-6 md:col-span-4 print:col-span-4 print:space-y-2 print:rounded-none print:border-none print:bg-transparent print:p-0">
			<div id="experiencia" class="scroll-mt-24">
				<Experience />
			</div>
			{
				projects.length > 0 && <Projects className="print:hidden" />
			}
			<div id="habilidades" class="scroll-mt-24">
				<Skills className="print:hidden" />
			</div>
			<div id="educacion" class="order-first scroll-mt-24">
				<Education />
			</div>
			<span class="corner-tick corner-tick--tl print:hidden"></span>
			<span class="corner-tick corner-tick--br print:hidden"></span>
		</div>
	</main>

	<KeyboardManager />
	<script>
		// /about?print=1 (CV link in navbar) opens the print dialog with the up-to-date CV.
		// astro:page-load fires on first load and after ClientRouter navigations.
		document.addEventListener('astro:page-load', () => {
			const url = new URL(location.href)
			if (!url.searchParams.has('print')) return
			url.searchParams.delete('print')
			history.replaceState(history.state, '', url)
			setTimeout(() => window.print(), 300)
		})
	</script>
</PrintLayout>

<style>
	@page {
		size: A4;
		margin: 10mm 12mm;
	}
	main {
		margin: auto;
		width: 100%;
	}
	@media print {
		main {
			gap: 0.5rem;
		}
	}
</style>
