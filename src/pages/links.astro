---
import { Icon } from 'astro-icon/components'
import { getPosts } from '@src/utils/post'
import { formatDate } from '@src/utils'
import { siteConfig } from '@src/data/config'
import Layout from '@src/layouts/Layout.astro'
import socialLinks from '@src/data/socialLinks.json'

const latestPosts = await getPosts(3)
const mostRecentPost = latestPosts.length > 0 ? latestPosts[0] : null

const { author, profileImage } = siteConfig
const externalLinks = socialLinks.links.filter((link) => link.url.startsWith('http') || link.url.startsWith('mailto'))
---

<Layout title={`${author} | Enlaces`} description="Enlaces a mis redes sociales y últimos artículos">
	<div class="relative flex min-h-screen w-full flex-col items-center justify-start overflow-hidden bg-[#0a0a0a] px-4 py-16">
		<div class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(circle,_#444_0.5px,_transparent_0.5px)] opacity-20 [background-size:24px_24px]"></div>

		<button
			id="share-button"
			class="links-in absolute right-4 top-4 z-20 flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white/60 backdrop-blur-sm transition-all duration-300 hover:border-[#c70039]/50 hover:bg-[#c70039]/10 hover:text-[#c70039]"
			aria-label="Compartir"
			title="Compartir esta página"
			style="animation-delay: 0s"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]">
				<path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
				<polyline points="16 6 12 2 8 6"></polyline>
				<line x1="12" y1="2" x2="12" y2="15"></line>
			</svg>
		</button>

		<div class="links-in relative z-10 mb-8 flex flex-col items-center" style="animation-delay: 0.05s">
			<img src={profileImage} alt={author} class="h-24 w-24 rounded-full border-2 border-[#c70039] object-cover" />
			<h1 class="mt-4 font-poppins text-2xl font-black uppercase tracking-tight text-white">{author}</h1>
			<p class="mt-1 text-[10px] font-bold uppercase tracking-[0.25em] text-white/50">Marketing Digital, Desarrollo &amp; IA</p>

			<div class="mt-5 flex flex-wrap justify-center gap-3">
				{
					externalLinks.map((link) => (
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							class="flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#c70039]/50 hover:bg-[#c70039]/10 hover:text-[#c70039]"
							aria-label={link.title}
							title={link.title}
						>
							<Icon name={link.icon} class="h-5 w-5" />
						</a>
					))
				}
			</div>
		</div>

		{
			mostRecentPost && (
				<div class="links-in relative z-10 w-full max-w-md" style="animation-delay: 0.1s">
					<div class="mb-4 flex items-center gap-3">
						<span class="h-px flex-1 bg-white/10" />
						<span class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40">Artículo más reciente</span>
						<span class="h-px flex-1 bg-white/10" />
					</div>

					<a
						href={`/blog/${mostRecentPost.id}`}
						class="dotted-card group mb-8 flex overflow-hidden rounded-2xl border border-white/5 transition-all duration-300 hover:-translate-y-1 hover:border-[#c70039]/40 hover:shadow-[0_12px_40px_rgba(199,0,57,0.18)]"
					>
						{mostRecentPost.data.heroImage?.src && (
							<div class="relative h-40 w-full shrink-0 overflow-hidden">
								<img
									src={mostRecentPost.data.heroImage.src}
									alt={mostRecentPost.data.title}
									class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent" />
							</div>
						)}
						<div class="p-5">
							<h3 class="text-lg font-bold text-white transition-colors group-hover:text-[#c70039]">{mostRecentPost.data.title}</h3>
							<p class="mt-2 line-clamp-2 text-sm text-white/50">{mostRecentPost.data.description}</p>
							<div class="mt-4 flex items-center justify-between">
								<span class="text-xs font-semibold uppercase tracking-[0.15em] text-[#c70039]">{formatDate(mostRecentPost.data.pubDate)}</span>
								<span class="flex items-center gap-1 text-xs font-semibold text-white/50">
									<Icon name="mdi:eye-outline" class="h-4 w-4" />
									Leer artículo
								</span>
							</div>
						</div>
					</a>
				</div>
			)
		}

		<div class="links-in relative z-10 w-full max-w-md space-y-3" style="animation-delay: 0.15s">
			{
				socialLinks.links.map((link) => (
					<a
						href={link.url}
						target={link.url.startsWith('http') ? '_blank' : '_self'}
						rel={link.url.startsWith('http') ? 'noopener noreferrer' : ''}
						class="dotted-card group flex w-full items-center justify-between rounded-xl border border-white/5 px-5 py-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-[#c70039]/40 hover:shadow-[0_12px_40px_rgba(199,0,57,0.18)]"
					>
						<span class="flex items-center gap-3 text-sm font-semibold text-white">
							<Icon name={link.icon} class="h-5 w-5 text-[#c70039]" />
							{link.title}
						</span>
						<Icon name="mdi:arrow-right" class="h-4 w-4 text-white/40 transition-all duration-300 group-hover:translate-x-1 group-hover:text-[#c70039]" />
					</a>
				))
			}
		</div>

		{
			latestPosts.length > 0 && (
				<div class="relative z-10 mt-10 w-full max-w-md">
					<div class="mb-4 flex items-center gap-3">
						<span class="h-px flex-1 bg-white/10" />
						<span class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40">Últimos artículos</span>
						<span class="h-px flex-1 bg-white/10" />
					</div>

					<div class="grid w-full gap-3 sm:grid-cols-2">
						{latestPosts.map((post, index) => {
							const isFirstItem = index === 0
							const hasMultiplePosts = latestPosts.length > 1

							return (
								<a
									href={`/blog/${post.id}`}
									class:list={[
										'dotted-card group flex flex-col overflow-hidden rounded-xl border border-white/5 transition-all duration-300 hover:-translate-y-1 hover:border-[#c70039]/40 hover:shadow-[0_12px_40px_rgba(199,0,57,0.18)]',
										isFirstItem && hasMultiplePosts ? 'sm:col-span-2 sm:aspect-[21/9]' : 'aspect-square sm:aspect-auto'
									]}
								>
									{post.data.heroImage?.src ? (
										<div class="relative flex-1 overflow-hidden">
											<img
												src={post.data.heroImage.src}
												alt={post.data.title}
												class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
											/>
											<div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/60 to-transparent" />
											<div class="absolute bottom-0 left-0 w-full p-4">
												<p class="mb-1 text-[10px] font-bold uppercase tracking-[0.15em] text-[#c70039]">{formatDate(post.data.pubDate)}</p>
												<h3 class={`font-bold text-white transition-colors group-hover:text-[#c70039] line-clamp-2 ${isFirstItem && hasMultiplePosts ? 'text-lg sm:text-xl' : 'text-base'}`}>
													{post.data.title}
												</h3>
											</div>
										</div>
									) : (
										<div class="flex h-full flex-col justify-between p-4">
											<div>
												<h3 class={`font-bold text-white transition-colors group-hover:text-[#c70039] ${isFirstItem && hasMultiplePosts ? 'text-lg sm:text-xl' : 'text-base'}`}>
													{post.data.title}
												</h3>
												<p class="mt-2 line-clamp-2 text-xs text-white/50">{post.data.description}</p>
											</div>
											<p class="mt-4 text-[10px] font-bold uppercase tracking-[0.15em] text-[#c70039]">{formatDate(post.data.pubDate)}</p>
										</div>
									)}
								</a>
							)
						})}
					</div>
				</div>
			)
		}
	</div>
</Layout>

<style>
	@keyframes links-in {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.links-in {
		animation: links-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	@media (prefers-reduced-motion: reduce) {
		.links-in {
			animation: none;
		}
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const shareButton = document.getElementById('share-button')

		if (shareButton) {
			shareButton.addEventListener('click', async () => {
				try {
					if (navigator.share && navigator.canShare) {
						const shareData = {
							title: document.title,
							text: 'Echa un vistazo a este perfil',
							url: window.location.href
						}

						if (navigator.canShare(shareData)) {
							await navigator.share(shareData)
							return
						}
					}

					if (navigator.clipboard && window.isSecureContext) {
						await navigator.clipboard.writeText(window.location.href)
					} else {
						const textArea = document.createElement('textarea')
						textArea.value = window.location.href
						textArea.style.position = 'fixed'
						textArea.style.left = '-9999px'
						document.body.appendChild(textArea)
						textArea.select()
						// eslint-disable-next-line @typescript-eslint/no-explicit-any
						;(textArea as any).setSelectionRange(0, 99999)
						navigator.clipboard.writeText(textArea.value).catch(() => {})
						document.body.removeChild(textArea)
					}

					const originalContent = shareButton.innerHTML
					shareButton.innerHTML = '<span class="text-[10px] font-bold uppercase tracking-wide text-[#c70039]">Copiado</span>'
					setTimeout(() => {
						shareButton.innerHTML = originalContent
					}, 2000)
				} catch (error) {
					if (error && (error as Error).name !== 'AbortError') {
						console.error('Error al compartir:', error)
						const originalContent = shareButton.innerHTML
						shareButton.innerHTML = '<span class="text-[10px] font-bold uppercase tracking-wide text-red-400">Error</span>'
						setTimeout(() => {
							shareButton.innerHTML = originalContent
						}, 2000)
					}
				}
			})
		}
	})
</script>
